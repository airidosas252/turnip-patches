+template <chip CHIP>
+static void
+tu_emit_cond_render_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
+                          uint64_t iova, bool inv, bool in_pass)
+{
+   /* qcom doesn't support 32-bit reference values, only 64-bit, but Vulkan
+    * mandates 32-bit comparisons. Our workaround is to copy the the reference
+    * value to the low 32-bits of a location where the high 32 bits are known
+    * to be 0 and then compare that.
+    *
+    * BR and BV use separate predicate values so that setting the predicate
+    * doesn't have to be synchronized between them.
+    */
+   if (CHIP >= A7XX) {
+      if (!in_pass) {
+         tu_cs_emit_pkt7(cs, CP_THREAD_CONTROL, 1);
+         tu_cs_emit(cs, CP_THREAD_CONTROL_0_THREAD(CP_SET_THREAD_BOTH));
+      }
+      tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(THREAD_MODE) |
+                             CP_COND_REG_EXEC_0_BR);
+   }
+
+   tu_cs_emit_pkt7(cs, CP_MEM_TO_MEM, 5);
+   tu_cs_emit(cs, 0);
+   tu_cs_emit_qw(cs, global_iova(cmd, predicate));
+   tu_cs_emit_qw(cs, iova);
+
+   if (CHIP >= A7XX) {
+      tu_cond_exec_end(cs);
+      tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(THREAD_MODE) |
+                             CP_COND_REG_EXEC_0_BV);
+      tu_cs_emit_pkt7(cs, CP_MEM_TO_MEM, 5);
+      tu_cs_emit(cs, 0);
+      tu_cs_emit_qw(cs, global_iova(cmd, bv_predicate));
+      tu_cs_emit_qw(cs, iova);
+      tu_cond_exec_end(cs);
+   }
+
+   tu_cs_emit_pkt7(cs, CP_WAIT_MEM_WRITES, 0);
+   tu_cs_emit_pkt7(cs, CP_WAIT_FOR_ME, 0);
+
+   tu_cs_emit_pkt7(cs, CP_DRAW_PRED_ENABLE_GLOBAL, 1);
+   tu_cs_emit(cs, 1);
+
+   if (CHIP >= A7XX) {
+      tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(THREAD_MODE) |
+                             CP_COND_REG_EXEC_0_BR);
+   }
+   tu_cs_emit_pkt7(cs, CP_DRAW_PRED_SET, 3);
+   tu_cs_emit(cs, CP_DRAW_PRED_SET_0_SRC(PRED_SRC_MEM) |
+                  CP_DRAW_PRED_SET_0_TEST(inv ? EQ_0_PASS : NE_0_PASS));
+   tu_cs_emit_qw(cs, global_iova(cmd, predicate));
+
+   if (CHIP >= A7XX) {
+      tu_cond_exec_end(cs);
+      tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(THREAD_MODE) |
+                             CP_COND_REG_EXEC_0_BV);
+      tu_cs_emit_pkt7(cs, CP_DRAW_PRED_SET, 3);
+      tu_cs_emit(cs, CP_DRAW_PRED_SET_0_SRC(PRED_SRC_MEM) |
+                     CP_DRAW_PRED_SET_0_TEST(inv ? EQ_0_PASS : NE_0_PASS));
+      tu_cs_emit_qw(cs, global_iova(cmd, bv_predicate));
+      tu_cond_exec_end(cs);
+   }
+
+   /* Restore original BR thread after setting BOTH */
+   if (CHIP >= A7XX && !in_pass) {
+      tu7_set_thread_br_patchpoint(cmd, cs, false);
+   }
+}
+
+template <chip CHIP>
+static void
+tu_emit_cond_render_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
+                        bool in_pass)
+{
+   if (CHIP >= A7XX && !in_pass) {
+      tu_cs_emit_pkt7(cs, CP_THREAD_CONTROL, 1);
+      tu_cs_emit(cs, CP_THREAD_CONTROL_0_THREAD(CP_SET_THREAD_BOTH));
+   }
+
+   tu_cs_emit_pkt7(cs, CP_DRAW_PRED_ENABLE_GLOBAL, 1);
+   tu_cs_emit(cs, 0);
+
+   if (CHIP >= A7XX && !in_pass) {
+      tu7_set_thread_br_patchpoint(cmd, cs, false);
+   }
+}
+
+#define TU_MESH_SCRATCH_BUDGET (64ull << 20)
+
+static void
+tu_mesh_ubo_set_va(uint32_t *map, unsigned dword, uint64_t va)
+{
+   map[dword] = va;
+   map[dword + 1] = va >> 32;
+}
+
+#define TU_MESH_NATIVE_IDX_OFFSET 0
+#define TU_MESH_NATIVE_IDX_SIZE 0x600000
+#define TU_MESH_NATIVE_CULL_OFFSET (TU_MESH_NATIVE_IDX_OFFSET + TU_MESH_NATIVE_IDX_SIZE)
+#define TU_MESH_NATIVE_CULL_SIZE 0x60000
+#define TU_MESH_NATIVE_COUNT_OFFSET (TU_MESH_NATIVE_CULL_OFFSET + TU_MESH_NATIVE_CULL_SIZE)
+#define TU_MESH_NATIVE_COUNT_SIZE 0x4000
+#define TU_MESH_NATIVE_PAYLOAD_OFFSET (TU_MESH_NATIVE_COUNT_OFFSET + TU_MESH_NATIVE_COUNT_SIZE)
+#define TU_MESH_NATIVE_PAYLOAD_SIZE 0x800000
+#define TU_MESH_NATIVE_RECORD_OFFSET (TU_MESH_NATIVE_PAYLOAD_OFFSET + TU_MESH_NATIVE_PAYLOAD_SIZE)
+#define TU_MESH_NATIVE_RECORD_SIZE 0xC000
+#define TU_MESH_NATIVE_VERTEX_OFFSET (TU_MESH_NATIVE_RECORD_OFFSET + TU_MESH_NATIVE_RECORD_SIZE)
+#define TU_MESH_NATIVE_VERTEX_SIZE 0x1000000
+#define TU_MESH_NATIVE_VERTEX_BUDGET 1597440
+#define TU_MESH_NATIVE_BO_SIZE (TU_MESH_NATIVE_VERTEX_OFFSET + TU_MESH_NATIVE_VERTEX_SIZE)
+
+VkResult
+tu_mesh_native_init_bo(struct tu_device *dev)
+{
+   VkResult result = VK_SUCCESS;
+
+   mtx_lock(&dev->mutex);
+   if (!dev->mesh_native_bo) {
+      result = tu_bo_init_new_explicit_iova(
+         dev, NULL, &dev->mesh_native_bo, TU_MESH_NATIVE_BO_SIZE, 0, 0,
+         VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
+            VK_MEMORY_PROPERTY_HOST_CACHED_BIT,
+         TU_BO_ALLOC_INTERNAL_RESOURCE, NULL, "mesh_native");
+   }
+   mtx_unlock(&dev->mutex);
+
+   return result;
+}
+
+static void
+tu_emit_mesh_native_prim_regs(struct tu_cs *cs, uint32_t dwords, uint32_t loc)
+{
+   with_crb (cs, 3) {
+      crb.add({ 0x927b, dwords * 4, false });
+      crb.add({ 0x9311, dwords ? dwords | (loc << 8) | (1u << 16) : 0, false });
+      crb.add({ 0x9b07, dwords ? 1u : 0u, false });
+   }
+}
+
+static void
+tu_emit_mesh_native_packet(struct tu_cs *cs, uint64_t base, uint64_t desc,
+                           const uint32_t *groups_xyz, uint64_t indirect_va,
+                           uint32_t slots_per_batch, uint32_t vertex_bytes,
+                           uint32_t prim_bytes, uint32_t view_word)
+{
+   const uint64_t vertex_iova = base + TU_MESH_NATIVE_VERTEX_OFFSET;
+
+   tu_cs_emit_pkt7(cs, 0x7a, indirect_va ? 30 : 31);
+   tu_cs_emit(cs, indirect_va ? 7 : 5);
+   if (indirect_va) {
+      tu_cs_emit_qw(cs, indirect_va);
+   } else {
+      tu_cs_emit(cs, groups_xyz[0]);
+      tu_cs_emit(cs, groups_xyz[1]);
+      tu_cs_emit(cs, groups_xyz[2]);
+   }
+   tu_cs_emit_qw(cs, desc);
+   tu_cs_emit(cs, view_word);
+   tu_cs_emit(cs, 0);
+   tu_cs_emit(cs, 256);
+   tu_cs_emit(cs, slots_per_batch);
+   tu_cs_emit_qw(cs, base + TU_MESH_NATIVE_COUNT_OFFSET);
+   tu_cs_emit(cs, TU_MESH_NATIVE_COUNT_SIZE);
+   tu_cs_emit_qw(cs, base + TU_MESH_NATIVE_IDX_OFFSET);
+   tu_cs_emit(cs, TU_MESH_NATIVE_IDX_SIZE);
+   tu_cs_emit_qw(cs, vertex_iova);
+   tu_cs_emit(cs, vertex_bytes);
+   tu_cs_emit_qw(cs, vertex_iova + vertex_bytes);
+   tu_cs_emit(cs, prim_bytes);
+   tu_cs_emit_qw(cs, base + TU_MESH_NATIVE_CULL_OFFSET);
+   tu_cs_emit(cs, TU_MESH_NATIVE_CULL_SIZE);
+   tu_cs_emit_qw(cs, base + TU_MESH_NATIVE_PAYLOAD_OFFSET);
+   tu_cs_emit(cs, TU_MESH_NATIVE_PAYLOAD_SIZE);
+   tu_cs_emit_qw(cs, base + TU_MESH_NATIVE_RECORD_OFFSET);
+   tu_cs_emit(cs, TU_MESH_NATIVE_RECORD_SIZE);
+}
+
+template <chip CHIP>
+static void
+tu_draw_mesh_native(struct tu_cmd_buffer *cmd, const uint32_t *groups_xyz,
+                    uint64_t indirect_va, uint32_t stride, uint64_t count_va,
+                    uint32_t draw_count)
+{
+   struct tu_shader *mesh = cmd->state.mesh_shader;
+   struct tu_shader *task = cmd->state.task_shader;
+   const struct tu_mesh_layout *layout = cmd->state.mesh_layout;
+   struct tu_cs *cs = &cmd->draw_cs;
+   const bool indirect = !groups_xyz;
+
+   if (!indirect && (!groups_xyz[0] || !groups_xyz[1] || !groups_xyz[2]))
+      return;
+
+   const uint64_t base = cmd->device->mesh_native_bo->iova;
+
+   const uint32_t views = layout->num_views;
+   const uint32_t vertex_slot =
+      views * ALIGN_POT(layout->max_vertices * layout->vertex_stride, 16);
+   const uint32_t prim_slot =
+      views * ALIGN_POT(layout->max_primitives * layout->prim_dwords * 4, 16);
+   const uint32_t idx_slot = views * layout->max_primitives * 8;
+   const uint32_t slots_per_batch =
+      MAX2(1u, MIN4(1024u, TU_MESH_NATIVE_VERTEX_BUDGET / (vertex_slot + prim_slot),
+                    TU_MESH_NATIVE_IDX_SIZE / 2 / idx_slot,
+                    TU_MESH_NATIVE_PAYLOAD_SIZE / 2 /
+                       MAX2(1u, layout->task_payload_size)));
+   const uint32_t view_word =
+      views > 1 ? (layout->view_mask << 6) | (views << 1) | 1 : 0x40;
+   const uint32_t vertex_bytes = 2 * slots_per_batch * vertex_slot;
+   const uint32_t prim_bytes = 2 * slots_per_batch * prim_slot;
+   const uint32_t siv_bits = 1 | (layout->has_viewport ? 2 : 0) |
+                             (layout->has_layer ? 4 : 0);
+
+   struct tu_cs_memory guard = {};
+   if (count_va) {
+      tu_cs_set_writeable(&cmd->sub_cs, true);
+      VkResult result = tu_cs_alloc(&cmd->sub_cs, 1, 4, &guard);
+      tu_cs_set_writeable(&cmd->sub_cs, false);
+      if (result != VK_SUCCESS) {
+         vk_command_buffer_set_error(&cmd->vk, result);
+         return;
+      }
+      guard.map[0] = 1;
+   }
+
+   for (uint32_t i = 0; i < draw_count; i++) {
+      cmd->state.mesh_ubo = 0;
+      tu6_emit_vs_params(cmd, NULL, i, 0, 0);
+      tu6_draw_common<CHIP>(cmd, cs, false, 0);
+      struct tu_dispatch_info info = {};
+      info.blocks[0] = info.blocks[1] = info.blocks[2] = 1;
+      if (task) {
+         tu_cs_emit_state_ib(cs, task->state);
+         tu_cs_emit_state_ib(cs, tu_emit_consts<CHIP>(
+                                    cmd, task,
+                                    tu_get_descriptors_state(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS)));
+         tu_emit_compute_driver_params<CHIP>(cmd, cs, task, &info);
+      }
+      tu_cs_emit_state_ib(cs, mesh->state);
+      tu_cs_emit_state_ib(cs, tu_emit_consts<CHIP>(
+                                 cmd, mesh,
+                                 tu_get_descriptors_state(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS)));
+      tu_emit_compute_driver_params<CHIP>(cmd, cs, mesh, &info);
+      tu6_emit_descriptor_sets<CHIP>(cmd, VK_PIPELINE_BIND_POINT_COMPUTE,
+                                     VK_PIPELINE_BIND_POINT_GRAPHICS, cs);
+
+      if (mesh->const_state.mesh_ubo.idx >= 0 ||
+          (task && task->const_state.mesh_ubo.idx >= 0)) {
+         struct tu_cs_memory ubo;
+         tu_cs_set_writeable(&cmd->sub_cs, true);
+         VkResult result =
+            tu_cs_alloc(&cmd->sub_cs, TU_MESH_UBO_DWORDS / 4, 4, &ubo);
+         tu_cs_set_writeable(&cmd->sub_cs, false);
+         if (result != VK_SUCCESS) {
+            vk_command_buffer_set_error(&cmd->vk, result);
+            return;
+         }
+         memset(ubo.map, 0, TU_MESH_UBO_DWORDS * 4);
+         ubo.map[TU_MESH_UBO_DRAW_INDEX] = i;
+         tu_emit_mesh_ubo(cs, MESA_SHADER_COMPUTE, mesh->const_state.mesh_ubo.idx,
+                          ubo.iova);
+         if (task) {
+            tu_emit_mesh_ubo(cs, MESA_SHADER_COMPUTE,
+                             task->const_state.mesh_ubo.idx, ubo.iova);
+         }
+      }
+
+      uint32_t *nop_hdr = NULL;
+      if (count_va) {
+         tu_cs_reserve(cs, 8 + 64);
+         tu_cs_emit_pkt7(cs, CP_COND_EXEC, 6);
+         tu_cs_emit_qw(cs, guard.iova);
+         tu_cs_emit_qw(cs, count_va);
+         tu_cs_emit(cs, i);
+         tu_cs_emit(cs, 1);
+         tu_cs_emit_pkt7(cs, CP_NOP, 0);
+         nop_hdr = cs->cur - 1;
+      }
+
+      tu_cs_emit_regs(cs, VPC_UNKNOWN_CNTL(CHIP, siv_bits));
+      tu_emit_mesh_native_prim_regs(cs, layout->prim_dwords,
+                                    layout->prim_loc);
+      tu_cs_emit_pkt4(cs, SP_SHARED_CONSTANT_GFX_REG(CHIP, 0x47).reg, 1);
+      tu_cs_emit(cs, i);
+
+      tu_emit_mesh_native_packet(
+         cs, base, mesh->mesh_native_desc, groups_xyz,
+         indirect ? indirect_va + static_cast<uint64_t>(i) * stride : 0,
+         slots_per_batch, vertex_bytes, prim_bytes, view_word);
+      tu_emit_mesh_native_prim_regs(cs, 0, 0);
+      tu_cs_emit_regs(cs, VPC_UNKNOWN_CNTL(CHIP, 0));
+
+      if (nop_hdr)
+         *nop_hdr = pm4_pkt7_hdr(CP_NOP, cs->cur - nop_hdr - 1);
+
+      trace_end_draw(&cmd->rp_trace, cs);
+   }
+}
+
+template <chip CHIP>
+static void
+tu_draw_mesh_tasks(struct tu_cmd_buffer *cmd, const uint32_t *groups_xyz,
+                   uint64_t indirect_va, uint32_t stride, uint64_t count_va,
+                   uint32_t draw_count)
+{
+   struct tu_shader *mesh = cmd->state.mesh_shader;
+   struct tu_shader *task = cmd->state.task_shader;
+   const struct tu_mesh_layout *layout = cmd->state.mesh_layout;
+   const bool indirect = !groups_xyz;
+   const bool has_task = task;
+   const uint32_t unit_dwords = 16;
+   const uint32_t block_units = DIV_ROUND_UP(TU_MESH_UBO_DWORDS + 16, 4);
+   const uint32_t payload_size = layout->task_payload_size;
+   const uint64_t task_unit_bytes = 16 + 4 + payload_size;
+
+   if (!mesh || !draw_count)
+      return;
+
+   if (layout->native) {
+      tu_draw_mesh_native<CHIP>(cmd, groups_xyz, indirect_va, stride, count_va,
+                                draw_count);
+      return;
+   }
+
+   uint32_t capacity, task_capacity = 0;
+   if (indirect) {
+      const uint64_t share = has_task ? TU_MESH_SCRATCH_BUDGET / 2 :
+                                        TU_MESH_SCRATCH_BUDGET;
+      capacity = CLAMP(share /
+                       (static_cast<uint64_t>(layout->slot_stride) * draw_count),
+                       1u, 1u << 22);
+      if (has_task) {
+         task_capacity = CLAMP(share / (task_unit_bytes * draw_count),
+                               1u, 1u << 22);
+      }
+   } else {
+      if (!groups_xyz[0] || !groups_xyz[1] || !groups_xyz[2])
+         return;
+      if (has_task) {
+         task_capacity = groups_xyz[0] * groups_xyz[1] * groups_xyz[2];
+         capacity = CLAMP(TU_MESH_SCRATCH_BUDGET / layout->slot_stride,
+                          1u, 1u << 22);
+      } else {
+         capacity = groups_xyz[0] * groups_xyz[1] * groups_xyz[2];
+      }
+   }
+
+   const uint64_t scratch_bytes = static_cast<uint64_t>(capacity) * layout->slot_stride;
+   const uint64_t records_offset = scratch_bytes;
+   const uint64_t base_offset = records_offset + 16ull * task_capacity;
+   const uint64_t payloads_offset = base_offset + ALIGN_POT(4ull * task_capacity, 16);
+   const uint64_t total_bytes =
+      has_task ? payloads_offset + static_cast<uint64_t>(task_capacity) * payload_size :
+                 scratch_bytes;
+   if (total_bytes > (1u << 30)) {
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return;
+   }
+
+   for (uint32_t i = 0; i < draw_count; i++) {
+      tu_emit_cache_flush<CHIP>(cmd);
+
+      struct tu_cs_memory scratch, ubo;
+      tu_cs_set_writeable(&cmd->sub_cs, true);
+      VkResult result =
+         tu_cs_alloc(&cmd->sub_cs, DIV_ROUND_UP(total_bytes, unit_dwords * 4),
+                     unit_dwords, &scratch);
+      if (result == VK_SUCCESS)
+         result = tu_cs_alloc(&cmd->sub_cs, block_units, 4, &ubo);
+      tu_cs_set_writeable(&cmd->sub_cs, false);
+      if (result != VK_SUCCESS) {
+         vk_command_buffer_set_error(&cmd->vk, result);
+         return;
+      }
+
+      const bool gpu_args = indirect || has_task;
+      const uint64_t args_va = gpu_args ? ubo.iova + TU_MESH_UBO_DWORDS * 4 : 0;
+      const uint64_t summary_va = args_va + 16;
+      const uint64_t dims_va = args_va + 32;
+      const uint64_t xyz_va = args_va + 48;
+      memset(ubo.map, 0, block_units * 16);
+      tu_mesh_ubo_set_va(ubo.map, TU_MESH_UBO_SCRATCH, scratch.iova);
+      ubo.map[TU_MESH_UBO_DRAW_INDEX] = i;
+      ubo.map[TU_MESH_UBO_CAPACITY] = capacity;
+      tu_mesh_ubo_set_va(ubo.map, TU_MESH_UBO_ARGS, args_va);
+      ubo.map[TU_MESH_UBO_COUNT_LIMIT] = UINT32_MAX;
+      if (has_task) {
+         tu_mesh_ubo_set_va(ubo.map, TU_MESH_UBO_TASK_RECORDS,
+                            scratch.iova + records_offset);
+         tu_mesh_ubo_set_va(ubo.map, TU_MESH_UBO_TASK_PAYLOADS,
+                            scratch.iova + payloads_offset);
+         tu_mesh_ubo_set_va(ubo.map, TU_MESH_UBO_TASK_BASE,
+                            scratch.iova + base_offset);
+         tu_mesh_ubo_set_va(ubo.map, TU_MESH_UBO_TASK_SUMMARY, summary_va);
+         ubo.map[TU_MESH_UBO_TASK_CAPACITY] = task_capacity;
+         ubo.map[TU_MESH_UBO_TASK_VERTS_PER_GROUP] =
+            layout->max_primitives * layout->verts_per_prim;
+         tu_mesh_ubo_set_va(ubo.map, TU_MESH_UBO_TASK_MESH_DIMS, dims_va);
+         tu_mesh_ubo_set_va(ubo.map, TU_MESH_UBO_TASK_XYZ, xyz_va);
+      }
+
+      struct tu_dispatch_info info = {};
+      info.mesh_shader = has_task ? task : mesh;
+      info.mesh_ubo = ubo.iova;
+      if (gpu_args) {
+         const unsigned zero_dwords = indirect ? 16 : 12;
+         tu_cs_emit_pkt7(&cmd->cs, CP_MEM_WRITE, 2 + zero_dwords);
+         tu_cs_emit_qw(&cmd->cs, args_va);
+         for (unsigned j = 0; j < zero_dwords; j++)
+            tu_cs_emit(&cmd->cs, 0);
+         tu_cs_emit_pkt7(&cmd->cs, CP_WAIT_MEM_WRITES, 0);
+      }
+      if (indirect) {
+         const uint64_t src_va = indirect_va + static_cast<uint64_t>(i) * stride;
+         info.indirect = src_va;
+
+         if (count_va) {
+            const uint64_t limit_va = ubo.iova + TU_MESH_UBO_COUNT_LIMIT * 4;
+            const uint64_t neg_va = ubo.iova + TU_MESH_UBO_NEG_COUNT * 4;
+
+            tu_cs_emit_pkt7(&cmd->cs, CP_MEM_TO_MEM, 5);
+            tu_cs_emit(&cmd->cs, CP_MEM_TO_MEM_0_WAIT_FOR_MEM_WRITES);
+            tu_cs_emit_qw(&cmd->cs, limit_va);
+            tu_cs_emit_qw(&cmd->cs, count_va);
+
+            tu_cs_emit_pkt7(&cmd->cs, CP_MEM_TO_MEM, 7);
+            tu_cs_emit(&cmd->cs, CP_MEM_TO_MEM_0_NEG_B |
+                                 CP_MEM_TO_MEM_0_WAIT_FOR_MEM_WRITES);
+            tu_cs_emit_qw(&cmd->cs, neg_va);
+            tu_cs_emit_qw(&cmd->cs, xyz_va + 12);
+            tu_cs_emit_qw(&cmd->cs, count_va);
+
+            tu_cs_emit_pkt7(&cmd->cs, CP_WAIT_MEM_WRITES, 0);
+            tu_cs_emit_wfi(&cmd->cs);
+
+            tu_cs_reserve(&cmd->cs, 7 + 3 * 6);
+            tu_cs_emit_pkt7(&cmd->cs, CP_COND_EXEC, 6);
+            tu_cs_emit_qw(&cmd->cs, ubo.iova + TU_MESH_UBO_CAPACITY * 4);
+            tu_cs_emit_qw(&cmd->cs, neg_va);
+            tu_cs_emit(&cmd->cs, -(i + 1));
+            tu_cs_emit(&cmd->cs, 3 * 6);
+            for (unsigned j = 0; j < 3; j++) {
+               tu_cs_emit_pkt7(&cmd->cs, CP_MEM_TO_MEM, 5);
+               tu_cs_emit(&cmd->cs, 0);
+               tu_cs_emit_qw(&cmd->cs, xyz_va + j * 4);
+               tu_cs_emit_qw(&cmd->cs, src_va + j * 4);
+            }
+            info.indirect = xyz_va;
+         } else if (has_task) {
+            for (unsigned j = 0; j < 3; j++) {
+               tu_cs_emit_pkt7(&cmd->cs, CP_MEM_TO_MEM, 5);
+               tu_cs_emit(&cmd->cs, j ? 0 : CP_MEM_TO_MEM_0_WAIT_FOR_MEM_WRITES);
+               tu_cs_emit_qw(&cmd->cs, xyz_va + j * 4);
+               tu_cs_emit_qw(&cmd->cs, src_va + j * 4);
+            }
+            info.indirect = xyz_va;
+         }
+
+         tu_cs_emit_pkt7(&cmd->cs, CP_WAIT_MEM_WRITES, 0);
+         tu_emit_event_write<CHIP>(cmd, &cmd->cs, FD_CACHE_INVALIDATE);
+         tu_cs_emit_wfi(&cmd->cs);
+      } else {
+         memcpy(info.blocks, groups_xyz, sizeof(info.blocks));
+         if (has_task)
+            memcpy(&ubo.map[(xyz_va - ubo.iova) / 4], groups_xyz, 12);
+      }
+
+      const bool cond_hoist = cmd->state.predication_active &&
+                              cmd->state.cond_render.in_pass;
+      if (cond_hoist) {
+         tu_emit_cache_flush<CHIP>(cmd);
+         tu_emit_cond_render_begin<CHIP>(cmd, &cmd->cs, cmd->state.cond_render.iova,
+                                         cmd->state.cond_render.inverted, false);
+      }
+
+      tu_cs_emit_state_ib(&cmd->cs, info.mesh_shader->state);
+      tu_dispatch<CHIP>(cmd, &info);
+
+      if (has_task) {
+         BITMASK_ENUM(tu_cmd_access_mask) task_dst_access =
+            TU_ACCESS_UCHE_READ | TU_ACCESS_CCHE_READ;
+         tu_flush_for_access<CHIP>(&cmd->state.cache, TU_ACCESS_UCHE_WRITE,
+                                   task_dst_access);
+         tu_flush_for_stage<CHIP>(&cmd->state.cache, TU_STAGE_BR, TU_STAGE_BR,
+                                  false);
+
+         struct tu_dispatch_info prefix = {};
+         prefix.blocks[0] = prefix.blocks[1] = prefix.blocks[2] = 1;
+         prefix.mesh_shader = cmd->device->mesh_prefix;
+         prefix.mesh_ubo = ubo.iova;
+         tu_cs_emit_state_ib(&cmd->cs, prefix.mesh_shader->state);
+         tu_dispatch<CHIP>(cmd, &prefix);
+
+         BITMASK_ENUM(tu_cmd_access_mask) prefix_dst_access =
+            TU_ACCESS_UCHE_READ | TU_ACCESS_CCHE_READ | TU_ACCESS_SYSMEM_READ;
+         tu_flush_for_access<CHIP>(&cmd->state.cache, TU_ACCESS_UCHE_WRITE,
+                                   prefix_dst_access);
+         tu_flush_for_stage<CHIP>(&cmd->state.cache, TU_STAGE_BR,
+                                  TU_STAGE_BV_CP, false);
+
+         struct tu_dispatch_info mesh_info = {};
+         mesh_info.mesh_shader = mesh;
+         mesh_info.mesh_ubo = ubo.iova;
+         mesh_info.indirect = dims_va;
+         tu_cs_emit_state_ib(&cmd->cs, mesh->state);
+         tu_dispatch<CHIP>(cmd, &mesh_info);
+      }
+
+      if (cond_hoist)
+         tu_emit_cond_render_end<CHIP>(cmd, &cmd->cs, false);
+
+      BITMASK_ENUM(tu_cmd_access_mask) dst_access = TU_ACCESS_UCHE_READ;
+      if (gpu_args)
+         dst_access |= TU_ACCESS_SYSMEM_READ;
+      tu_flush_for_access<CHIP>(&cmd->state.cache, TU_ACCESS_UCHE_WRITE,
+                                dst_access);
+      tu_flush_for_stage<CHIP>(&cmd->state.cache, TU_STAGE_BR,
+                               gpu_args ? TU_STAGE_BV_CP : TU_STAGE_BV, false);
+      tu_emit_cache_flush<CHIP>(cmd);
+
+      if (cmd->state.shaders[MESA_SHADER_COMPUTE])
+         tu_cs_emit_state_ib(&cmd->cs,
+                             cmd->state.shaders[MESA_SHADER_COMPUTE]->state);
+      cmd->state.dirty |= TU_CMD_DIRTY_COMPUTE_DESC_SETS;
+
+      cmd->state.mesh_ubo = ubo.iova;
+      if (gpu_args) {
+         tu_draw_indirect_va<CHIP>(cmd, args_va, 1, 16);
+      } else {
+         tu_CmdDraw<CHIP>(tu_cmd_buffer_to_handle(cmd),
+                          capacity * layout->max_primitives * layout->verts_per_prim,
+                          1, 0, 0);
+      }
+   }
+}
