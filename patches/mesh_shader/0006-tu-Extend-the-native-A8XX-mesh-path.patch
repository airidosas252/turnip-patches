+static bool
+fs_reads_vtx_slot(const nir_shader *fs, unsigned slot)
+{
+   nir_foreach_shader_in_variable (var, fs) {
+      const unsigned n = nir_variable_count_slots(var, fs_input_type(var));
+      if (slot >= var->data.location && slot < var->data.location + n)
+         return true;
+   }
+   return false;
+}
+
+static uint64_t
+vtx_outputs_read_back(const nir_shader *nir)
+{
+   uint64_t mask = 0;
+
+   nir_foreach_function_impl (impl, nir) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_load_deref)
+               continue;
+            nir_variable *var =
+               nir_deref_instr_get_variable(nir_src_as_deref(intr->src[0]));
+            if (!var || var->data.mode != nir_var_shader_out ||
+                var->data.per_primitive)
+               continue;
+            const unsigned n =
+               nir_variable_count_slots(var, glsl_get_array_element(var->type));
+            for (unsigned j = 0; j < n && var->data.location + j < 64; j++)
+               mask |= BITFIELD64_BIT(var->data.location + j);
+         }
+      }
+   }
+
+   return mask;
+}
+
+static void
+prune_unread_vtx_slots(struct tu_mesh_layout *layout, const nir_shader *nir,
+                       const nir_shader *fs)
+{
+   const uint64_t read_back = vtx_outputs_read_back(nir);
+   unsigned num = 0;
+
+   for (unsigned i = 0; i < layout->num_vtx_slots; i++) {
+      const unsigned slot = layout->vtx_slots[i];
+      if (slot < VARYING_SLOT_VAR0 || fs_reads_vtx_slot(fs, slot) ||
+          (read_back & BITFIELD64_BIT(slot)))
+         layout->vtx_slots[num++] = slot;
+   }
+   layout->num_vtx_slots = num;
+}
