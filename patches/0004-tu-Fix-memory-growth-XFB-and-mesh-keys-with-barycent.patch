+static bool
+tu_nir_shaders_set(struct tu_nir_shaders *shaders, mesa_shader_stage stage,
+                   nir_shader *nir)
+{
+   struct blob blob;
+   blob_init(&blob);
+   nir_serialize(&blob, nir, false);
+   ralloc_free(nir);
+   if (blob.out_of_memory) {
+      blob_finish(&blob);
+      return false;
+   }
+   blob_finish_get_buffer(&blob, &shaders->nir[stage].data,
+                          &shaders->nir[stage].size);
+   return true;
+}
+
+static nir_shader *
+tu_nir_shaders_get(struct tu_device *dev, const struct tu_nir_shaders *shaders,
+                   mesa_shader_stage stage, void *mem_ctx)
+{
+   struct blob_reader blob;
+   blob_reader_init(&blob, shaders->nir[stage].data, shaders->nir[stage].size);
+   return nir_deserialize(mem_ctx, ir3_get_compiler_options(dev->compiler),
+                          &blob);
+}
