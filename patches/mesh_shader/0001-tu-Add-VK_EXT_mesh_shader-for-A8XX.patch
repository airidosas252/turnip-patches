+
+   desc[0] = (layout->has_cull ? 4 : 0) | (layout->prim_dwords ? 8 : 0) |
+             (layout->verts_per_prim == 2 ? 0x20 : 0) |
+             (layout->point_list ? 0x40 : 0);
+   desc[4] = bunch_iova;
+   desc[5] = bunch_iova >> 32;
+   desc[6] = cs->cur - bunch;
+   desc[7] = layout->max_primitives *
+             (layout->point_list ? 1 : layout->verts_per_prim == 2 ? 3 : 4);
+   desc[9] = layout->max_vertices * layout->vertex_stride;
+   desc[11] = layout->max_primitives * layout->prim_dwords * 4;
