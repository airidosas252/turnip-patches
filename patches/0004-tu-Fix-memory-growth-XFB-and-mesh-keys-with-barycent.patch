 src/freedreno/vulkan/tu_pipeline.cc           | 205 ++++++++++++------
 src/freedreno/vulkan/tu_pipeline.h            |   8 +-
 src/freedreno/vulkan/tu_shader.cc             |   4 +-
 4 files changed, 177 insertions(+), 79 deletions(-)

diff --git a/src/freedreno/vulkan/tu_nir_lower_fs_barycentric.cc b/src/freedreno/vulkan/tu_nir_lower_fs_barycentric.cc
