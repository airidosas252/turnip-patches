+/* A shader reads the indirect launch command at `indirect_va` and writes the
+ * launch size, the shader binding tables if the command has them, and the
+ * group counts that the CP dispatches with, in the launch UBO at `launch`.
+ */
+template <chip CHIP>
+static void
+tu_rt_prepass(struct tu_cmd_buffer *cmd, uint64_t indirect_va, uint64_t launch,
+              bool indirect2)
+{
+   struct tu_cs_memory ubo;
+   VkResult result = tu_cs_alloc(&cmd->sub_cs, TU_MESH_UBO_DWORDS / 4, 4, &ubo);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   memset(ubo.map, 0, TU_MESH_UBO_DWORDS * 4);
+   tu_mesh_ubo_set_va(ubo.map, TU_RT_PREPASS_UBO_COMMAND, indirect_va);
+   tu_mesh_ubo_set_va(ubo.map, TU_RT_PREPASS_UBO_LAUNCH, launch);
+   ubo.map[TU_RT_PREPASS_UBO_INDIRECT2] = indirect2;
+
+   struct tu_dispatch_info prepass = {};
+   prepass.blocks[0] = prepass.blocks[1] = prepass.blocks[2] = 1;
+   prepass.mesh_shader = cmd->device->rt_prepass;
+   prepass.mesh_ubo = ubo.iova;
+   prepass.desc_bind_point = VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR;
+   /* The command is read by the shader, not by the CP as the barriers that
+    * made it visible assume.
+    */
+   tu_flush_for_access<CHIP>(&cmd->state.cache, TU_ACCESS_NONE, TU_ACCESS_UCHE_READ);
+
+   tu_cs_emit_state_ib(&cmd->cs, prepass.mesh_shader->state);
+   tu_dispatch<CHIP>(cmd, &prepass);
+
+   /* The launch UBO is read by the shader, or by the CP. */
+   BITMASK_ENUM(tu_cmd_access_mask) dst_access =
+      TU_ACCESS_UCHE_READ | TU_ACCESS_CCHE_READ | TU_ACCESS_SYSMEM_READ;
+   tu_flush_for_access<CHIP>(&cmd->state.cache, TU_ACCESS_UCHE_WRITE, dst_access);
+   tu_flush_for_stage<CHIP>(&cmd->state.cache, TU_STAGE_BR, TU_STAGE_BV_CP,
+                            false);
+}
+
+/* The scratch BO of the AQE launches, big enough for `size` bytes, with a
+ * reference that the caller owns. It grows, and the launches that are already
+ * recorded keep the one they use.
+ */
+static VkResult
+tu_get_rt_aqe_bo(struct tu_device *dev, uint64_t size, struct tu_bo **bo)
+{
+   VkResult result = VK_SUCCESS;
+
+   mtx_lock(&dev->mutex);
+   if (!dev->rt_aqe_bo || dev->rt_aqe_bo->size < size) {
+      struct tu_bo *new_bo;
+      result = tu_bo_init_new_explicit_iova(
+         dev, NULL, &new_bo, ALIGN_POT(size, 1 << 20), 0, 0,
+         VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+            VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT,
+         TU_BO_ALLOC_INTERNAL_RESOURCE, NULL, "rt_aqe");
+      if (result == VK_SUCCESS) {
+         if (dev->rt_aqe_bo)
+            tu_bo_finish(dev, dev->rt_aqe_bo);
+         dev->rt_aqe_bo = new_bo;
+      }
+   }
+   if (result == VK_SUCCESS)
+      *bo = tu_bo_get_ref(dev->rt_aqe_bo);
+   mtx_unlock(&dev->mutex);
+
+   return result;
+}
+
+/* The scratch of the threads of the AQE is limited to this many bytes, which
+ * is what the stock driver does.
+ */
+#define TU_RT_AQE_BUDGET 0x1200000ull
+
+/* Launch the rays through the AQE. The packet has the tables that it fills
+ * out and uses itself, its scratch for the state of the threads and the pending
+ * lists in the one BO, and the programs it runs, which are in the pipeline.
+ */
+template <chip CHIP>
+static void
+tu_trace_rays_aqe(struct tu_cmd_buffer *cmd,
+                  const VkStridedDeviceAddressRegionKHR *const *sbt,
+                  const uint32_t *dims, uint64_t indirect_va)
+{
+   struct tu_rt_aqe *aqe = cmd->state.rt_aqe;
+
+   if (dims && (!dims[0] || !dims[1] || !dims[2]))
+      return;
+
+   const uint32_t stack = ALIGN_POT(cmd->state.rt_stack_dynamic && cmd->state.rt_stack_is_set ?
+                                    cmd->state.rt_stack_set : cmd->state.rt_stack_default, 16);
+   if (dims && (uint64_t)dims[0] * dims[1] * dims[2] > UINT32_MAX) {
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return;
+   }
+
+   /* The state of a thread is 2 AQE contexts times a number of threads in
+    * flight, which has to fit the u16 IDs, and the pending lists of the slots
+    * are the same size for each.
+    */
+   const uint64_t s0 = aqe->scratch0_size;
+   const uint64_t s1 = TU_RT_SCRATCH_STACK + static_cast<uint64_t>(stack);
+   const uint32_t slots = aqe->num_shaders + 1;
+   const uint64_t per_thread = 2 * (s0 + s1) + 4ull * slots;
+   uint64_t max_active = MIN2(65535ull, TU_RT_AQE_BUDGET / per_thread);
+   if (cmd->device->rt_aqe_max_active)
+      max_active = MIN2(max_active, cmd->device->rt_aqe_max_active);
+   if (!max_active || s1 > UINT32_MAX / 2) {
+      mesa_loge("rt_pipeline: stack size %u does not fit the AQE scratch", stack);
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return;
+   }
+
+   const uint64_t pending_stride = ALIGN_POT(2 * max_active, 4);
+   uint64_t size = 0;
+   const uint64_t gc0 = size; size += 16;
+   const uint64_t gc1 = size; size += 16;
+   const uint64_t shader_to_slot = size; size += 8ull * aqe->num_shaders;
+   const uint64_t slot_to_shader = size; size += 8ull * slots;
+   const uint64_t counts = size; size += 8ull * slots;
+   size = ALIGN_POT(size, 256);
+   const uint64_t pending = size; size += 2ull * slots * pending_stride;
+   size = ALIGN_POT(size, 256);
+   const uint64_t scratch0 = size; size += 2 * max_active * s0;
+   const uint64_t scratch1 = size; size += 2 * max_active * s1;
+
+   struct tu_bo *bo;
+   VkResult result = tu_get_rt_aqe_bo(cmd->device, size, &bo);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+   if (bo != cmd->state.rt_aqe_bo) {
+      util_dynarray_append(&cmd->rt_pvtmem_bos, bo);
+      cmd->state.rt_aqe_bo = bo;
+   } else {
+      tu_bo_finish(cmd->device, bo);
+   }
+
+   const uint64_t base = bo->iova;
+   if (cmd->device->rt_log) {
+      /* DEBUG */
+      static thread_local const void *last_aqe;
+      static thread_local uint64_t last_size;
+      if (last_aqe != aqe || last_size != size) {
+         mesa_logi("rt_pipeline: aqe DEBUG launch shaders %u bo 0x%" PRIx64 "+0x%" PRIx64
+                   " size 0x%" PRIx64 " M %" PRIu64 " s0 %" PRIu64 " s1 %" PRIu64
+                   " scratch0 +0x%" PRIx64 " scratch1 +0x%" PRIx64 " indirect %d",
+                   aqe->num_shaders, bo->iova, bo->size, size, max_active, s0, s1,
+                   scratch0, scratch1, indirect_va != 0);
+         last_aqe = aqe;
+         last_size = size;
+      }
+   }
+   struct tu_cs_memory consts_mem;
+   tu_cs_set_writeable(&cmd->sub_cs, true);
+   result = tu_cs_alloc(&cmd->sub_cs, 12, 4, &consts_mem);
+   tu_cs_set_writeable(&cmd->sub_cs, false);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+   uint32_t *consts = consts_mem.map;
+   memset(consts, 0, 48 * sizeof(uint32_t));
+
+   if (dims)
+      memcpy(&consts[TU_RT_UBO_LAUNCH_SIZE], dims, 3 * sizeof(uint32_t));
+   consts[TU_RT_UBO_STACK_LIMIT] = s1;
+   for (unsigned i = 0; sbt && i < 4; i++) {
+      uint32_t *dst = &consts[TU_RT_UBO_RAYGEN_SBT + i * 4];
+      tu_mesh_ubo_set_va(dst, 0, sbt[i]->deviceAddress);
+      dst[2] = sbt[i]->stride;
+      dst[3] = MIN2(sbt[i]->size, UINT32_MAX);
+   }
+   tu_mesh_ubo_set_va(consts, TU_RT_AQE_COUNTS, base + counts);
+   tu_mesh_ubo_set_va(consts, TU_RT_AQE_PENDING, base + pending);
+   consts[TU_RT_AQE_PENDING_STRIDE] = pending_stride;
+   consts[TU_RT_AQE_SCRATCH1_STRIDE] = s1;
+   consts[TU_RT_AQE_SCRATCH0_STRIDE] = s0;
+
+   /* The shader binding tables of vkCmdTraceRaysIndirect2KHR are written in
+    * the constants by the prepass, the AQE reads the dimensions after them.
+    */
+   if (!sbt) {
+      tu_rt_prepass<CHIP>(cmd, indirect_va, consts_mem.iova, true);
+      indirect_va += offsetof(VkTraceRaysIndirectCommand2KHR, width);
+   }
+
+   uint32_t packet[30];
+   unsigned n = 0;
+   auto qw = [&](uint64_t v) { packet[n++] = v; packet[n++] = v >> 32; };
+
+   packet[n++] = indirect_va ? 4 : 2;
+   qw(aqe->starter_index);
+   if (indirect_va) {
+      qw(indirect_va);
+   } else {
+      packet[n++] = dims[0];
+      packet[n++] = dims[1];
+      packet[n++] = dims[2];
+   }
+   qw(base + gc0);
+   qw(base + gc1);
+   packet[n++] = slots;
+   qw(base + slot_to_shader);
+   qw(base + shader_to_slot);
+   qw(base + counts);
+   packet[n++] = max_active;
+   qw(base + pending);
+   packet[n++] = s0;
+   qw(base + scratch0);
+   packet[n++] = s1;
+   qw(base + scratch1);
+   qw(aqe->ib_addrs);
+   qw(aqe->ib_lengths);
+
+   struct tu_dispatch_info info = {};
+   info.blocks[0] = info.blocks[1] = info.blocks[2] = 1;
+   info.mesh_shader = aqe->consts;
+   info.desc_bind_point = VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR;
+   info.aqe_packet = packet;
+   info.aqe_packet_dwords = n;
+   info.aqe_consts = consts_mem.iova;
+   info.aqe_instrlen = aqe->instrlen;
+
+   tu_cs_emit_state_ib(&cmd->cs, aqe->consts->state);
+   tu_dispatch<CHIP>(cmd, &info);
+
+   if (cmd->state.shaders[MESA_SHADER_COMPUTE])
+      tu_cs_emit_state_ib(&cmd->cs,
+                          cmd->state.shaders[MESA_SHADER_COMPUTE]->state);
+   cmd->state.dirty |= TU_CMD_DIRTY_COMPUTE_DESC_SETS;
+}
+
+/* Launch the rays with the direct dimensions, or from the command at
+ * indirect_va. The shader binding tables are at `sbt`, if they are not in the
+ * indirect command.
+ */
+template <chip CHIP>
+static void
+tu_trace_rays(struct tu_cmd_buffer *cmd,
+              const VkStridedDeviceAddressRegionKHR *const *sbt,
+              const uint32_t *dims, uint64_t indirect_va)
+{
+   /* DEBUG: skip the ray tracing launches to see whether a problem comes from them. */
+   if (debug_get_bool_option("TU_DBG_RT_SKIP", false))
+      return;
+
+   if (cmd->state.rt_aqe) {
+      tu_trace_rays_aqe<CHIP>(cmd, sbt, dims, indirect_va);
+      return;
+   }
+
+   struct tu_shader *shader = cmd->state.rt_shader;
+
+   struct tu_cs_memory ubo;
+   tu_cs_set_writeable(&cmd->sub_cs, true);
+   VkResult result = tu_cs_alloc(&cmd->sub_cs, TU_MESH_UBO_DWORDS / 4, 4, &ubo);
+   tu_cs_set_writeable(&cmd->sub_cs, false);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   memset(ubo.map, 0, TU_MESH_UBO_DWORDS * 4);
+   for (unsigned i = 0; sbt && i < 4; i++) {
+      uint32_t *dst = &ubo.map[TU_RT_UBO_RAYGEN_SBT + i * 4];
+      tu_mesh_ubo_set_va(dst, 0, sbt[i]->deviceAddress);
+      dst[2] = sbt[i]->stride;
+      dst[3] = MIN2(sbt[i]->size, UINT32_MAX);
+   }
+
+   /* The stack of a separate mode pipeline is after the private memory of
+    * the shader, in a BO that is big enough for the size the application
+    * sets or the default of the pipeline.
+    */
+   struct tu_pvtmem_config pvtmem = {};
+   const struct ir3_shader_variant *v = shader->variant;
+   if (cmd->state.rt_stack_default) {
+      uint32_t size = ALIGN_POT(cmd->state.rt_stack_dynamic &&
+                                cmd->state.rt_stack_set ?
+                                cmd->state.rt_stack_set :
+                                cmd->state.rt_stack_default, 16);
+      struct tu_bo *bo;
+
+      /* The private memory of a fiber has a limit, the calls that would go
+       * past the stack that fits end their rays.
+       */
+      const uint32_t max_fiber = tu_max_pvtmem_per_fiber(cmd->device);
+      const uint32_t room = max_fiber > v->pvtmem_size ?
+         (max_fiber - v->pvtmem_size) & ~15u : 0;
+      if (size > room) {
+         mesa_logw_once("rt_pipeline: stack size %u is more than the %u that fit "
+                        "in private memory", size, room);
+         size = room;
+      }
+
+      ubo.map[TU_RT_UBO_STACK_BASE] = v->pvtmem_size;
+      ubo.map[TU_RT_UBO_STACK_LIMIT] = v->pvtmem_size + size;
+
+      result = tu_get_pvtmem(cmd->device, &pvtmem, &bo, v->pvtmem_size + size,
+                             v->pvtmem_per_wave);
+      if (result != VK_SUCCESS) {
+         vk_command_buffer_set_error(&cmd->vk, result);
+         return;
+      }
+      if (bo != cmd->state.rt_pvtmem_bo) {
+         util_dynarray_append(&cmd->rt_pvtmem_bos, bo);
+         cmd->state.rt_pvtmem_bo = bo;
+      } else {
+         tu_bo_finish(cmd->device, bo);
+      }
+   }
+
+   struct tu_dispatch_info info = {};
+   info.mesh_shader = shader;
+   info.mesh_ubo = ubo.iova;
+   info.desc_bind_point = VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR;
+   info.pvtmem = pvtmem.iova ? &pvtmem : NULL;
+
+   if (dims) {
+      memcpy(&ubo.map[TU_RT_UBO_LAUNCH_SIZE], dims, 3 * sizeof(uint32_t));
+      info.blocks[0] = DIV_ROUND_UP(dims[0], TU_RT_WORKGROUP_SIZE);
+      info.blocks[1] = DIV_ROUND_UP(dims[1], TU_RT_WORKGROUP_SIZE);
+      info.blocks[2] = dims[2];
+   } else {
+      tu_rt_prepass<CHIP>(cmd, indirect_va, ubo.iova, !sbt);
+      info.indirect = ubo.iova + TU_RT_UBO_GROUP_COUNTS * 4;
+   }
+
+   tu_cs_emit_state_ib(&cmd->cs, shader->state);
+   tu_dispatch<CHIP>(cmd, &info);
+
+   if (cmd->state.shaders[MESA_SHADER_COMPUTE])
+      tu_cs_emit_state_ib(&cmd->cs,
+                          cmd->state.shaders[MESA_SHADER_COMPUTE]->state);
+   cmd->state.dirty |= TU_CMD_DIRTY_COMPUTE_DESC_SETS;
+}
+
+template <chip CHIP>
+VKAPI_ATTR void VKAPI_CALL
+tu_CmdTraceRaysKHR(VkCommandBuffer commandBuffer,
+                   const VkStridedDeviceAddressRegionKHR *pRaygenShaderBindingTable,
+                   const VkStridedDeviceAddressRegionKHR *pMissShaderBindingTable,
+                   const VkStridedDeviceAddressRegionKHR *pHitShaderBindingTable,
+                   const VkStridedDeviceAddressRegionKHR *pCallableShaderBindingTable,
+                   uint32_t width,
+                   uint32_t height,
+                   uint32_t depth)
+{
+   VK_FROM_HANDLE(tu_cmd_buffer, cmd, commandBuffer);
+   const VkStridedDeviceAddressRegionKHR *sbt[] = {
+      pRaygenShaderBindingTable, pMissShaderBindingTable,
+      pHitShaderBindingTable, pCallableShaderBindingTable,
+   };
+   const uint32_t dims[] = { width, height, depth };
+
+   tu_trace_rays<CHIP>(cmd, sbt, dims, 0);
+}
+TU_GENX(tu_CmdTraceRaysKHR);
+
+template <chip CHIP>
+VKAPI_ATTR void VKAPI_CALL
+tu_CmdTraceRaysIndirectKHR(VkCommandBuffer commandBuffer,
+                           const VkStridedDeviceAddressRegionKHR *pRaygenShaderBindingTable,
+                           const VkStridedDeviceAddressRegionKHR *pMissShaderBindingTable,
+                           const VkStridedDeviceAddressRegionKHR *pHitShaderBindingTable,
+                           const VkStridedDeviceAddressRegionKHR *pCallableShaderBindingTable,
+                           VkDeviceAddress indirectDeviceAddress)
+{
+   VK_FROM_HANDLE(tu_cmd_buffer, cmd, commandBuffer);
+   const VkStridedDeviceAddressRegionKHR *sbt[] = {
+      pRaygenShaderBindingTable, pMissShaderBindingTable,
+      pHitShaderBindingTable, pCallableShaderBindingTable,
+   };
+
+   tu_trace_rays<CHIP>(cmd, sbt, NULL, indirectDeviceAddress);
+}
+TU_GENX(tu_CmdTraceRaysIndirectKHR);
+
+template <chip CHIP>
+VKAPI_ATTR void VKAPI_CALL
+tu_CmdTraceRaysIndirect2KHR(VkCommandBuffer commandBuffer,
+                            VkDeviceAddress indirectDeviceAddress)
+{
+   VK_FROM_HANDLE(tu_cmd_buffer, cmd, commandBuffer);
+
+   tu_trace_rays<CHIP>(cmd, NULL, NULL, indirectDeviceAddress);
+}
+TU_GENX(tu_CmdTraceRaysIndirect2KHR);
