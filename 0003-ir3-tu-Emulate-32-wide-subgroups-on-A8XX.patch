 src/freedreno/ir3/ir3_shader.c          |  11 +
 src/freedreno/ir3/ir3_shader.h          |   2 +
 src/freedreno/vulkan/tu_device.cc       |  33 ++-
 src/freedreno/vulkan/tu_shader.cc       |  10 +
 src/freedreno/vulkan/tu_shader.h        |   3 +-
