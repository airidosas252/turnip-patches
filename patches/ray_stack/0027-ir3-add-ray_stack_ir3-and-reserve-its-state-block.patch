 src/freedreno/ir3/ir3_compiler_nir.c       | 25 ++++++++
 src/freedreno/ir3/ir3_legalize.c           |  2 +-
 src/freedreno/ir3/ir3_nir.c                | 19 ++++++
 src/freedreno/ir3/ir3_ra.c                 | 70 +++++++++++++++++++++-
 src/freedreno/ir3/ir3_validate.c           |  4 ++
 11 files changed, 145 insertions(+), 4 deletions(-)

