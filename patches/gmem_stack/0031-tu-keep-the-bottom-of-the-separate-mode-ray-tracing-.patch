+/* GMEM stack: the stack is in global memory instead of
+ * private memory, and the bottom of the stack of each thread, where most of the
+ * accesses are, is in GMEM. Each wave slot of each SP has a share of each: of a
+ * BO for 64 wave slots, all that an SP has, and of a region of GMEM for the
+ * slots that the register footprint allows. Dword i of a lane is next to dword
+ * i of the other lanes of the wave, like in private memory. A thread whose slot
+ * doesn't fit in GMEM uses the BO for its whole stack, so a wrong count of
+ * slots costs speed but not correctness.
+ *
+ * An access picks the memory with a select, which is cheaper than a branch
+ * around it. Which memory a byte is in only depends on where it is, so that all
+ * the accesses to it agree: the share of GMEM is a multiple of 16 bytes, and an
+ * access that may cross 16 aligned bytes is split.
+ */
+struct rt_gmem_stack {
+   /* The region of GMEM (32 bits) and the BO, and the offset of the share of
+    * the thread in each. The address that a lane accesses is the same for all
+    * of them and only the offset depends on the lane, which keeps the accesses
+    * of a wave together.
+    */
+   nir_def *gmem, *global;
+   nir_def *gmem_offset, *global_offset;
+
+   /* The bytes at the start of the stack that are in GMEM, 0 if none. */
+   nir_def *size;
+
+   /* Where the stack starts in private memory, which the addresses are
+    * relative to.
+    */
+   nir_def *base;
+};
+
+static bool
+rt_gmem_within_16(unsigned align_mul, unsigned align_offset, unsigned bytes)
+{
+   const unsigned mul = MIN2(align_mul, 16);
+   return align_offset % mul + bytes <= mul;
+}
+
+/* Load or store (`value`) `num_components` of `bit_size` at `addr`, which are
+ * dwords within 16 aligned bytes, or one smaller component.
+ */
+static nir_def *
+rt_gmem_access(nir_builder *b, const struct rt_gmem_stack *gs, nir_def *addr,
+               unsigned num_components, unsigned bit_size, nir_def *value)
+{
+   nir_def *rel = nir_isub(b, addr, gs->base);
+   nir_def *in_gmem = nir_ult(b, rel, gs->size);
+   nir_def *ptr = nir_pack_64_2x32_split(
+      b, nir_bcsel(b, in_gmem, gs->gmem, nir_unpack_64_2x32_split_x(b, gs->global)),
+      nir_bcsel(b, in_gmem, nir_imm_int(b, 0), nir_unpack_64_2x32_split_y(b, gs->global)));
+
+   nir_def *offset = nir_bcsel(b, in_gmem, gs->gmem_offset, gs->global_offset);
+   if (bit_size == 32) {
+      offset = nir_iadd(b, offset, nir_ishl_imm(b, rel, 6));
+   } else {
+      offset = nir_iadd(b, offset,
+                        nir_iadd(b, nir_ishl_imm(b, nir_iand_imm(b, rel, ~3u), 6),
+                                 nir_iand_imm(b, rel, 3)));
+   }
+
+   nir_def *comps[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned i = 0; i < num_components; i++) {
+      nir_def *comp_offset = nir_iadd_imm(b, offset, i * 256);
+      if (value) {
+         nir_store_global_offset(b, nir_channel(b, value, i), ptr, comp_offset,
+                                 .write_mask = 1, .align_mul = bit_size / 8);
+      } else {
+         comps[i] = nir_load_global_offset(b, 1, bit_size, ptr, comp_offset,
+                                           .align_mul = bit_size / 8);
+      }
+   }
+   return value ? NULL : nir_vec(b, comps, num_components);
+}
+
+static void
+rt_gmem_lower(nir_builder *b, const struct rt_gmem_stack *gs, nir_intrinsic_instr *intr)
+{
+   const bool store = intr->intrinsic == nir_intrinsic_store_scratch;
+   nir_def *value = store ? intr->src[0].ssa : NULL;
+   nir_def *addr = intr->src[store ? 1 : 0].ssa;
+   const unsigned bit_size = store ? value->bit_size : intr->def.bit_size;
+   const unsigned num_components = store ? value->num_components : intr->def.num_components;
+   unsigned mask = store ? nir_intrinsic_write_mask(intr) : BITFIELD_MASK(num_components);
+   const unsigned align_mul = nir_intrinsic_align_mul(intr);
+   const unsigned align_offset = nir_intrinsic_align_offset(intr);
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   /* Smaller components are accessed one by one. */
+   if (bit_size < 32) {
+      nir_def *comps[NIR_MAX_VEC_COMPONENTS] = {};
+      u_foreach_bit (i, mask) {
+         comps[i] = rt_gmem_access(b, gs, nir_iadd_imm(b, addr, i * bit_size / 8), 1,
+                                   bit_size, store ? nir_channel(b, value, i) : NULL);
+      }
+      if (store)
+         nir_instr_remove(&intr->instr);
+      else
+         nir_def_replace(&intr->def, nir_vec(b, comps, num_components));
+      return;
+   }
+
+   /* The others as dwords, in pieces that don't cross 16 aligned bytes. */
+   const unsigned per_comp = bit_size / 32;
+   const unsigned num_dwords = num_components * per_comp;
+   nir_def *dwords = value ? nir_bitcast_vector(b, value, 32) : NULL;
+   unsigned dword_mask = 0;
+   u_foreach_bit (i, mask)
+      dword_mask |= BITFIELD_RANGE(i * per_comp, per_comp);
+
+   nir_def *loaded[NIR_MAX_VEC_COMPONENTS * 2] = {};
+   for (unsigned i = 0; i < num_dwords;) {
+      if (!(dword_mask & BITFIELD_BIT(i))) {
+         i++;
+         continue;
+      }
+
+      const unsigned offset = align_offset + i * 4;
+      unsigned n = 1;
+      while (i + n < num_dwords && (dword_mask & BITFIELD_BIT(i + n)) &&
+             rt_gmem_within_16(align_mul, offset % align_mul, (n + 1) * 4))
+         n++;
+
+      nir_def *res = rt_gmem_access(b, gs, nir_iadd_imm(b, addr, i * 4), n, 32,
+                                    dwords ? nir_channels(b, dwords, BITFIELD_RANGE(i, n)) : NULL);
+      for (unsigned j = 0; j < n && res; j++)
+         loaded[i + j] = nir_channel(b, res, j);
+      i += n;
+   }
+
+   if (store) {
+      nir_instr_remove(&intr->instr);
+   } else {
+      nir_def_replace(&intr->def,
+                      nir_bitcast_vector(b, nir_vec(b, loaded, num_dwords), bit_size));
+   }
+}
+
+void
+rt_sep_gmem_stack(nir_shader *nir, unsigned num_sps)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   struct util_dynarray accesses;
+   util_dynarray_init(&accesses, NULL);
+
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_load_scratch &&
+             intr->intrinsic != nir_intrinsic_store_scratch)
+            continue;
+
+         /* The ones at a constant address are to the hit attributes, which
+          * stay in private memory, below the stack.
+          */
+         const bool store = intr->intrinsic == nir_intrinsic_store_scratch;
+         if (!nir_src_is_const(intr->src[store ? 1 : 0]))
+            util_dynarray_append(&accesses, intr);
+      }
+   }
+
+   /* The workgroup is a wave, and its invocations are the lanes. */
+   static_assert(TU_RT_WORKGROUP_SIZE * TU_RT_WORKGROUP_SIZE == 64, "a wave per workgroup");
+
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *base = nir_load_scratch_base_ptr(&b, 1, 32, TU_RT_UBO_STACK_BASE);
+   nir_def *stack = nir_isub(&b, nir_load_scratch_base_ptr(&b, 1, 32, TU_RT_UBO_STACK_LIMIT),
+                             base);
+   nir_def *size = nir_load_scratch_base_ptr(&b, 1, 32, TU_RT_UBO_GMEM_STACK_SIZE);
+   nir_def *waves = nir_load_scratch_base_ptr(&b, 1, 32, TU_RT_UBO_GMEM_STACK_WAVES);
+   nir_def *sp = nir_load_sm_id_nv(&b);
+   nir_def *wave = nir_load_warp_id_nv(&b);
+   nir_def *lane = nir_ishl_imm(&b, nir_load_local_invocation_index(&b), 2);
+   nir_def *fits = nir_iand(&b, nir_ult(&b, wave, waves), nir_ult_imm(&b, sp, num_sps));
+
+   nir_def *gmem_slot = nir_iadd(&b, nir_imul(&b, sp, waves), wave);
+   nir_def *global_slot = nir_iadd(&b, nir_ishl_imm(&b, sp, 6), wave);
+
+   struct rt_gmem_stack gs = {
+      .gmem = nir_load_scratch_base_ptr(&b, 1, 32, TU_RT_UBO_GMEM_STACK_ADDR),
+      .global = nir_load_scratch_base_ptr(&b, 1, 64, TU_RT_UBO_STACK_ADDR),
+      .gmem_offset = nir_iadd(&b, nir_imul(&b, gmem_slot, nir_ishl_imm(&b, size, 6)), lane),
+      .global_offset = nir_iadd(&b, nir_imul(&b, global_slot, nir_ishl_imm(&b, stack, 6)), lane),
+      .size = nir_bcsel(&b, fits, size, nir_imm_int(&b, 0)),
+      .base = base,
+   };
+
+   util_dynarray_foreach (&accesses, nir_intrinsic_instr *, intr)
+      rt_gmem_lower(&b, &gs, *intr);
+   util_dynarray_fini(&accesses);
+
+   nir_progress(true, impl, nir_metadata_none);
+}
