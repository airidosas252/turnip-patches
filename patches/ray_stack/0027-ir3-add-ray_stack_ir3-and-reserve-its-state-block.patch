    case nir_intrinsic_load_helper_op_id_agx:
    case nir_intrinsic_load_helper_arg_lo_agx:
    case nir_intrinsic_load_helper_arg_hi_agx:
diff --git a/src/compiler/nir/nir_intrinsics.py b/src/compiler/nir/nir_intrinsics.py
index 6e75b72ddb3..cbb8de9bdd3 100644
--- a/src/compiler/nir/nir_intrinsics.py
+++ b/src/compiler/nir/nir_intrinsics.py
@@ -1646,6 +1646,13 @@ load("uav_ir3", [1, 2],
 intrinsic("ray_intersection_ir3", src_comp=[2, 1, 8, 1], dest_comp=5,
           flags=[CAN_REORDER, CAN_ELIMINATE])
 
+# IR3 intrinsic for the a8xx "ray_stack" BVH traversal step.
+# src[] = { vec3(children, child base, flags) }
+# dest = next node and status
+# The traversal state is hidden in registers that the backend reserves, so it
+# has side effects: it can't be removed or reordered, even when unused.
+intrinsic("ray_stack_ir3", src_comp=[3], dest_comp=1)
+
 # System values for freedreno geometry shaders.
 system_value("vs_primitive_stride_ir3", 1)
 system_value("vs_vertex_stride_ir3", 1)
