--- a/src/freedreno/vulkan/tu_nir_lower_fs_barycentric.cc
+++ b/src/freedreno/vulkan/tu_nir_lower_fs_barycentric.cc
@@ -24,6 +24,8 @@ struct bary_state {
 
    uint64_t per_vertex_only;
    uint64_t remove;
+   uint64_t moved;
+   uint8_t move_to[64];
    unsigned id_flat_slot;
    struct bary_map id;
    nir_def *rot, *is_line, *is_point;
@@ -329,8 +331,18 @@ lower_producer(struct bary_state *s)
          store_dword(b, nir_channel(b, intr->src[0].ssa, i), &s->map[slot][comp]);
       }
 
-      if (slot < 64 && (s->remove & BITFIELD64_BIT(slot)))
-         nir_instr_remove(instr);
+      if (slot < 64 && (s->remove & BITFIELD64_BIT(slot))) {
+         if (s->moved & BITFIELD64_BIT(slot)) {
+            nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+            sem.location = s->move_to[slot];
+            sem.num_slots = 1;
+            nir_intrinsic_set_io_semantics(intr, sem);
+            b->cursor = nir_before_instr(instr);
+            nir_src_rewrite(&intr->src[1], nir_imm_int(b, 0));
+         } else {
+            nir_instr_remove(instr);
+         }
+      }
    }
 
    util_dynarray_fini(&orig);
@@ -499,9 +511,30 @@ tu_nir_lower_producer_barycentric(nir_shader *producer,
 
    bool ok = true;
    if (producer->xfb_info) {
+      nir_shader_gather_info(producer, nir_shader_get_entrypoint(producer));
+      uint64_t free_slots = BITFIELD64_RANGE(VARYING_SLOT_VAR0, 32) &
+                            ~(producer->info.outputs_written | s->remove);
+
       for (unsigned i = 0; i < producer->xfb_info->output_count; i++) {
-         if (s->remove & BITFIELD64_BIT(producer->xfb_info->outputs[i].location))
+         unsigned loc = producer->xfb_info->outputs[i].location;
+         if (loc >= 64 || !(s->remove & BITFIELD64_BIT(loc)) ||
+             (s->moved & BITFIELD64_BIT(loc)))
+            continue;
+         if (!free_slots) {
             ok = false;
+            break;
+         }
+         s->move_to[loc] = util_last_bit64(free_slots) - 1;
+         free_slots &= ~BITFIELD64_BIT(s->move_to[loc]);
+         s->moved |= BITFIELD64_BIT(loc);
+      }
+
+      if (ok) {
+         for (unsigned i = 0; i < producer->xfb_info->output_count; i++) {
+            unsigned loc = producer->xfb_info->outputs[i].location;
+            if (loc < 64 && (s->moved & BITFIELD64_BIT(loc)))
+               producer->xfb_info->outputs[i].location = s->move_to[loc];
+         }
       }
    }
 
