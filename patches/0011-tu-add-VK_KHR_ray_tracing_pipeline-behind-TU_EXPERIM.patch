diff --git a/src/freedreno/ir3/ir3_lower_spill.c b/src/freedreno/ir3/ir3_lower_spill.c
index e3f6b9afeb9..f4bebac844b 100644
--- a/src/freedreno/ir3/ir3_lower_spill.c
+++ b/src/freedreno/ir3/ir3_lower_spill.c
@@ -221,3 +221,92 @@ ir3_lower_spill(struct ir3 *ir)
 
    return true;
 }
+
+/* The per-wave private memory layout can't be used if there is any multi-dword
+ * ldp/stp (see multi_dword_ldp_stp), so these are split into single dwords.
+ * This is done after RA and scheduling so that spills and scratch accesses are
+ * handled the same way and no dependencies have to be split. Legalize
+ * recomputes the sync flags afterwards.
+ */
+static bool
+can_split_ldp_stp(struct ir3_instruction *instr)
+{
+   unsigned components = instr->srcs[2]->uim_val;
+
+   if (components <= 1)
+      return true;
+
+   /* Leave 16-bit accesses alone. */
+   if (type_size(instr->cat6.type) != 32)
+      return false;
+
+   int offset = instr->opc == OPC_LDP ? instr->srcs[1]->iim_val
+                                      : instr->cat6.dst_offset;
+
+   /* The offset is a signed 13-bit immediate. */
+   return offset >= -(int)MAX_CAT6_SIZE &&
+          offset + 4 * ((int)components - 1) < (int)MAX_CAT6_SIZE;
+}
+
+static void
+split_ldp_stp_piece(struct ir3_instruction *instr, unsigned i)
+{
+   if (instr->opc == OPC_LDP) {
+      instr->dsts[0]->num += i;
+      instr->dsts[0]->wrmask = 1;
+      instr->srcs[1]->iim_val += 4 * i;
+   } else {
+      instr->srcs[1]->num += i;
+      instr->srcs[1]->wrmask = 1;
+      instr->cat6.dst_offset += 4 * i;
+   }
+   instr->srcs[2]->uim_val = 1;
+}
+
+/* Returns false without changing anything if some ldp/stp can't be split,
+ * since the shader would be stuck with the per-fiber layout anyway.
+ */
+bool
+ir3_split_ldp_stp(struct ir3 *ir)
+{
+   foreach_block (block, &ir->block_list) {
+      foreach_instr (instr, &block->instr_list) {
+         if ((instr->opc == OPC_LDP || instr->opc == OPC_STP) &&
+             !can_split_ldp_stp(instr))
+            return false;
+      }
+   }
+
+   foreach_block (block, &ir->block_list) {
+      foreach_instr_safe (instr, &block->instr_list) {
+         if (instr->opc != OPC_LDP && instr->opc != OPC_STP)
+            continue;
+
+         unsigned components = instr->srcs[2]->uim_val;
+         if (components <= 1)
+            continue;
+
+         /* The original instruction becomes the last piece. If a destination
+          * overlaps the address register, that piece has to be the last one
+          * as it clobbers the address.
+          */
+         unsigned last = components - 1;
+         struct ir3_register *addr = instr->srcs[0];
+         if (instr->opc == OPC_LDP &&
+             !(addr->flags & (IR3_REG_IMMED | IR3_REG_CONST)) &&
+             addr->num - instr->dsts[0]->num < components)
+            last = addr->num - instr->dsts[0]->num;
+
+         for (unsigned i = 0; i < components; i++) {
+            if (i == last)
+               continue;
+            struct ir3_instruction *clone = ir3_instr_clone(instr);
+            ir3_instr_move_before(clone, instr);
+            split_ldp_stp_piece(clone, i);
+         }
+         split_ldp_stp_piece(instr, last);
+      }
+   }
+
+   return true;
+}
