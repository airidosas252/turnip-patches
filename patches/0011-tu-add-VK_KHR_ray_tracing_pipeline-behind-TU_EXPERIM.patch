new file mode 100644
index 00000000000..68d0b77d1e4
--- /dev/null
+++ b/src/freedreno/vulkan/tu_rt_pipeline.cc
@@ -0,0 +1,1884 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "tu_rt_pipeline.h"
+
+#include "compiler/spirv/spirv.h"
+#include "nir/nir_deref.h"
+#include "nir/nir_serialize.h"
+#include "util/blob.h"
+#include "util/os_time.h"
+#include "util/mesa-blake3.h"
+#include "vk_pipeline.h"
+#include "vk_util.h"
+
+#include "ir3/ir3_compiler.h"
+#include "ir3/ir3_nir.h"
+#include "tu_cmd_buffer.h"
+#include "tu_device.h"
+
+/* The stack of a monolithic pipeline is not tracked, so every shader reports
+ * the same estimate.
+ */
+#define TU_RT_STACK_SIZE_ESTIMATE 1024
+
+/* Monolithic mode: the raygen shaders are the entry points. trace_ray is
+ * lowered to a ray query loop, execute_callable to a call, and the hit, miss
+ * and callable shaders are inlined where they can run, selected by the stage
+ * IDs in the shader binding table records.
+ *
+ * Hit attributes, payloads and callable data are passed in scratch (private
+ * memory) at the offsets given by the explicit layout of the variables.
+ */
+
+/* Where the data that the raygen shader passes to the shaders it calls goes.
+ * What those pass in turn goes after it, and so on.
+ */
+#define TU_RT_SCRATCH_PAYLOAD TU_RT_SCRATCH_STACK
+
+/* The callables that call callables are inlined up to this depth, which gets
+ * lower with the number of callables so that the number of copies of them in
+ * a call chain stays below the second limit.
+ */
+#define TU_RT_MAX_CALLABLE_DEPTH 4
+#define TU_RT_MAX_CALLABLE_COPIES 300
+
+nir_def *
+rt_raygen_record(nir_builder *b)
+{
+   return nir_load_scratch_base_ptr(b, 1, 64, TU_RT_UBO_RAYGEN_SBT);
+}
+
+nir_def *
+rt_sbt_record(nir_builder *b, unsigned region, nir_def *index)
+{
+   nir_def *base = nir_load_scratch_base_ptr(b, 1, 64, region);
+   nir_def *stride = nir_load_scratch_base_ptr(b, 1, 32, region + 2);
+   return nir_iadd(b, base, nir_umul_2x32_64(b, stride, index));
+}
+
+nir_def *
+rt_launch_size(nir_builder *b)
+{
+   nir_def *size[3];
+   for (unsigned i = 0; i < 3; i++)
+      size[i] = nir_load_scratch_base_ptr(b, 1, 32, TU_RT_UBO_LAUNCH_SIZE + i);
+   return nir_vec(b, size, 3);
+}
+
+struct rt_derefs_state {
+   nir_variable_mode mode;
+   unsigned scratch_base;
+};
+
+/* Booleans take 4 bytes in the natural layout. */
+static unsigned
+rt_comp_size(unsigned bit_size)
+{
+   return bit_size == 1 ? 4 : bit_size / 8;
+}
+
+/* Lower the variables of a mode that were given an explicit layout to dwords
+ * in scratch.
+ */
+static bool
+lower_rt_deref(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   const struct rt_derefs_state *state =
+      static_cast<const struct rt_derefs_state *>(data);
+
+   if (intr->intrinsic != nir_intrinsic_load_deref &&
+       intr->intrinsic != nir_intrinsic_store_deref)
+      return false;
+
+   nir_deref_instr *deref = nir_src_as_deref(intr->src[0]);
+   if (!nir_deref_mode_is(deref, state->mode) ||
+       deref->deref_type == nir_deref_type_cast)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   nir_variable *var = nir_deref_instr_get_variable(deref);
+   const unsigned location =
+      state->scratch_base + var->data.driver_location +
+      nir_deref_instr_get_const_offset(deref, glsl_get_natural_size_align_bytes);
+
+   if (intr->intrinsic == nir_intrinsic_load_deref) {
+      const unsigned bit_size = intr->def.bit_size;
+      const unsigned comp_size = rt_comp_size(bit_size);
+      nir_def *comps[NIR_MAX_VEC_COMPONENTS];
+
+      for (unsigned i = 0; i < intr->def.num_components; i++) {
+         const unsigned offset = location + i * comp_size;
+         nir_def *dword = nir_load_scratch(b, 1, 32, nir_imm_int(b, offset & ~3u),
+                                           .align_mul = 4);
+         if (bit_size == 64) {
+            nir_def *hi = nir_load_scratch(b, 1, 32, nir_imm_int(b, offset + 4),
+                                           .align_mul = 4);
+            comps[i] = nir_pack_64_2x32_split(b, dword, hi);
+         } else if (bit_size == 32) {
+            comps[i] = dword;
+         } else if (bit_size == 16) {
+            comps[i] = nir_channel(b, nir_unpack_32_2x16(b, dword), (offset % 4) / 2);
+         } else if (bit_size == 8) {
+            comps[i] = nir_channel(b, nir_unpack_bits(b, dword, 8), offset % 4);
+         } else {
+            comps[i] = nir_i2b(b, dword);
+         }
+      }
+
+      nir_def_replace(&intr->def, nir_vec(b, comps, intr->def.num_components));
+      return true;
+   }
+
+   nir_def *value = intr->src[1].ssa;
+   const unsigned bit_size = value->bit_size;
+   const unsigned comp_size = rt_comp_size(bit_size);
+   for (unsigned i = 0; i < value->num_components; i++) {
+      if (!(nir_intrinsic_write_mask(intr) & BITFIELD_BIT(i)))
+         continue;
+
+      const unsigned offset = location + i * comp_size;
+      nir_def *addr = nir_imm_int(b, offset & ~3u);
+      nir_def *comp = nir_channel(b, value, i);
+      nir_def *dword;
+
+      if (bit_size == 64) {
+         dword = nir_unpack_64_2x32_split_x(b, comp);
+         nir_store_scratch(b, nir_unpack_64_2x32_split_y(b, comp),
+                           nir_imm_int(b, offset + 4), .align_mul = 4,
+                           .write_mask = 1);
+      } else if (bit_size == 32) {
+         dword = comp;
+      } else if (bit_size == 16) {
+         nir_def *prev =
+            nir_unpack_32_2x16(b, nir_load_scratch(b, 1, 32, addr, .align_mul = 4));
+         nir_def *halves[2] = { nir_channel(b, prev, 0), nir_channel(b, prev, 1) };
+         halves[(offset % 4) / 2] = comp;
+         dword = nir_pack_32_2x16(b, nir_vec(b, halves, 2));
+      } else if (bit_size == 8) {
+         nir_def *prev =
+            nir_unpack_bits(b, nir_load_scratch(b, 1, 32, addr, .align_mul = 4), 8);
+         nir_def *bytes[4];
+         for (unsigned j = 0; j < 4; j++)
+            bytes[j] = j == offset % 4 ? comp : nir_channel(b, prev, j);
+         dword = nir_pack_32_4x8(b, nir_vec(b, bytes, 4));
+      } else {
+         dword = nir_b2i32(b, comp);
+      }
+
+      nir_store_scratch(b, dword, addr, .align_mul = 4, .write_mask = 1);
+   }
+
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+void
+lower_rt_vars(nir_shader *nir, nir_variable_mode mode, unsigned scratch_base)
+{
+   struct rt_derefs_state state = { mode, scratch_base };
+
+   nir_lower_indirect_derefs_to_if_else_trees(nir, mode, UINT32_MAX);
+   nir_shader_intrinsics_pass(nir, lower_rt_deref, nir_metadata_control_flow,
+                              &state);
+   nir_remove_dead_derefs(nir);
+   nir_remove_dead_variables(nir, mode, NULL);
+}
+
+nir_def *
+rt_rq_load(nir_builder *b, const struct rt_raygen *rg, unsigned num_components,
+           unsigned bit_size, nir_ray_query_value value, bool committed,
+           unsigned column)
+{
+   nir_deref_instr *rq = nir_build_deref_var(b, rg->rq);
+   return nir_rq_load(b, num_components, bit_size, &rq->def,
+                      .ray_query_value = value, .committed = committed,
+                      .column = column);
+}
+
+/* Lower the builtins of the raygen shader and of the shaders inlined in it. */
+bool
+lower_rt_builtin(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   const struct rt_builtins *state = static_cast<const struct rt_builtins *>(data);
+   const struct rt_raygen *rg = state->rg;
+   const bool committed = state->committed;
+   nir_def *def;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   if (state->exported) {
+      switch (intr->intrinsic) {
+      case nir_intrinsic_load_ray_t_max:
+      case nir_intrinsic_load_ray_instance_custom_index:
+      case nir_intrinsic_load_instance_id:
+      case nir_intrinsic_load_primitive_id:
+      case nir_intrinsic_load_ray_geometry_index:
+      case nir_intrinsic_load_ray_object_origin:
+      case nir_intrinsic_load_ray_object_direction:
+      case nir_intrinsic_load_ray_object_to_world:
+      case nir_intrinsic_load_ray_world_to_object:
+         return false;
+      default:
+         break;
+      }
+   }
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_ray_launch_id:
+      if (rg->aqe)
+         return false;
+      def = nir_load_global_invocation_id(b, 32);
+      break;
+   case nir_intrinsic_load_ray_launch_size:
+      def = rt_launch_size(b);
+      break;
+   case nir_intrinsic_load_shader_record_ptr:
+      /* The shader record buffer is a mem_constant cast of this pointer. */
+      nir_foreach_use (use, &intr->def) {
+         nir_instr *parent = nir_src_use_instr(use);
+         if (parent->type == nir_instr_type_deref)
+            nir_instr_as_deref(parent)->modes = nir_var_mem_global;
+      }
+      def = nir_load_var(b, rg->record);
+      break;
+   case nir_intrinsic_load_cull_mask:
+      def = nir_load_var(b, rg->cull_mask);
+      break;
+   case nir_intrinsic_load_ray_world_origin:
+      def = state->exported ? nir_load_var(b, rg->origin) :
+            rt_rq_load(b, rg, 3, 32, nir_ray_query_value_world_ray_origin, false);
+      break;
+   case nir_intrinsic_load_ray_world_direction:
+      def = state->exported ? nir_load_var(b, rg->direction) :
+            rt_rq_load(b, rg, 3, 32, nir_ray_query_value_world_ray_direction, false);
+      break;
+   case nir_intrinsic_load_ray_t_min:
+      def = state->exported ? nir_load_var(b, rg->tmin) :
+            rt_rq_load(b, rg, 1, 32, nir_ray_query_value_tmin, false);
+      break;
+   case nir_intrinsic_load_ray_t_max:
+      /* The committed t starts as the tmax of the ray, so it is right for
+       * the miss shader too.
+       */
+      def = state->tmax_committed ?
+            rt_rq_load(b, rg, 1, 32, nir_ray_query_value_intersection_t, true) :
+            nir_load_var(b, rg->candidate_t);
+      break;
+   case nir_intrinsic_load_ray_flags:
+      def = nir_load_var(b, rg->ray_flags);
+      break;
+   case nir_intrinsic_load_ray_hit_kind:
+      def = nir_load_var(b, committed ? rg->committed_hit_kind :
+                                        rg->candidate_hit_kind);
+      break;
+   case nir_intrinsic_load_ray_instance_custom_index:
+      def = rt_rq_load(b, rg, 1, 32,
+                       nir_ray_query_value_intersection_instance_custom_index,
+                       committed);
+      break;
+   case nir_intrinsic_load_instance_id:
+      def = rt_rq_load(b, rg, 1, 32, nir_ray_query_value_intersection_instance_id,
+                       committed);
+      break;
+   case nir_intrinsic_load_primitive_id:
+      def = rt_rq_load(b, rg, 1, 32,
+                       nir_ray_query_value_intersection_primitive_index, committed);
+      break;
+   case nir_intrinsic_load_ray_geometry_index:
+      def = rt_rq_load(b, rg, 1, 32,
+                       nir_ray_query_value_intersection_geometry_index, committed);
+      break;
+   case nir_intrinsic_load_ray_object_origin:
+      def = rt_rq_load(b, rg, 3, 32,
+                       nir_ray_query_value_intersection_object_ray_origin, committed);
+      break;
+   case nir_intrinsic_load_ray_object_direction:
+      def = rt_rq_load(b, rg, 3, 32,
+                       nir_ray_query_value_intersection_object_ray_direction,
+                       committed);
+      break;
+   case nir_intrinsic_load_ray_object_to_world:
+      def = rt_rq_load(b, rg, 3, 32,
+                       nir_ray_query_value_intersection_object_to_world, committed,
+                       nir_intrinsic_column(intr));
+      break;
+   case nir_intrinsic_load_ray_world_to_object:
+      def = rt_rq_load(b, rg, 3, 32,
+                       nir_ray_query_value_intersection_world_to_object, committed,
+                       nir_intrinsic_column(intr));
+      break;
+   default:
+      return false;
+   }
+
+   nir_def_replace(&intr->def, def);
+   return true;
+}
+
+nir_variable *
+rt_var(nir_shader *nir, const glsl_type *type, const char *name)
+{
+   return nir_variable_create(nir, nir_var_shader_temp, type, name);
+}
+
+void
+rt_vars_create(struct rt_raygen *rg, nir_shader *nir)
+{
+   const glsl_type *vec3 = glsl_vector_type(GLSL_TYPE_FLOAT, 3);
+
+   rg->rq = rt_var(nir, glsl_uint64_t_type(), "rq");
+   rg->rq->data.ray_query = true;
+   rg->record = rt_var(nir, glsl_uint64_t_type(), "record");
+   rg->cull_mask = rt_var(nir, glsl_uint_type(), "cull_mask");
+   rg->ray_flags = rt_var(nir, glsl_uint_type(), "ray_flags");
+   rg->candidate_t = rt_var(nir, glsl_uint_type(), "candidate_t");
+   rg->candidate_hit_kind = rt_var(nir, glsl_uint_type(), "candidate_hit_kind");
+   rg->committed_hit_kind = rt_var(nir, glsl_uint_type(), "committed_hit_kind");
+   rg->accept = rt_var(nir, glsl_uint_type(), "accept");
+   rg->terminate = rt_var(nir, glsl_uint_type(), "terminate");
+
+   /* The scheduler of the separate mode. */
+   rg->next = rt_var(nir, glsl_uint_type(), "next");
+   rg->sp = rt_var(nir, glsl_uint_type(), "sp");
+   rg->incoming = rt_var(nir, glsl_uint_type(), "incoming");
+   rg->accel_struct = rt_var(nir, glsl_uint64_t_type(), "accel_struct");
+   rg->sbt_offset = rt_var(nir, glsl_uint_type(), "sbt_offset");
+   rg->sbt_stride = rt_var(nir, glsl_uint_type(), "sbt_stride");
+   rg->miss_index = rt_var(nir, glsl_uint_type(), "miss_index");
+   rg->origin = rt_var(nir, vec3, "origin");
+   rg->tmin = rt_var(nir, glsl_float_type(), "tmin");
+   rg->direction = rt_var(nir, vec3, "direction");
+   rg->tmax = rt_var(nir, glsl_float_type(), "tmax");
+}
+
+struct hash_table *
+rt_remap_create(const struct rt_raygen *from, const struct rt_raygen *to)
+{
+   struct hash_table *remap = _mesa_pointer_hash_table_create(NULL);
+
+#define X(name) _mesa_hash_table_insert(remap, from->name, to->name);
+   RT_VARS(X)
+#undef X
+
+   return remap;
+}
+
+nir_def *
+rt_record_id(nir_builder *b, nir_def *record, unsigned index)
+{
+   return nir_load_global(b, 1, 64, nir_iadd_imm(b, record, index * 8),
+                          .align_mul = 8);
+}
+
+/* The hit group record of the candidate or committed hit. */
+static nir_def *
+rt_hit_record(nir_builder *b, const struct rt_raygen *rg, bool committed,
+              nir_def *sbt_offset, nir_def *sbt_stride)
+{
+   nir_def *index = nir_iadd(
+      b, nir_iadd(b, rt_rq_load(b, rg, 1, 32,
+                                nir_ray_query_value_intersection_instance_sbt_index,
+                                committed),
+                  sbt_offset),
+      nir_imul(b, rt_rq_load(b, rg, 1, 32,
+                             nir_ray_query_value_intersection_geometry_index,
+                             committed),
+               sbt_stride));
+   return rt_sbt_record(b, TU_RT_UBO_HIT_SBT, index);
+}
+
+static void
+rt_store_hit_attribs(nir_builder *b, unsigned scratch_base, nir_def *bary)
+{
+   for (unsigned i = 0; i < 2; i++) {
+      nir_store_scratch(b, nir_channel(b, bary, i),
+                        nir_imm_int(b, scratch_base + i * 4), .align_mul = 4,
+                        .write_mask = 1);
+   }
+}
+
+static nir_def *
+rt_triangle_hit_kind(nir_builder *b, const struct rt_raygen *rg, bool committed)
+{
+   return nir_bcsel(b, rt_rq_load(b, rg, 1, 1,
+                                  nir_ray_query_value_intersection_front_face,
+                                  committed),
+                    nir_imm_int(b, 0xFE), nir_imm_int(b, 0xFF));
+}
+
+static void
+rt_lower_stage(const struct rt_raygen *rg, nir_shader *nir,
+               mesa_shader_stage stage, const struct rt_call *call);
+
+/* reportIntersectionEXT(): check t, run the any hit shader of the group if
+ * the geometry is not opaque, and commit the hit if it is accepted.
+ */
+void
+lower_report_intersection(const struct rt_raygen *rg, nir_function_impl *impl,
+                          nir_intrinsic_instr *report,
+                          const struct rt_call *callee)
+{
+   nir_builder b = nir_builder_at(nir_before_instr(&report->instr));
+   nir_def *t = report->src[0].ssa;
+   nir_def *kind = report->src[1].ssa;
+   nir_variable *reported =
+      nir_local_variable_create(impl, glsl_uint_type(), "reported");
+
+   nir_store_var(&b, reported, nir_imm_int(&b, 0), 1);
+
+   nir_def *in_range = nir_iand(
+      &b, nir_fge(&b, t, rt_rq_load(&b, rg, 1, 32, nir_ray_query_value_tmin, false)),
+      nir_fge(&b, rt_rq_load(&b, rg, 1, 32, nir_ray_query_value_intersection_t, true), t));
+   nir_push_if(&b, nir_iand(&b, in_range,
+                            nir_ieq_imm(&b, nir_load_var(&b, rg->terminate), 0)));
+   {
+      nir_store_var(&b, rg->candidate_t, t, 1);
+      nir_store_var(&b, rg->candidate_hit_kind, kind, 1);
+      nir_store_var(&b, rg->accept, nir_imm_int(&b, 1), 1);
+
+      if (rg->link->has_any_hit) {
+         nir_def *record = nir_iadd_imm(&b, nir_load_var(&b, rg->record), -32);
+         nir_push_if(&b, nir_inot(&b, rt_rq_load(&b, rg, 1, 1,
+                                                 nir_ray_query_value_intersection_candidate_aabb_opaque,
+                                                 false)));
+         rg->inline_stages(rg, &b, MESA_SHADER_ANY_HIT, record,
+                           rt_record_id(&b, record, 2), callee);
+         nir_pop_if(&b, NULL);
+      }
+
+      nir_push_if(&b, nir_ine_imm(&b, nir_load_var(&b, rg->accept), 0));
+      {
+         for (unsigned i = 0; i < 8; i++) {
+            nir_store_scratch(
+               &b, nir_load_scratch(&b, 1, 32,
+                                    nir_imm_int(&b, TU_RT_SCRATCH_HIT_ATTRIB_CAND + i * 4),
+                                    .align_mul = 4),
+               nir_imm_int(&b, TU_RT_SCRATCH_HIT_ATTRIB_COMMITTED + i * 4),
+               .align_mul = 4, .write_mask = 1);
+         }
+         nir_store_var(&b, rg->committed_hit_kind, kind, 1);
+
+         nir_deref_instr *rq = nir_build_deref_var(&b, rg->rq);
+         nir_rq_generate_intersection(&b, &rq->def, t);
+         nir_store_var(&b, reported, nir_imm_int(&b, 1), 1);
+
+         /* The traversal ends with the first hit, so does the shader. */
+         nir_push_if(&b, nir_test_mask(&b, nir_load_var(&b, rg->ray_flags),
+                                       SpvRayFlagsTerminateOnFirstHitKHRMask));
+         nir_store_var(&b, rg->terminate, nir_imm_int(&b, 1), 1);
+         nir_pop_if(&b, NULL);
+      }
+      nir_pop_if(&b, NULL);
+   }
+   nir_pop_if(&b, NULL);
+
+   nir_def_replace(&report->def, nir_ine_imm(&b, nir_load_var(&b, reported), 0));
+
+   /* terminateRayEXT in the any hit shader ends the intersection shader. */
+   nir_push_if(&b, nir_ine_imm(&b, nir_load_var(&b, rg->terminate), 0));
+   nir_jump(&b, nir_jump_return);
+   nir_pop_if(&b, NULL);
+}
+
+/* Get a stage ready to be inlined with the data that it is called with. */
+static nir_shader *
+rt_prepare_stage(const struct rt_raygen *rg, unsigned index,
+                 const struct rt_call *call)
+{
+   const struct rt_link *link = rg->link;
+   nir_shader *nir = nir_shader_clone(link->mem_ctx, link->nir[index]);
+
+   rt_lower_stage(rg, nir, link->stages[index].stage, call);
+   return nir;
+}
+
+static void
+rt_inline_stage(const struct rt_raygen *rg, nir_builder *b, unsigned index,
+                nir_def *id, const struct rt_call *callee)
+{
+   nir_shader *nir = rt_prepare_stage(rg, index, callee);
+   struct hash_table *remap = rt_remap_create(rg, rg);
+
+   nir_push_if(b, nir_ieq_imm(b, id, rg->link->stages[index].id));
+   nir_inline_function_impl(b, nir_shader_get_entrypoint(nir), NULL, remap);
+   nir_pop_if(b, NULL);
+
+   _mesa_hash_table_destroy(remap, NULL);
+}
+
+/* Run the stages of the type `stage` that the id from the shader binding
+ * table record selects, with the shader record of `record`.
+ */
+static void
+rt_inline_stages(const struct rt_raygen *rg, nir_builder *b,
+                 mesa_shader_stage stage, nir_def *record, nir_def *id,
+                 const struct rt_call *callee)
+{
+   nir_def *prev_record = nir_load_var(b, rg->record);
+   nir_store_var(b, rg->record, nir_iadd_imm(b, record, 32), 1);
+
+   for (unsigned i = 0; i < rg->link->count; i++) {
+      if (rg->link->stages[i].stage == stage && !rg->link->duplicate[i])
+         rt_inline_stage(rg, b, i, id, callee);
+   }
+
+   nir_store_var(b, rg->record, prev_record, 1);
+}
+
+void
+rt_build_trace(const struct rt_raygen *rg, nir_builder *b,
+               const struct rt_ray *ray, const struct rt_call *callee)
+{
+   /* The skip flags of the pipeline apply to every ray. */
+   unsigned pipeline_flags = 0;
+   if (rg->link->flags & VK_PIPELINE_CREATE_2_RAY_TRACING_SKIP_TRIANGLES_BIT_KHR)
+      pipeline_flags |= SpvRayFlagsSkipTrianglesKHRMask;
+   if (rg->link->flags & VK_PIPELINE_CREATE_2_RAY_TRACING_SKIP_AABBS_BIT_KHR)
+      pipeline_flags |= SpvRayFlagsSkipAABBsKHRMask;
+
+   nir_def *flags = ray->flags;
+   nir_def *sbt_offset = ray->sbt_offset;
+   nir_def *sbt_stride = ray->sbt_stride;
+
+   nir_deref_instr *rq = nir_build_deref_var(b, rg->rq);
+   nir_rq_initialize(b, &rq->def, ray->accel_struct,
+                     nir_ior_imm(b, flags, pipeline_flags), ray->cull_mask,
+                     ray->origin, ray->tmin, ray->direction, ray->tmax);
+   nir_store_var(b, rg->cull_mask, ray->cull_mask, 1);
+   nir_store_var(b, rg->ray_flags, flags, 1);
+   nir_store_var(b, rg->terminate, nir_imm_int(b, 0), 1);
+
+   /* The candidates are the hits that the traversal could not decide about:
+    * triangles that are not opaque, and all the AABBs.
+    */
+   nir_loop *loop = nir_push_loop(b);
+   {
+      nir_break_if(b, nir_inot(b, nir_rq_proceed(b, 1, &rq->def)));
+      nir_push_if(b, nir_ieq_imm(b, rt_rq_load(b, rg, 1, 32,
+                                               nir_ray_query_value_intersection_type,
+                                               false), 0));
+      {
+         if (rg->link->has_any_hit) {
+            nir_def *record = rt_hit_record(b, rg, false, sbt_offset, sbt_stride);
+
+            rt_store_hit_attribs(b, TU_RT_SCRATCH_HIT_ATTRIB_CAND,
+                                 rt_rq_load(b, rg, 2, 32,
+                                            nir_ray_query_value_intersection_barycentrics,
+                                            false));
+            nir_store_var(b, rg->candidate_hit_kind,
+                          rt_triangle_hit_kind(b, rg, false), 1);
+            nir_store_var(b, rg->candidate_t,
+                          rt_rq_load(b, rg, 1, 32, nir_ray_query_value_intersection_t,
+                                     false), 1);
+            nir_store_var(b, rg->accept, nir_imm_int(b, 1), 1);
+            rg->inline_stages(rg, b, MESA_SHADER_ANY_HIT, record,
+                              rt_record_id(b, record, 2), callee);
+         }
+
+         nir_push_if(b, rg->link->has_any_hit ?
+                        nir_ine_imm(b, nir_load_var(b, rg->accept), 0) :
+                        nir_imm_true(b));
+         nir_rq_confirm_intersection(b, &rq->def);
+         nir_pop_if(b, NULL);
+      }
+      nir_push_else(b, NULL);
+      {
+         if (rg->link->has_intersection) {
+            nir_def *record = rt_hit_record(b, rg, false, sbt_offset, sbt_stride);
+            rg->inline_stages(rg, b, MESA_SHADER_INTERSECTION, record,
+                              rt_record_id(b, record, 3), callee);
+         }
+      }
+      nir_pop_if(b, NULL);
+
+      if (rg->link->has_any_hit || rg->link->has_intersection) {
+         nir_push_if(b, nir_ine_imm(b, nir_load_var(b, rg->terminate), 0));
+         nir_rq_terminate(b, &rq->def);
+         nir_pop_if(b, NULL);
+      }
+   }
+   nir_pop_loop(b, loop);
+
+   nir_def *type = rt_rq_load(b, rg, 1, 32, nir_ray_query_value_intersection_type,
+                              true);
+   nir_push_if(b, nir_ine_imm(b, type, 0));
+   {
+      nir_push_if(b, nir_inot(b, nir_test_mask(b, flags,
+                                               SpvRayFlagsSkipClosestHitShaderKHRMask)));
+      nir_def *record = rt_hit_record(b, rg, true, sbt_offset, sbt_stride);
+
+      /* The hit attributes of a committed AABB were stored when it was
+       * accepted, a triangle has its barycentrics.
+       */
+      nir_push_if(b, nir_ieq_imm(b, type, 1));
+      {
+         rt_store_hit_attribs(b, TU_RT_SCRATCH_HIT_ATTRIB_COMMITTED,
+                              rt_rq_load(b, rg, 2, 32,
+                                         nir_ray_query_value_intersection_barycentrics,
+                                         true));
+         nir_store_var(b, rg->committed_hit_kind,
+                       rt_triangle_hit_kind(b, rg, true), 1);
+      }
+      nir_pop_if(b, NULL);
+
+      rg->inline_stages(rg, b, MESA_SHADER_CLOSEST_HIT, record,
+                        rt_record_id(b, record, 1), callee);
+      nir_pop_if(b, NULL);
+   }
+   nir_push_else(b, NULL);
+   {
+      nir_def *record = rt_sbt_record(b, TU_RT_UBO_MISS_SBT, ray->miss_index);
+
+      rg->inline_stages(rg, b, MESA_SHADER_MISS, record,
+                        rt_record_id(b, record, 0), callee);
+   }
+   nir_pop_if(b, NULL);
+}
+
+static void
+lower_trace_ray(const struct rt_raygen *rg, nir_builder *b,
+                nir_intrinsic_instr *trace, const struct rt_call *callee)
+{
+   b->cursor = nir_before_instr(&trace->instr);
+
+   const struct rt_ray ray = {
+      .accel_struct = trace->src[0].ssa,
+      .flags = nir_iand_imm(b, trace->src[1].ssa, 0xfff),
+      .cull_mask = nir_iand_imm(b, trace->src[2].ssa, 0xff),
+      .sbt_offset = nir_iand_imm(b, trace->src[3].ssa, 0xf),
+      .sbt_stride = nir_iand_imm(b, trace->src[4].ssa, 0xf),
+      .miss_index = nir_iand_imm(b, trace->src[5].ssa, 0xffff),
+      .origin = trace->src[6].ssa,
+      .tmin = trace->src[7].ssa,
+      .direction = trace->src[8].ssa,
+      .tmax = trace->src[9].ssa,
+   };
+
+   rt_build_trace(rg, b, &ray, callee);
+   nir_instr_remove(&trace->instr);
+}
+
+static void
+lower_execute_callable(const struct rt_raygen *rg, nir_intrinsic_instr *call,
+                       const struct rt_call *callee)
+{
+   nir_builder b = nir_builder_at(nir_before_instr(&call->instr));
+   nir_def *record = rt_sbt_record(&b, TU_RT_UBO_CALLABLE_SBT, call->src[0].ssa);
+
+   rt_inline_stages(rg, &b, MESA_SHADER_CALLABLE, record,
+                    rt_record_id(&b, record, 0), callee);
+   nir_instr_remove(&call->instr);
+}
+
+bool
+rt_lower_hit_exit(const struct rt_raygen *rg, nir_builder *b, nir_instr *instr)
+{
+   if (instr->type == nir_instr_type_jump) {
+      /* ignoreIntersectionEXT and terminateRayEXT end the shader. */
+      if (nir_instr_as_jump(instr)->type != nir_jump_halt)
+         return false;
+      nir_instr_as_jump(instr)->type = nir_jump_return;
+      return true;
+   }
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+
+   nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+   b->cursor = nir_before_instr(instr);
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_ignore_ray_intersection:
+      nir_store_var(b, rg->accept, nir_imm_int(b, 0), 1);
+      break;
+   case nir_intrinsic_terminate_ray:
+      nir_store_var(b, rg->accept, nir_imm_int(b, 1), 1);
+      nir_store_var(b, rg->terminate, nir_imm_int(b, 1), 1);
+      break;
+   default:
+      return false;
+   }
+
+   nir_instr_remove(instr);
+   return true;
+}
+
+/* The variable that a trace_ray or execute_callable passes. */
+nir_variable *
+rt_call_data(nir_intrinsic_instr *intr)
+{
+   const unsigned src = intr->intrinsic == nir_intrinsic_trace_ray ? 10 : 1;
+   return nir_deref_instr_get_variable(nir_src_as_deref(intr->src[src]));
+}
+
+/* Lower a stage that is called with `call`: the shaders that it calls are
+ * inlined in it, and what it shares with them is moved to scratch.
+ */
+static void
+rt_lower_stage(const struct rt_raygen *rg, nir_shader *nir,
+               mesa_shader_stage stage, const struct rt_call *call)
+{
+   const struct rt_link *link = rg->link;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_builder b = nir_builder_create(impl);
+
+   nir_intrinsic_instr **calls = rzalloc_array(link->mem_ctx, nir_intrinsic_instr *, 0);
+   unsigned num_calls = 0;
+   bool ignored_trace = false, ignored_callable = false;
+
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr_safe (instr, block) {
+         if (rt_lower_hit_exit(rg, &b, instr) || instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         b.cursor = nir_before_instr(instr);
+
+         switch (intr->intrinsic) {
+         case nir_intrinsic_trace_ray:
+         case nir_intrinsic_execute_callable:
+         case nir_intrinsic_report_ray_intersection: {
+            /* maxRayRecursionDepth is 1, so only the shaders that are not
+             * called by a hit or a miss can trace.
+             */
+            const bool trace = intr->intrinsic == nir_intrinsic_trace_ray;
+            const bool callable = intr->intrinsic == nir_intrinsic_execute_callable;
+            if ((trace && !call->trace) ||
+                (callable && (!link->num_callables ||
+                              call->depth >= link->max_callable_depth))) {
+               ignored_trace |= trace;
+               ignored_callable |= callable && link->num_callables;
+               nir_instr_remove(instr);
+               break;
+            }
+            calls = reralloc(link->mem_ctx, calls, nir_intrinsic_instr *,
+                             num_calls + 1);
+            calls[num_calls++] = intr;
+            break;
+         }
+         default:
+            break;
+         }
+      }
+   }
+   if (ignored_trace) {
+      mesa_logw_once("rt_pipeline: trace_ray in closest hit, miss, any hit and "
+                     "intersection shaders is ignored");
+   }
+   if (ignored_callable) {
+      mesa_logw_once("rt_pipeline: callables nested too deep are ignored");
+   }
+
+   /* The data that the shader passes to other shaders is private to it, the
+    * data that it is called with is not.
+    */
+   for (unsigned i = 0; i < num_calls; i++) {
+      if (calls[i]->intrinsic == nir_intrinsic_report_ray_intersection)
+         continue;
+
+      nir_variable *data = rt_call_data(calls[i]);
+      if (data->data.mode != nir_var_shader_call_data_in) {
+         exec_node_remove(&data->node);
+         data->data.mode = nir_var_shader_call_data_in;
+         data->data.index = 1;
+         nir_shader_add_variable(nir, data);
+      }
+   }
+   nir_fixup_deref_modes(nir);
+
+   nir_lower_vars_to_explicit_types(nir, nir_var_shader_call_data_in,
+                                    glsl_get_natural_size_align_bytes);
+
+   unsigned extent = 0;
+   nir_foreach_variable_with_modes (var, nir, nir_var_shader_call_data_in) {
+      if (var->data.index) {
+         unsigned size, align;
+         glsl_get_natural_size_align_bytes(var->type, &size, &align);
+         extent = MAX2(extent, var->data.driver_location + size);
+         var->data.driver_location += call->frame;
+         var->data.index = 0;
+      } else {
+         var->data.driver_location = call->offset;
+      }
+   }
+
+   /* The shaders that this one calls put their data after its own. */
+   struct rt_call callee = {
+      .frame = ALIGN_POT(call->frame + extent, 16),
+      .depth = call->depth,
+   };
+   *rg->scratch_size = MAX2(*rg->scratch_size, callee.frame);
+
+   for (unsigned i = 0; i < num_calls; i++) {
+      switch (calls[i]->intrinsic) {
+      case nir_intrinsic_trace_ray:
+         callee.offset = rt_call_data(calls[i])->data.driver_location;
+         callee.trace = false;
+         b.cursor = nir_before_instr(&calls[i]->instr);
+         lower_trace_ray(rg, &b, calls[i], &callee);
+         break;
+      case nir_intrinsic_execute_callable:
+         callee.offset = rt_call_data(calls[i])->data.driver_location;
+         callee.depth = call->depth + 1;
+         callee.trace = call->trace;
+         lower_execute_callable(rg, calls[i], &callee);
+         callee.depth = call->depth;
+         break;
+      default:
+         callee.offset = call->offset;
+         callee.trace = false;
+         lower_report_intersection(rg, impl, calls[i], &callee);
+         break;
+      }
+   }
+
+   struct rt_builtins builtins = {
+      .rg = rg,
+      .committed = stage != MESA_SHADER_ANY_HIT && stage != MESA_SHADER_INTERSECTION,
+      .tmax_committed = stage != MESA_SHADER_ANY_HIT,
+   };
+   nir_index_ssa_defs(impl);
+   nir_shader_intrinsics_pass(nir, lower_rt_builtin, nir_metadata_none, &builtins);
+
+   nir_lower_vars_to_explicit_types(nir, nir_var_ray_hit_attrib,
+                                    glsl_get_natural_size_align_bytes);
+   lower_rt_vars(nir, nir_var_shader_call_data_in, 0);
+   lower_rt_vars(nir, nir_var_ray_hit_attrib,
+                 stage == MESA_SHADER_CLOSEST_HIT ?
+                 TU_RT_SCRATCH_HIT_ATTRIB_COMMITTED : TU_RT_SCRATCH_HIT_ATTRIB_CAND);
+   nir_fixup_deref_modes(nir);
+   nir_lower_returns(nir);
+}
+
+/* Get the raygen shader with the shaders it calls inlined. */
+static nir_shader *
+rt_build_raygen(const struct rt_link *link, unsigned index, unsigned *scratch_size)
+{
+   nir_shader *nir = nir_shader_clone(link->mem_ctx, link->nir[index]);
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   struct rt_raygen rg = {
+      .link = link,
+      .scratch_size = scratch_size,
+      .inline_stages = rt_inline_stages,
+   };
+   rt_vars_create(&rg, nir);
+
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_store_var(&b, rg.record, nir_iadd_imm(&b, rt_raygen_record(&b), 32), 1);
+
+   const struct rt_call call = { .frame = TU_RT_SCRATCH_PAYLOAD, .trace = true };
+   rt_lower_stage(&rg, nir, MESA_SHADER_RAYGEN, &call);
+
+   nir_index_ssa_defs(impl);
+   nir->scratch_size = *scratch_size;
+   return nir;
+}
+
+static nir_shader *
+rt_build_main(const struct rt_link *link, const unsigned *raygens,
+              unsigned num_raygens)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, link->nir[raygens[0]]->options, "rt");
+   nir_shader *nir = b.shader;
+
+   nir->info.workgroup_size[0] = TU_RT_WORKGROUP_SIZE;
+   nir->info.workgroup_size[1] = TU_RT_WORKGROUP_SIZE;
+   nir->info.workgroup_size[2] = 1;
+   nir->info.float_controls_execution_mode = link->float_controls;
+
+   /* The launch is rounded up to whole workgroups. */
+   nir_push_if(&b, nir_ball(&b, nir_ult(&b, nir_load_global_invocation_id(&b, 32),
+                                        rt_launch_size(&b))));
+   {
+      nir_def *id = NULL;
+      if (num_raygens > 1)
+         id = rt_record_id(&b, rt_raygen_record(&b), 0);
+
+      for (unsigned i = 0; i < num_raygens; i++) {
+         unsigned scratch_size = TU_RT_SCRATCH_PAYLOAD;
+         nir_shader *raygen = rt_build_raygen(link, raygens[i], &scratch_size);
+
+         struct hash_table *remap = _mesa_pointer_hash_table_create(NULL);
+         nir_if *nif = NULL;
+         if (id)
+            nif = nir_push_if(&b, nir_ieq_imm(&b, id, link->stages[raygens[i]].id));
+         nir_inline_function_impl(&b, nir_shader_get_entrypoint(raygen), NULL, remap);
+         if (nif)
+            nir_pop_if(&b, nif);
+         _mesa_hash_table_destroy(remap, NULL);
+
+         nir->scratch_size = MAX2(nir->scratch_size, raygen->scratch_size);
+      }
+   }
+   nir_pop_if(&b, NULL);
+
+   nir_index_ssa_defs(b.impl);
+   return nir;
+}
+
+/* The float controls of the stages for the one shader: what they ask for
+ * together. The stages that ask for different handling of the same size get
+ * the one that keeps more of the value: denorm preserve, round to nearest even.
+ *
+ * The code generator only reads the rounding mode (of conversions), which is
+ * not worth lowering per stage because round to zero isn't exposed, and the
+ * stages that preserve 32-bit denorms are already lowered to soft float when
+ * they are compiled.
+ */
+static unsigned
+rt_merge_float_controls(const struct rt_link *link)
+{
+   unsigned mode = 0;
+
+   for (unsigned i = 0; i < link->count; i++) {
+      if (!link->duplicate[i])
+         mode |= link->nir[i]->info.float_controls_execution_mode;
+   }
+
+   /* Flush to zero is 3 bits after preserve, round to zero 3 after to even. */
+   const unsigned clash = mode & (mode >> 3) & (0x7 | (0x7 << 6));
+   if (clash) {
+      mesa_logw_once("rt_pipeline: the stages ask for different denorm or "
+                     "rounding modes, they get denorm preserve and round to "
+                     "nearest even");
+      mode &= ~(clash << 3);
+   }
+
+   return mode;
+}
+
+static unsigned
+rt_instr_count(nir_shader *nir)
+{
+   unsigned count = 0;
+   nir_foreach_function_impl (impl, nir) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block)
+            count++;
+      }
+   }
+   return count;
+}
+
+static bool
+rt_has_dynamic_stack_size(const VkRayTracingPipelineCreateInfoKHR *info)
+{
+   for (unsigned i = 0; info->pDynamicState && i < info->pDynamicState->dynamicStateCount; i++) {
+      if (info->pDynamicState->pDynamicStates[i] ==
+          VK_DYNAMIC_STATE_RAY_TRACING_PIPELINE_STACK_SIZE_KHR)
+         return true;
+   }
+   return false;
+}
+
+/* The default stack of a pipeline is a ray and the shaders that handle it, and
+ * a number of nested callables. The application sets a size for callables that
+ * nest deeper than the default of the spec through the dynamic state, and
+ * pipelines that allow it get room for more.
+ */
+#define TU_RT_CALLABLE_NESTING 2
+#define TU_RT_CALLABLE_NESTING_DYNAMIC 8
+
+static void
+rt_compute_stack(struct tu_rt_pipeline *pipeline,
+                 const VkRayTracingPipelineCreateInfoKHR *info)
+{
+   uint32_t raygen = 0, chit = 0, miss = 0, callable = 0, isect = 0, ahit = 0;
+
+   for (unsigned i = 0; i < pipeline->stage_count; i++) {
+      uint32_t *max;
+      switch (pipeline->stages[i].stage) {
+      case MESA_SHADER_RAYGEN: max = &raygen; break;
+      case MESA_SHADER_CLOSEST_HIT: max = &chit; break;
+      case MESA_SHADER_MISS: max = &miss; break;
+      case MESA_SHADER_CALLABLE: max = &callable; break;
+      case MESA_SHADER_INTERSECTION: max = &isect; break;
+      default: max = &ahit; break;
+      }
+      *max = MAX2(*max, pipeline->stages[i].stack);
+   }
+
+   /* maxRayRecursionDepth is 1. */
+   const uint32_t hit = MAX3(chit, miss, isect + ahit);
+   pipeline->stack_dynamic = rt_has_dynamic_stack_size(info);
+   const uint32_t nesting = pipeline->stack_dynamic ?
+      TU_RT_CALLABLE_NESTING_DYNAMIC : TU_RT_CALLABLE_NESTING;
+   pipeline->stack_default =
+      ALIGN_POT(raygen + hit + nesting * callable, 16);
+}
+
+/* The monolithic mode inlines the shaders that a call can run at every call
+ * site, so what it costs is the sites times the shaders. It is only used for
+ * small pipelines, otherwise the separate mode, where the shaders are there
+ * once. The estimate has the number of trace_ray sites in the raygen shaders and
+ * the callables, report sites, and callable sites. Callables that call
+ * callables are also left to the separate mode, whose stack takes them to any
+ * depth.
+ */
+#define TU_RT_MONOLITHIC_MAX_STAGES 16
+#define TU_RT_MONOLITHIC_MAX_HIT_SHADERS 8
+#define TU_RT_MONOLITHIC_MAX_COST 64
+
+static bool
+rt_is_small(const struct rt_link *link, unsigned *cost_out)
+{
+   unsigned count[MESA_ALL_SHADER_STAGES] = {};
+   unsigned stages = 0, trace_sites = 0, report_sites = 0, callable_sites = 0;
+   bool callable_calls_callable = false;
+
+   for (unsigned i = 0; i < link->count; i++) {
+      if (link->duplicate[i])
+         continue;
+
+      const mesa_shader_stage stage = link->stages[i].stage;
+      count[stage]++;
+      stages++;
+
+      nir_foreach_block (block, nir_shader_get_entrypoint(link->nir[i])) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+            case nir_intrinsic_trace_ray:
+               trace_sites += stage == MESA_SHADER_RAYGEN;
+               break;
+            case nir_intrinsic_report_ray_intersection:
+               report_sites++;
+               break;
+            case nir_intrinsic_execute_callable:
+               callable_sites++;
+               callable_calls_callable |= stage == MESA_SHADER_CALLABLE;
+               break;
+            default:
+               break;
+            }
+         }
+      }
+   }
+
+   *cost_out = trace_sites * (count[MESA_SHADER_CLOSEST_HIT] + count[MESA_SHADER_MISS]) +
+               report_sites * count[MESA_SHADER_ANY_HIT] +
+               callable_sites * count[MESA_SHADER_CALLABLE];
+
+   return stages <= TU_RT_MONOLITHIC_MAX_STAGES &&
+          count[MESA_SHADER_ANY_HIT] + count[MESA_SHADER_INTERSECTION] <=
+             TU_RT_MONOLITHIC_MAX_HIT_SHADERS &&
+          *cost_out <= TU_RT_MONOLITHIC_MAX_COST && !callable_calls_callable;
+}
+
+/* Make the compute shader of NIR that was built from the stages. */
+static VkResult
+rt_create_shader(struct tu_device *dev, nir_shader *nir,
+                 const struct tu_shader_key *key,
+                 struct tu_pipeline_layout *layout, const void *key_data,
+                 size_t key_size, struct tu_shader **shader)
+{
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+   NIR_PASS(_, nir, nir_lower_global_vars_to_local);
+   NIR_PASS(_, nir, tu_nir_lower_ray_queries);
+   NIR_PASS(_, nir, nir_split_var_copies);
+   NIR_PASS(_, nir, nir_lower_var_copies);
+   NIR_PASS(_, nir, nir_opt_copy_prop_vars);
+
+   struct ir3_optimize_options optimize_options = {};
+   ir3_optimize_loop(dev->compiler, &optimize_options, nir);
+
+   struct ir3_shader_key ir3_key = {};
+   struct tu_shader_info shader_info = {};
+   char name[64];
+   snprintf(name, sizeof(name), "%s", nir->info.name ? nir->info.name : "rt");
+   const int64_t t0 = os_time_get_nano();
+   tu_lower_nir(dev, nir, key, &ir3_key, &shader_info);
+   const int64_t t1 = os_time_get_nano();
+   VkResult result = tu_shader_create(dev, shader, nir, key, &shader_info, &ir3_key,
+                                      key_data, key_size, layout, false);
+   if (dev->rt_log) {
+      /* DEBUG */
+      mesa_logi("rt_pipeline: DEBUG compile %s: tu_lower_nir %" PRId64 " ms, backend %" PRId64 " ms",
+                name, (t1 - t0) / 1000000, (os_time_get_nano() - t1) / 1000000);
+   }
+   return result;
+}
+
+/* The stack that each stage needs is in `stack`, in the order of the link. A
+ * duplicate has the stack of the stage that runs.
+ */
+static void
+rt_store_stacks(struct tu_rt_pipeline *pipeline, const struct rt_link *link,
+                const uint32_t *stack)
+{
+   for (unsigned i = 0; i < link->count; i++) {
+      pipeline->stages[i].stack = stack[i];
+      for (unsigned j = 0; j < i && link->duplicate[i]; j++) {
+         if (!link->duplicate[j] && pipeline->stages[j].stage == pipeline->stages[i].stage &&
+             pipeline->stages[j].id == pipeline->stages[i].id)
+            pipeline->stages[i].stack = stack[j];
+      }
+   }
+}
+
+static bool
+rt_aqe_covers_ubo(struct ir3_driver_ubo ref, struct ir3_driver_ubo ubo)
+{
+   return ubo.idx < 0 || (ref.idx == ubo.idx && ref.size >= ubo.size);
+}
+
+/* The pieces of a launch share the constants and the driver UBOs that are
+ * loaded before it, from the shader `ref`, so it has to load everything that
+ * `s` uses where `s` reads it.
+ */
+static bool
+rt_aqe_covers(const struct tu_shader *ref, const struct tu_shader *s)
+{
+   const struct tu_const_state *x = &ref->const_state, *y = &s->const_state;
+   const struct ir3_const_state *ix = ir3_const_state(ref->variant);
+   const struct ir3_const_state *iy = ir3_const_state(s->variant);
+
+   static const enum ir3_const_alloc_type uploaded[] = {
+      IR3_CONST_ALLOC_PUSH_CONSTS, IR3_CONST_ALLOC_DYN_DESCRIPTOR_OFFSET,
+      IR3_CONST_ALLOC_INLINE_UNIFORM_ADDRS, IR3_CONST_ALLOC_DRIVER_PARAMS,
+      IR3_CONST_ALLOC_BINDLESS_BASE_ADDRS,
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(uploaded); i++) {
+      const struct ir3_const_allocation *a = &ix->allocs.consts[uploaded[i]];
+      const struct ir3_const_allocation *b = &iy->allocs.consts[uploaded[i]];
+      if (b->size_vec4 && (a->offset_vec4 != b->offset_vec4 || a->size_vec4 < b->size_vec4))
+         return false;
+   }
+
+   return (!y->push_consts.dwords ||
+           (x->push_consts.type == y->push_consts.type &&
+            x->push_consts.lo_dwords == y->push_consts.lo_dwords &&
+            x->push_consts.dwords == y->push_consts.dwords)) &&
+          (!y->num_inline_ubos ||
+           (x->num_inline_ubos == y->num_inline_ubos &&
+            !memcmp(x->ubos, y->ubos, y->num_inline_ubos * sizeof(y->ubos[0])))) &&
+          x->num_bindless_base_addresses >= y->num_bindless_base_addresses &&
+          (y->dynamic_offset_loc == UINT32_MAX ||
+           x->dynamic_offset_loc == y->dynamic_offset_loc) &&
+          rt_aqe_covers_ubo(x->dynamic_offsets_ubo, y->dynamic_offsets_ubo) &&
+          rt_aqe_covers_ubo(x->inline_uniforms_ubo, y->inline_uniforms_ubo) &&
+          rt_aqe_covers_ubo(x->bindless_base_addrs_ubo, y->bindless_base_addrs_ubo) &&
+          rt_aqe_covers_ubo(ix->driver_params_ubo, iy->driver_params_ubo);
+}
+
+/* Emit the IBs of the shaders of the AQE, and the tables with their addresses
+ * and sizes. The pieces with the same private memory layout get the same
+ * private memory, big enough for the biggest of them.
+ */
+static VkResult
+rt_aqe_finish(struct tu_device *dev, struct tu_rt_aqe *aqe)
+{
+   const unsigned count = aqe->num_shaders - 1;
+   uint32_t pvtmem_bytes[2] = {};
+
+   for (unsigned i = 0; i < count && !aqe->consts; i++) {
+      unsigned j = 0;
+      while (j < count && rt_aqe_covers(aqe->shaders[i], aqe->shaders[j]))
+         j++;
+      if (j == count)
+         aqe->consts = aqe->shaders[i];
+   }
+   if (!aqe->consts) {
+      mesa_loge("rt_pipeline: the pieces do not use the same constants");
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+
+   for (unsigned i = 0; i < count; i++) {
+      const struct ir3_shader_variant *v = aqe->shaders[i]->variant;
+
+      if (v->constlen < TU_RT_AQE_CONSTS_VEC4) {
+         mesa_loge("rt_pipeline: a piece does not have the constants of the AQE");
+         return VK_ERROR_FEATURE_NOT_PRESENT;
+      }
+      aqe->instrlen = MAX2(aqe->instrlen, v->instrlen);
+      pvtmem_bytes[v->pvtmem_per_wave] =
+         MAX2(pvtmem_bytes[v->pvtmem_per_wave], v->pvtmem_size);
+   }
+
+   if (dev->rt_log) {
+      mesa_logi("rt_pipeline: aqe shaders %u instrlen max %u scratch0 %u pvtmem per thread %u/%u",
+                aqe->num_shaders, aqe->instrlen, aqe->scratch0_size, pvtmem_bytes[0],
+                pvtmem_bytes[1]);
+
+      /* DEBUG: a piece whose constant data UBO has the index of a driver UBO
+       * of the launch overwrites it for the pieces after it.
+       */
+      const struct tu_const_state *r = &aqe->consts->const_state;
+      const struct ir3_const_state *ir = ir3_const_state(aqe->consts->variant);
+      const int driver_ubos[] = { r->dynamic_offsets_ubo.idx, r->inline_uniforms_ubo.idx,
+                                  r->bindless_base_addrs_ubo.idx, ir->driver_params_ubo.idx };
+      mesa_logi("rt_pipeline: aqe driver ubos dyn %d inline %d bindless %d dp %d",
+                driver_ubos[0], driver_ubos[1], driver_ubos[2], driver_ubos[3]);
+      for (unsigned i = 0; i < count; i++) {
+         const int c = ir3_const_state(aqe->shaders[i]->variant)->consts_ubo.idx;
+         for (unsigned j = 0; c >= 0 && j < ARRAY_SIZE(driver_ubos); j++) {
+            if (c == driver_ubos[j])
+               mesa_loge("rt_pipeline: aqe piece %u constant data UBO %d clobbers driver UBO %u",
+                         i, c, j);
+         }
+      }
+   }
+
+   struct tu_pvtmem_config pvtmem[2] = {};
+   for (unsigned i = 0; i < 2; i++) {
+      if (!pvtmem_bytes[i])
+         continue;
+      VkResult result = tu_get_pvtmem(dev, &pvtmem[i], &aqe->pvtmem_bo[i],
+                                      pvtmem_bytes[i], i);
+      if (result != VK_SUCCESS)
+         return result;
+      if (dev->rt_log) {
+         mesa_logi("rt_pipeline: aqe DEBUG pvtmem[%u] iova 0x%" PRIx64 " size 0x%" PRIx64,
+                   i, aqe->pvtmem_bo[i]->iova, aqe->pvtmem_bo[i]->size);
+      }
+   }
+
+   const uint32_t ib_dwords = 192;
+   const uint32_t size = aqe->num_shaders * (ib_dwords * 4 + 12) + 16;
+
+   pthread_mutex_lock(&dev->pipeline_mutex);
+   VkResult result = tu_suballoc_bo_alloc(&aqe->bo, &dev->pipeline_suballoc, size, 128);
+   pthread_mutex_unlock(&dev->pipeline_mutex);
+   if (result != VK_SUCCESS)
+      return result;
+   tu_cs_init_suballoc(&aqe->cs, dev, &aqe->bo);
+
+   struct tu_cs_memory tables;
+   result = tu_cs_alloc(&aqe->cs, DIV_ROUND_UP(3 * aqe->num_shaders + 1, 4), 4, &tables);
+   if (result != VK_SUCCESS)
+      return result;
+
+   uint64_t *ib_addrs = reinterpret_cast<uint64_t *>(tables.map);
+   uint32_t *ib_lengths = reinterpret_cast<uint32_t *>(ib_addrs + aqe->num_shaders);
+   uint32_t *index = ib_lengths + aqe->num_shaders;
+
+   aqe->ib_addrs = tables.iova;
+   aqe->ib_lengths = tables.iova + 8 * aqe->num_shaders;
+   aqe->starter_index = aqe->ib_lengths + 4 * aqe->num_shaders;
+   *index = RT_AQE_STARTER_SHADER;
+
+   /* The first shader does nothing, as in the stock driver. */
+   for (unsigned i = 0; i < aqe->num_shaders; i++) {
+      struct tu_cs sub_cs;
+
+      result = tu_cs_begin_sub_stream(&aqe->cs, ib_dwords, &sub_cs);
+      if (result != VK_SUCCESS)
+         return result;
+      if (!i)
+         tu_cs_emit_pkt7(&sub_cs, CP_NOP, 0);
+      else
+         tu_shader_emit_aqe_ib(dev, &sub_cs, aqe->shaders[i - 1],
+                               &pvtmem[aqe->shaders[i - 1]->variant->pvtmem_per_wave]);
+
+      struct tu_cs_entry entry = tu_cs_end_sub_stream(&aqe->cs, &sub_cs);
+      ib_addrs[i] = entry.bo->iova + entry.offset;
+      ib_lengths[i] = entry.size / 4;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+rt_compile_aqe(struct tu_device *dev, struct tu_rt_pipeline *pipeline,
+               const VkRayTracingPipelineCreateInfoKHR *info,
+               struct rt_link *link, struct tu_shader_key *key,
+               struct tu_pipeline_layout *layout,
+               const unsigned *raygens, unsigned num_raygens,
+               struct rt_stats *stats)
+{
+   uint32_t *stack = rzalloc_array(link->mem_ctx, uint32_t, pipeline->stage_count);
+   unsigned count;
+   uint32_t scratch0_size;
+   /* DEBUG: where the compile time goes. */
+   if (dev->rt_log) {
+      for (unsigned i = 0; i < link->count; i++) {
+         mesa_logi("rt_pipeline: aqe DEBUG stage %u %s%s nir %u", i,
+                   mesa_shader_stage_name(link->stages[i].stage),
+                   link->duplicate[i] ? " (dup)" : "", rt_instr_count(link->nir[i]));
+      }
+   }
+   int64_t t0 = os_time_get_nano();
+   nir_shader **pieces = rt_build_aqe(link, raygens, num_raygens, stack, stats, &count,
+                                      &scratch0_size);
+   if (dev->rt_log)
+      mesa_logi("rt_pipeline: aqe DEBUG build pieces %" PRId64 " ms",
+                (os_time_get_nano() - t0) / 1000000);
+
+   rt_store_stacks(pipeline, link, stack);
+   rt_compute_stack(pipeline, info);
+
+   struct tu_rt_aqe *aqe = rzalloc(NULL, struct tu_rt_aqe);
+   if (!aqe)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   pipeline->aqe = aqe;
+   aqe->num_shaders = count + 1;
+   aqe->scratch0_size = scratch0_size;
+   aqe->shaders = rzalloc_array(aqe, struct tu_shader *, count);
+
+   key->rt_aqe = true;
+   for (unsigned i = 0; i < count; i++) {
+      const uint64_t key_data[2] = { pipeline->stages[raygens[0]].id, i };
+      stats->inline_instrs += rt_instr_count(pieces[i]);
+
+      const unsigned nir_instrs = rt_instr_count(pieces[i]);
+      char piece_name[64];
+      snprintf(piece_name, sizeof(piece_name), "%s", pieces[i]->info.name);
+      t0 = os_time_get_nano();
+      VkResult result = rt_create_shader(dev, pieces[i], key, layout, key_data,
+                                         sizeof(key_data), &aqe->shaders[i]);
+      if (result != VK_SUCCESS)
+         return result;
+      if (dev->rt_log) {
+         const struct ir3_shader_variant *v = aqe->shaders[i]->variant;
+         mesa_logi("rt_pipeline: aqe DEBUG piece %u (%s) nir %u ir3 %u regs %u pvtmem %u ms %" PRId64,
+                   i, piece_name, nir_instrs, v->info.instrs_count,
+                   v->info.max_reg + 1, v->pvtmem_size, (os_time_get_nano() - t0) / 1000000);
+      }
+      if (!i)
+         pipeline->base.shaders[MESA_SHADER_COMPUTE] = aqe->shaders[0];
+   }
+
+   return rt_aqe_finish(dev, aqe);
+}
+
+static VkResult
+tu_rt_compile(struct tu_device *dev, struct tu_rt_pipeline *pipeline,
+              const VkRayTracingPipelineCreateInfoKHR *info)
+{
+   VK_FROM_HANDLE(tu_pipeline_layout, layout, info->layout);
+
+   const uint64_t start_ns = os_time_get_nano();
+
+   struct tu_shader_key key = {};
+   key.version = dev->instance->drirc.misc.override_compute_shader_version;
+   key.rt = true;
+   tu_shader_key_subgroup_size(&key, false, false, NULL, dev);
+
+   struct vk_pipeline_robustness_state rs;
+   vk_pipeline_robustness_state_fill(&dev->vk.robustness_state, &rs,
+                                     info->pNext, NULL);
+   tu_shader_key_robustness(&key, &rs);
+
+   void *mem_ctx = ralloc_context(NULL);
+   struct rt_link link = {
+      .mem_ctx = mem_ctx,
+      .flags = vk_rt_pipeline_create_flags(info),
+      .count = pipeline->stage_count,
+      .stages = pipeline->stages,
+      .nir = rzalloc_array(mem_ctx, nir_shader *, pipeline->stage_count),
+      .duplicate = rzalloc_array(mem_ctx, bool, pipeline->stage_count),
+   };
+   unsigned *raygens = rzalloc_array(mem_ctx, unsigned, pipeline->stage_count);
+   unsigned num_raygens = 0;
+   struct rt_stats stats = {};
+   unsigned cost = 0;
+   bool small = false, separate = false;
+   VkResult result = VK_ERROR_FEATURE_NOT_PRESENT;
+
+   /* A stage is the same as an earlier one if their identities are, and a
+    * different stage of the same type must not have the same ID.
+    */
+   for (unsigned i = 0; i < link.count; i++) {
+      const struct tu_rt_stage *stage = &pipeline->stages[i];
+
+      for (unsigned j = 0; j < i && !link.duplicate[i]; j++) {
+         const struct tu_rt_stage *other = &pipeline->stages[j];
+         if (other->stage != stage->stage || other->id != stage->id)
+            continue;
+
+         if (memcmp(other->hash, stage->hash, sizeof(stage->hash))) {
+            mesa_loge("rt_pipeline: stages %u and %u have the same ID", j, i);
+            result = VK_ERROR_UNKNOWN;
+            goto out;
+         }
+         link.duplicate[i] = true;
+      }
+      if (link.duplicate[i])
+         continue;
+
+      if (stage->stage == MESA_SHADER_RAYGEN)
+         raygens[num_raygens++] = i;
+      link.has_any_hit |= stage->stage == MESA_SHADER_ANY_HIT;
+      link.has_intersection |= stage->stage == MESA_SHADER_INTERSECTION;
+      link.num_callables += stage->stage == MESA_SHADER_CALLABLE;
+
+      struct blob_reader reader;
+      blob_reader_init(&reader, stage->nir, stage->nir_size);
+      link.nir[i] = nir_deserialize(mem_ctx, ir3_get_compiler_options(dev->compiler),
+                                    &reader);
+   }
+   if (!num_raygens)
+      goto out;
+
+   link.float_controls = rt_merge_float_controls(&link);
+
+   small = rt_is_small(&link, &cost);
+   separate = dev->rt_mode == TU_RT_MODE_SEPARATE ||
+              (dev->rt_mode == TU_RT_MODE_AUTO && !small);
+
+   for (unsigned copies = 0, chain = 1; link.max_callable_depth < TU_RT_MAX_CALLABLE_DEPTH;
+        link.max_callable_depth++) {
+      chain *= link.num_callables;
+      if (copies + chain > TU_RT_MAX_CALLABLE_COPIES)
+         break;
+      copies += chain;
+   }
+
+   if (dev->rt_mode == TU_RT_MODE_AQE) {
+      result = rt_compile_aqe(dev, pipeline, info, &link, &key, layout, raygens,
+                              num_raygens, &stats);
+   } else {
+      nir_shader *nir;
+      if (separate) {
+         uint32_t *stack = rzalloc_array(mem_ctx, uint32_t, pipeline->stage_count);
+         nir = rt_build_separate(&link, raygens, num_raygens, stack, &stats);
+
+         rt_store_stacks(pipeline, &link, stack);
+         rt_compute_stack(pipeline, info);
+
+         /* The hit attributes are in the private memory of the shader, the
+          * stack is after it.
+          */
+         nir->scratch_size = MAX2(nir->scratch_size, TU_RT_SCRATCH_STACK);
+      } else {
+         nir = rt_build_main(&link, raygens, num_raygens);
+         for (unsigned i = 0; i < link.count; i++)
+            pipeline->stages[i].stack = TU_RT_STACK_SIZE_ESTIMATE;
+      }
+      stats.inline_instrs = rt_instr_count(nir);
+
+      result = rt_create_shader(dev, nir, &key, layout,
+                                &pipeline->stages[raygens[0]].id,
+                                sizeof(pipeline->stages[0].id),
+                                &pipeline->base.shaders[MESA_SHADER_COMPUTE]);
+   }
+
+   if (result == VK_SUCCESS && dev->rt_log) {
+      const struct ir3_shader_variant *v =
+         pipeline->base.shaders[MESA_SHADER_COMPUTE]->variant;
+      mesa_logi("rt_pipeline: %s (%s) stages %u cost %u cases %u split_instrs %u "
+                "inline_instrs %u compile_ms %" PRIu64 " gprs %d half_gprs %d "
+                "ldp %u stp %u stack %u pvtmem_per_thread %u",
+                dev->rt_mode == TU_RT_MODE_AQE ? "aqe" :
+                separate ? "separate" : "monolithic",
+                dev->rt_mode == TU_RT_MODE_AUTO ? "auto" : "forced", link.count,
+                cost, stats.cases, stats.split_instrs, stats.inline_instrs,
+                (os_time_get_nano() - start_ns) / 1000000, v->info.max_reg + 1,
+                v->info.max_half_reg + 1, v->info.ldp_count, v->info.stp_count,
+                pipeline->stack_default, v->pvtmem_size);
+   }
+
+out:
+   ralloc_free(mem_ctx);
+   return result;
+}
+
+static void
+tu_rt_stage_finish(struct tu_rt_stage *stage)
+{
+   free(stage->nir);
+}
+
+void
+tu_rt_pipeline_finish(struct tu_rt_pipeline *pipeline, struct tu_device *dev,
+                      const VkAllocationCallbacks *alloc)
+{
+   struct tu_rt_aqe *aqe = pipeline->aqe;
+   if (aqe) {
+      /* The first shader is released with the others of the pipeline. */
+      for (unsigned i = 1; i + 1 < aqe->num_shaders; i++) {
+         if (aqe->shaders[i])
+            vk_pipeline_cache_object_unref(&dev->vk, &aqe->shaders[i]->base);
+      }
+      for (unsigned i = 0; i < 2; i++) {
+         if (aqe->pvtmem_bo[i])
+            tu_bo_finish(dev, aqe->pvtmem_bo[i]);
+      }
+      if (aqe->bo.bo) {
+         tu_cs_finish(&aqe->cs);
+         pthread_mutex_lock(&dev->pipeline_mutex);
+         tu_suballoc_bo_free(&dev->pipeline_suballoc, &aqe->bo);
+         pthread_mutex_unlock(&dev->pipeline_mutex);
+      }
+      ralloc_free(aqe);
+   }
+
+   for (unsigned i = 0; pipeline->stages && i < pipeline->stage_count; i++)
+      tu_rt_stage_finish(&pipeline->stages[i]);
+   vk_free2(&dev->vk.alloc, alloc, pipeline->stages);
+   vk_free2(&dev->vk.alloc, alloc, pipeline->groups);
+}
+
+/* Fill out the identity of a stage from its hash. The ID is 64 bits of it,
+ * never 0 because that means no stage.
+ */
+static void
+tu_rt_stage_identify(struct tu_rt_stage *stage,
+                     const VkPipelineShaderStageCreateInfo *stage_info)
+{
+   vk_pipeline_hash_shader_stage(0, stage_info, NULL, stage->hash);
+
+   memcpy(&stage->id, stage->hash, sizeof(stage->id));
+   if (!stage->id)
+      stage->id = 1;
+}
+
+static uint64_t
+tu_rt_group_id(const struct tu_rt_stage *stages, uint32_t index)
+{
+   return index == VK_SHADER_UNUSED_KHR ? 0 : stages[index].id;
+}
+
+/* The stacks of the groups come from the stages of the pipeline, which
+ * includes the ones of its libraries.
+ */
+static void
+rt_fill_group_stacks(struct tu_rt_pipeline *pipeline)
+{
+   for (unsigned i = 0; i < pipeline->group_count; i++) {
+      struct tu_rt_group *group = &pipeline->groups[i];
+      for (unsigned k = 0; k < 4; k++) {
+         for (unsigned j = 0; group->ids[k] && j < pipeline->stage_count; j++) {
+            if (pipeline->stages[j].id == group->ids[k])
+               group->stack[k] = pipeline->stages[j].stack;
+         }
+      }
+   }
+}
+
+static VkResult
+tu_rt_pipeline_create(struct tu_device *dev,
+                      const VkRayTracingPipelineCreateInfoKHR *info,
+                      const VkAllocationCallbacks *pAllocator,
+                      VkPipeline *pPipeline)
+{
+   const VkPipelineCreateFlags2KHR flags = vk_rt_pipeline_create_flags(info);
+   const bool library = flags & VK_PIPELINE_CREATE_2_LIBRARY_BIT_KHR;
+   const VkPipelineLibraryCreateInfoKHR *lib_info = info->pLibraryInfo;
+   const uint32_t lib_count = lib_info ? lib_info->libraryCount : 0;
+   const VkPipelineCreationFeedbackCreateInfo *feedback =
+      vk_find_struct_const(info->pNext, PIPELINE_CREATION_FEEDBACK_CREATE_INFO);
+
+   if (!library &&
+       (flags & VK_PIPELINE_CREATE_2_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT_KHR))
+      return VK_PIPELINE_COMPILE_REQUIRED;
+
+   struct tu_rt_pipeline *pipeline = static_cast<struct tu_rt_pipeline *>(
+      vk_object_zalloc(&dev->vk, pAllocator, sizeof(*pipeline),
+                       VK_OBJECT_TYPE_PIPELINE));
+   if (!pipeline)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   pipeline->base.type = TU_PIPELINE_RAY_TRACING;
+
+   pipeline->stage_count = info->stageCount;
+   pipeline->group_count = info->groupCount;
+   for (unsigned i = 0; i < lib_count; i++) {
+      VK_FROM_HANDLE(tu_pipeline, lib_base, lib_info->pLibraries[i]);
+      struct tu_rt_pipeline *lib = tu_pipeline_to_rt(lib_base);
+      pipeline->stage_count += lib->stage_count;
+      pipeline->group_count += lib->group_count;
+   }
+
+   VkResult result = VK_ERROR_OUT_OF_HOST_MEMORY;
+   pipeline->stages = static_cast<struct tu_rt_stage *>(
+      vk_zalloc2(&dev->vk.alloc, pAllocator,
+                 pipeline->stage_count * sizeof(*pipeline->stages), 8,
+                 VK_SYSTEM_ALLOCATION_SCOPE_OBJECT));
+   pipeline->groups = static_cast<struct tu_rt_group *>(
+      vk_zalloc2(&dev->vk.alloc, pAllocator,
+                 pipeline->group_count * sizeof(*pipeline->groups), 8,
+                 VK_SYSTEM_ALLOCATION_SCOPE_OBJECT));
+   if ((pipeline->stage_count && !pipeline->stages) ||
+       (pipeline->group_count && !pipeline->groups))
+      goto fail;
+
+   for (unsigned i = 0; i < info->stageCount; i++) {
+      const VkPipelineShaderStageCreateInfo *stage_info = &info->pStages[i];
+      struct tu_rt_stage *stage = &pipeline->stages[i];
+      struct tu_shader_key key = {};
+
+      stage->stage = vk_to_mesa_shader_stage(stage_info->stage);
+      tu_rt_stage_identify(stage, stage_info);
+      pipeline->base.active_stages |= stage_info->stage;
+
+      void *mem_ctx = ralloc_context(NULL);
+      nir_shader *nir =
+         tu_spirv_to_nir(dev, mem_ctx, flags, stage_info, &key, stage->stage);
+      if (!nir) {
+         ralloc_free(mem_ctx);
+         result = VK_ERROR_UNKNOWN;
+         goto fail;
+      }
+
+      /* A library knows the stack of its stages, the pipelines that use it
+       * ask for the stacks of its groups.
+       */
+      if (library)
+         stage->stack = rt_stage_stack(nir, stage->stage);
+
+      struct blob blob;
+      blob_init(&blob);
+      nir_serialize(&blob, nir, false);
+      blob_finish_get_buffer(&blob, &stage->nir, &stage->nir_size);
+      ralloc_free(mem_ctx);
+      if (!stage->nir)
+         goto fail;
+   }
+
+   /* The stages and groups of the libraries come after our own ones. */
+   for (unsigned stage_idx = info->stageCount, group_idx = info->groupCount,
+        i = 0; i < lib_count; i++) {
+      VK_FROM_HANDLE(tu_pipeline, lib_base, lib_info->pLibraries[i]);
+      struct tu_rt_pipeline *lib = tu_pipeline_to_rt(lib_base);
+
+      for (unsigned j = 0; j < lib->stage_count; j++, stage_idx++) {
+         struct tu_rt_stage *stage = &pipeline->stages[stage_idx];
+         *stage = lib->stages[j];
+         stage->nir = malloc(stage->nir_size);
+         if (!stage->nir)
+            goto fail;
+         memcpy(stage->nir, lib->stages[j].nir, stage->nir_size);
+      }
+      memcpy(&pipeline->groups[group_idx], lib->groups,
+             lib->group_count * sizeof(*lib->groups));
+      group_idx += lib->group_count;
+   }
+
+   /* All the stages are in place, which the groups index into. */
+   for (unsigned i = 0; i < info->groupCount; i++) {
+      const VkRayTracingShaderGroupCreateInfoKHR *group = &info->pGroups[i];
+      pipeline->groups[i].ids[0] =
+         tu_rt_group_id(pipeline->stages, group->generalShader);
+      pipeline->groups[i].ids[1] =
+         tu_rt_group_id(pipeline->stages, group->closestHitShader);
+      pipeline->groups[i].ids[2] =
+         tu_rt_group_id(pipeline->stages, group->anyHitShader);
+      pipeline->groups[i].ids[3] =
+         tu_rt_group_id(pipeline->stages, group->intersectionShader);
+   }
+
+   if (!library) {
+      result = tu_rt_compile(dev, pipeline, info);
+      if (result != VK_SUCCESS)
+         goto fail;
+
+      rt_fill_group_stacks(pipeline);
+
+      for (unsigned i = 0; i < pipeline->stage_count; i++)
+         tu_rt_stage_finish(&pipeline->stages[i]);
+      vk_free2(&dev->vk.alloc, pAllocator, pipeline->stages);
+      pipeline->stages = NULL;
+      pipeline->stage_count = 0;
+   }
+
+   if (feedback) {
+      *feedback->pPipelineCreationFeedback = (VkPipelineCreationFeedback) {
+         .flags = VK_PIPELINE_CREATION_FEEDBACK_VALID_BIT,
+      };
+      for (unsigned i = 0; i < feedback->pipelineStageCreationFeedbackCount; i++)
+         feedback->pPipelineStageCreationFeedbacks[i] =
+            (VkPipelineCreationFeedback) {};
+   }
+
+   if (library)
+      rt_fill_group_stacks(pipeline);
+
+   *pPipeline = tu_pipeline_to_handle(&pipeline->base);
+   return VK_SUCCESS;
+
+fail:
+   if (pipeline->base.shaders[MESA_SHADER_COMPUTE])
+      vk_pipeline_cache_object_unref(
+         &dev->vk, &pipeline->base.shaders[MESA_SHADER_COMPUTE]->base);
+   tu_rt_pipeline_finish(pipeline, dev, pAllocator);
+   vk_object_free(&dev->vk, pAllocator, pipeline);
+   return result;
+}
+
+/* A 32-bit value of a 64-bit field of the indirect command, saturated. */
+static nir_def *
+rt_command_u32(nir_builder *b, nir_def *command, unsigned offset)
+{
+   nir_def *v = nir_load_global(b, 2, 32, nir_iadd_imm(b, command, offset),
+                                .align_mul = 4);
+   return nir_bcsel(b, nir_ieq_imm(b, nir_channel(b, v, 1), 0),
+                    nir_channel(b, v, 0), nir_imm_int(b, UINT32_MAX));
+}
+
+/* Read the indirect launch command and fill out the launch UBO from it. */
+static nir_shader *
+rt_build_prepass(struct tu_device *dev)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, ir3_get_compiler_options(dev->compiler), "rt_prepass");
+   nir_shader *nir = b.shader;
+   nir->info.workgroup_size[0] = 1;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+
+   nir_def *command = nir_load_scratch_base_ptr(&b, 1, 64, TU_RT_PREPASS_UBO_COMMAND);
+   nir_def *launch = nir_load_scratch_base_ptr(&b, 1, 64, TU_RT_PREPASS_UBO_LAUNCH);
+   nir_def *indirect2 = nir_ine_imm(
+      &b, nir_load_scratch_base_ptr(&b, 1, 32, TU_RT_PREPASS_UBO_INDIRECT2), 0);
+
+   /* The dimensions are at the end of VkTraceRaysIndirectCommand2KHR. */
+   nir_def *dims = nir_load_global(
+      &b, 3, 32,
+      nir_iadd(&b, command, nir_bcsel(&b, indirect2, nir_imm_int64(&b, 88),
+                                      nir_imm_int64(&b, 0))),
+      .align_mul = 4);
+   nir_store_global(&b, dims, nir_iadd_imm(&b, launch, TU_RT_UBO_LAUNCH_SIZE * 4),
+                    .write_mask = 0x7, .align_mul = 4);
+
+   /* An empty launch still dispatches a single workgroup, which does nothing. */
+   nir_def *empty = nir_ior(&b, nir_ieq_imm(&b, nir_channel(&b, dims, 0), 0),
+                            nir_ior(&b, nir_ieq_imm(&b, nir_channel(&b, dims, 1), 0),
+                                    nir_ieq_imm(&b, nir_channel(&b, dims, 2), 0)));
+   nir_def *groups[3];
+   for (unsigned i = 0; i < 3; i++) {
+      nir_def *dim = nir_channel(&b, dims, i);
+      if (i < 2)
+         dim = nir_ushr_imm(&b, nir_iadd_imm(&b, dim, TU_RT_WORKGROUP_SIZE - 1), 3);
+      groups[i] = nir_bcsel(&b, empty, nir_imm_int(&b, 1), dim);
+   }
+   nir_store_global(&b, nir_vec(&b, groups, 3),
+                    nir_iadd_imm(&b, launch, TU_RT_UBO_GROUP_COUNTS * 4),
+                    .write_mask = 0x7, .align_mul = 4);
+
+   nir_push_if(&b, indirect2);
+   {
+      /* The raygen record is a region of a single record, the others are
+       * {address, size, stride}.
+       */
+      static const unsigned fields[4] = { 0, 16, 40, 64 };
+      for (unsigned i = 0; i < 4; i++) {
+         nir_def *addr = nir_load_global(&b, 2, 32,
+                                         nir_iadd_imm(&b, command, fields[i]),
+                                         .align_mul = 4);
+         nir_def *size = rt_command_u32(&b, command, fields[i] + 8);
+         nir_def *stride = i ? rt_command_u32(&b, command, fields[i] + 16) : size;
+         nir_store_global(&b, nir_vec4(&b, nir_channel(&b, addr, 0),
+                                       nir_channel(&b, addr, 1), stride, size),
+                          nir_iadd_imm(&b, launch, (TU_RT_UBO_RAYGEN_SBT + i * 4) * 4),
+                          .write_mask = 0xf, .align_mul = 4);
+      }
+   }
+   nir_pop_if(&b, NULL);
+
+   return nir;
+}
+
+VkResult
+tu_init_rt_prepass_shader(struct tu_device *dev)
+{
+   static const char key_data[] = "rt_prepass";
+   struct tu_shader_key key = {};
+   struct ir3_shader_key ir3_key = {};
+   struct tu_shader_info info = {};
+   struct tu_pipeline_layout layout = {};
+
+   key.api_wavesize = key.real_wavesize = IR3_SINGLE_ONLY;
+
+   nir_shader *nir = rt_build_prepass(dev);
+   tu_lower_nir(dev, nir, &key, &ir3_key, &info);
+
+   return tu_shader_create(dev, &dev->rt_prepass, nir, &key, &info, &ir3_key,
+                           key_data, sizeof(key_data), &layout, false);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_CreateRayTracingPipelinesKHR(VkDevice device,
+                                VkDeferredOperationKHR deferredOperation,
+                                VkPipelineCache pipelineCache,
+                                uint32_t count,
+                                const VkRayTracingPipelineCreateInfoKHR *pCreateInfos,
+                                const VkAllocationCallbacks *pAllocator,
+                                VkPipeline *pPipelines)
+{
+   VK_FROM_HANDLE(tu_device, dev, device);
+   VkResult final_result = VK_SUCCESS;
+   uint32_t i = 0;
+
+   /* Pipelines are always created synchronously. */
+   for (; i < count; i++) {
+      VkResult result =
+         tu_rt_pipeline_create(dev, &pCreateInfos[i], pAllocator, &pPipelines[i]);
+      if (result != VK_SUCCESS) {
+         final_result = result;
+         pPipelines[i] = VK_NULL_HANDLE;
+
+         if (vk_rt_pipeline_create_flags(&pCreateInfos[i]) &
+             VK_PIPELINE_CREATE_2_EARLY_RETURN_ON_FAILURE_BIT_KHR)
+            break;
+      }
+   }
+
+   for (i++; i < count; i++)
+      pPipelines[i] = VK_NULL_HANDLE;
+
+   if (final_result == VK_SUCCESS && deferredOperation != VK_NULL_HANDLE)
+      return VK_OPERATION_NOT_DEFERRED_KHR;
+
+   return final_result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetRayTracingShaderGroupHandlesKHR(VkDevice device,
+                                      VkPipeline _pipeline,
+                                      uint32_t firstGroup,
+                                      uint32_t groupCount,
+                                      size_t dataSize,
+                                      void *pData)
+{
+   VK_FROM_HANDLE(tu_pipeline, pipeline, _pipeline);
+   struct tu_rt_pipeline *rt = tu_pipeline_to_rt(pipeline);
+
+   memset(pData, 0, groupCount * TU_RT_HANDLE_SIZE);
+   for (unsigned i = 0; i < groupCount; i++) {
+      memcpy(static_cast<char *>(pData) + i * TU_RT_HANDLE_SIZE,
+             rt->groups[firstGroup + i].ids, sizeof(rt->groups[0].ids));
+   }
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetRayTracingCaptureReplayShaderGroupHandlesKHR(VkDevice device,
+                                                   VkPipeline pipeline,
+                                                   uint32_t firstGroup,
+                                                   uint32_t groupCount,
+                                                   size_t dataSize,
+                                                   void *pData)
+{
+   return tu_GetRayTracingShaderGroupHandlesKHR(device, pipeline, firstGroup,
+                                                groupCount, dataSize, pData);
+}
+
+VKAPI_ATTR VkDeviceSize VKAPI_CALL
+tu_GetRayTracingShaderGroupStackSizeKHR(VkDevice device,
+                                        VkPipeline _pipeline,
+                                        uint32_t group,
+                                        VkShaderGroupShaderKHR groupShader)
+{
+   VK_FROM_HANDLE(tu_pipeline, pipeline, _pipeline);
+   struct tu_rt_pipeline *rt = tu_pipeline_to_rt(pipeline);
+
+   return rt->groups[group].stack[groupShader];
+}
+
+VKAPI_ATTR void VKAPI_CALL
+tu_CmdSetRayTracingPipelineStackSizeKHR(VkCommandBuffer commandBuffer,
+                                        uint32_t pipelineStackSize)
+{
+   VK_FROM_HANDLE(tu_cmd_buffer, cmd, commandBuffer);
+
+   /* The private memory of the launch is sized from it. */
+   cmd->state.rt_stack_set = pipelineStackSize;
+   cmd->state.rt_stack_is_set = true;
+}
diff --git a/src/freedreno/vulkan/tu_rt_pipeline.h b/src/freedreno/vulkan/tu_rt_pipeline.h
new file mode 100644
index 00000000000..e56f7f5799e
--- /dev/null
+++ b/src/freedreno/vulkan/tu_rt_pipeline.h
@@ -0,0 +1,212 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef TU_RT_PIPELINE_H
+#define TU_RT_PIPELINE_H
+
+#include "tu_pipeline.h"
+
+#include "nir/nir_builder.h"
+
+/* The ray tracing pipeline compiler has two modes:
+ *
+ * - monolithic: the hit, miss and callable shaders are inlined where they can
+ *   run, in each raygen shader.
+ * - separate: every stage and resume shader is a case of a scheduler loop in
+ *   one compute shader, with an explicit stack in private memory.
+ *
+ * tu_rt_pipeline.cc has the API, the monolithic mode and what the modes share,
+ * tu_rt_separate.cc the separate mode.
+ */
+
+/* The private memory starts with the candidate and the committed hit
+ * attributes. The stack of the monolithic mode comes after them, the one of
+ * the separate mode is after all the private memory of the shader.
+ */
+#define TU_RT_SCRATCH_HIT_ATTRIB_CAND 0
+#define TU_RT_SCRATCH_HIT_ATTRIB_COMMITTED 32
+#define TU_RT_SCRATCH_STACK 64
+
+struct rt_link {
+   void *mem_ctx;
+   VkPipelineCreateFlags2KHR flags;
+   unsigned count;
+   const struct tu_rt_stage *stages;
+   nir_shader **nir;
+
+   /* Stages identical to an earlier one, which run as that one. */
+   bool *duplicate;
+
+   /* The float controls of all the stages, which one shader has. */
+   unsigned float_controls;
+
+   bool has_any_hit;
+   bool has_intersection;
+   unsigned num_callables;
+   unsigned max_callable_depth;
+};
+
+/* The variables shared by the raygen shader and the shaders inlined in it, or
+ * by the cases of the scheduler.
+ */
+#define RT_VARS(X) \
+   X(rq) X(record) X(cull_mask) X(ray_flags) X(candidate_t) \
+   X(candidate_hit_kind) X(committed_hit_kind) X(accept) X(terminate) \
+   X(next) X(sp) X(incoming) X(accel_struct) X(sbt_offset) X(sbt_stride) \
+   X(miss_index) X(origin) X(tmin) X(direction) X(tmax)
+
+/* How a stage is called. */
+struct rt_call {
+   /* The scratch offset of its incoming payload or callable data. */
+   unsigned offset;
+
+   /* The scratch offset where the outgoing data of the stage goes. In
+    * separate mode, where the scratch of an inlined any hit shader starts,
+    * after the one of the intersection shader that calls it.
+    */
+   unsigned frame;
+
+   /* How many callables deep it is. */
+   unsigned depth;
+
+   /* Whether it can trace rays, which is only the case from the raygen
+    * shader and the callables that it calls.
+    */
+   bool trace;
+};
+
+struct rt_raygen;
+
+typedef void (*rt_inline_stages_fn)(const struct rt_raygen *rg, nir_builder *b,
+                                    mesa_shader_stage stage, nir_def *record,
+                                    nir_def *id, const struct rt_call *callee);
+
+/* The state of the current trace_ray, shared by the raygen shader and the
+ * shaders inlined in it. The candidate is the hit that is being tested by
+ * the any hit and intersection shaders.
+ */
+struct rt_raygen {
+   const struct rt_link *link;
+
+   /* The scratch used by all the shaders inlined in the raygen shader. */
+   unsigned *scratch_size;
+
+   /* Runs the shaders of a type that the ID selects. */
+   rt_inline_stages_fn inline_stages;
+
+   /* The state of the separate mode. */
+   void *data;
+
+   /* The AQE mode reads the launch ID from the state of the thread. */
+   bool aqe;
+
+#define X(name) nir_variable *name;
+   RT_VARS(X)
+#undef X
+};
+
+/* The arguments of a trace_ray. */
+struct rt_ray {
+   nir_def *accel_struct, *flags, *cull_mask, *sbt_offset, *sbt_stride,
+           *miss_index, *origin, *tmin, *direction, *tmax;
+};
+
+struct rt_builtins {
+   const struct rt_raygen *rg;
+
+   /* Whether the hit that the builtins describe is the committed one or the
+    * candidate, and whether tmax is the committed t.
+    */
+   bool committed;
+   bool tmax_committed;
+
+   /* The AQE mode: the committed hit is not in the ray query of the shader, the
+    * builtins that read it are left to be lowered to what the traversal exported.
+    */
+   bool exported;
+};
+
+nir_def *
+rt_rq_load(nir_builder *b, const struct rt_raygen *rg, unsigned num_components,
+           unsigned bit_size, nir_ray_query_value value, bool committed,
+           unsigned column = 0);
+
+nir_variable *
+rt_var(nir_shader *nir, const glsl_type *type, const char *name);
+
+void
+rt_vars_create(struct rt_raygen *rg, nir_shader *nir);
+
+/* Map the variables of `from` to the ones of `to` when inlining. */
+struct hash_table *
+rt_remap_create(const struct rt_raygen *from, const struct rt_raygen *to);
+
+nir_def *
+rt_sbt_record(nir_builder *b, unsigned region, nir_def *index);
+
+nir_def *
+rt_raygen_record(nir_builder *b);
+
+nir_def *
+rt_record_id(nir_builder *b, nir_def *record, unsigned index);
+
+bool
+lower_rt_builtin(nir_builder *b, nir_intrinsic_instr *intr, void *data);
+
+void
+lower_rt_vars(nir_shader *nir, nir_variable_mode mode, unsigned scratch_base);
+
+/* The variable that a trace_ray or execute_callable passes. */
+nir_variable *
+rt_call_data(nir_intrinsic_instr *intr);
+
+/* Whether `instr` is a halt, ignoreIntersection or terminateRay of an any hit
+ * shader, which is lowered to leave it.
+ */
+bool
+rt_lower_hit_exit(const struct rt_raygen *rg, nir_builder *b, nir_instr *instr);
+
+void
+lower_report_intersection(const struct rt_raygen *rg, nir_function_impl *impl,
+                          nir_intrinsic_instr *report,
+                          const struct rt_call *callee);
+
+/* Lower everything of a trace_ray after the ray arguments, from
+ * rq_initialize to the selection of the closest hit or miss shader.
+ */
+void
+rt_build_trace(const struct rt_raygen *rg, nir_builder *b,
+               const struct rt_ray *ray, const struct rt_call *callee);
+
+struct rt_stats {
+   unsigned cases;
+   unsigned split_instrs;
+   unsigned inline_instrs;
+};
+
+nir_def *
+rt_launch_size(nir_builder *b);
+
+/* The stack that a stage needs in separate mode. */
+uint32_t
+rt_stage_stack(nir_shader *nir, mesa_shader_stage stage);
+
+/* Build the compute shader of a pipeline in separate mode. The stack that each
+ * stage needs is returned in `stack`, in the order of the link.
+ */
+nir_shader *
+rt_build_separate(struct rt_link *link, const unsigned *raygens,
+                  unsigned num_raygens, uint32_t *stack, struct rt_stats *stats);
+
+/* Build the programs of the AQE mode: the traversal, the starter of the rays and
+ * the recycler, then the piece that each case of the separate mode is. The stack
+ * that each stage needs is returned in `stack`, and the size of the state of a
+ * thread that the pieces share in `scratch0_size`.
+ */
+nir_shader **
+rt_build_aqe(struct rt_link *link, const unsigned *raygens, unsigned num_raygens,
+             uint32_t *stack, struct rt_stats *stats, unsigned *count,
+             uint32_t *scratch0_size);
+
+#endif
diff --git a/src/freedreno/vulkan/tu_rt_separate.cc b/src/freedreno/vulkan/tu_rt_separate.cc
new file mode 100644
index 00000000000..176605ee2d5
--- /dev/null
+++ b/src/freedreno/vulkan/tu_rt_separate.cc
@@ -0,0 +1,1489 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "tu_rt_pipeline.h"
+
+#include "util/u_dynarray.h"
+
+
+/* Separate mode: the pipeline is one compute shader that runs a scheduler loop
+ * for each ray. Every raygen, closest hit, miss and callable shader, and every
+ * resume shader that nir_lower_shader_calls splits off them, is a case of the
+ * loop, found by a balanced decision tree on the case index `next`. One more
+ * case runs the traversal, with the any hit and intersection shaders inlined in
+ * it, one returns to the shader that called the current one.
+ *
+ * A shader calls another by pushing a frame on the stack in private memory
+ * and setting `next`, then it leaves its case. The stack pointer `sp` is an
+ * absolute byte offset. The caller frame is [S, S + F), where S is `sp` at the
+ * call and F the stack_size of the call: its locals, the data it passes and
+ * what was spilled. The header of the call follows it, at S + F:
+ *
+ *    { return case u32, caller's incoming data u32, caller's shader record u64 }
+ *
+ * and the callee starts at S + F + 16. The data that the callee is called with
+ * (payload or callable data) is the one in the frame of the caller at S + p,
+ * its absolute offset is `incoming`. Returning pops the header and goes to the
+ * return case, which restores `incoming` and the shader record from it and pops
+ * its frame.
+ *
+ * The private memory accesses of a case are relative to `sp`, the ones to the
+ * header and to the hit attributes (the first bytes of private memory) are
+ * absolute, and are made after the rebasing.
+ */
+
+#define TU_RT_STACK_HEADER 16
+
+enum {
+   RT_HEADER_CASE = 0,
+   RT_HEADER_INCOMING = 4,
+   RT_HEADER_RECORD = 8,
+};
+
+struct rt_key {
+   uint64_t id;
+   unsigned index;
+};
+
+struct rt_keys {
+   struct rt_key *key;
+   unsigned count;
+};
+
+/* A shader of a stage, or the one that resumes it after a call. */
+struct rt_case {
+   nir_shader *nir;
+
+   /* The stage in the link. */
+   unsigned stage;
+};
+
+struct rt_sep {
+   struct rt_link *link;
+   struct rt_raygen rg;
+   struct rt_stats *stats;
+   uint32_t *stack;
+
+   struct rt_case *cases;
+   unsigned num_cases;
+
+   /* Whether the cases are programs of the AQE mode and not cases of a loop. */
+   bool aqe;
+   const nir_shader_compiler_options *options;
+
+   /* The case of each stage in the link, and the special ones. */
+   unsigned *first_case;
+   unsigned traversal, ret, done;
+   bool has_trace;
+
+   /* The fields of the committed hit that the closest hit and miss shaders
+    * read (rt_aqe_export), which the traversal of the AQE mode leaves in
+    * scratch0.
+    */
+   unsigned exported;
+
+   /* The stages of each type by ID. */
+   struct rt_keys keys[MESA_ALL_SHADER_STAGES];
+};
+
+static nir_def *
+rt_stack_load(nir_builder *b, nir_def *addr, unsigned offset)
+{
+   return nir_load_scratch(b, 1, 32, nir_iadd_imm(b, addr, offset), .align_mul = 4);
+}
+
+static void
+rt_stack_store(nir_builder *b, nir_def *addr, unsigned offset, nir_def *value)
+{
+   nir_store_scratch(b, value, nir_iadd_imm(b, addr, offset), .align_mul = 4,
+                     .write_mask = 1);
+}
+
+/* Choose the key of `keys` that `id` is with a balanced tree and run `leaf`
+ * for it.
+ */
+template <typename F>
+static void
+rt_select_id(nir_builder *b, nir_def *id, const struct rt_key *keys,
+             unsigned count, F leaf)
+{
+   if (count == 1) {
+      nir_push_if(b, nir_ieq_imm(b, id, keys[0].id));
+      leaf(keys[0].index);
+      nir_pop_if(b, NULL);
+   } else if (count > 1) {
+      const unsigned mid = count / 2;
+      nir_push_if(b, nir_ult(b, id, nir_imm_int64(b, keys[mid].id)));
+      rt_select_id(b, id, keys, mid, leaf);
+      nir_push_else(b, NULL);
+      rt_select_id(b, id, keys + mid, count - mid, leaf);
+      nir_pop_if(b, NULL);
+   }
+}
+
+/* The same for the cases [first, last) of the scheduler, whose value in `cur`
+ * is in the range.
+ */
+template <typename F>
+static void
+rt_select_case(nir_builder *b, nir_def *cur, unsigned first, unsigned last,
+               F leaf)
+{
+   if (last - first == 1) {
+      leaf(first);
+   } else {
+      const unsigned mid = (first + last) / 2;
+      nir_push_if(b, nir_ult_imm(b, cur, mid));
+      rt_select_case(b, cur, first, mid, leaf);
+      nir_push_else(b, NULL);
+      rt_select_case(b, cur, mid, last, leaf);
+      nir_pop_if(b, NULL);
+   }
+}
+
+static int
+rt_key_compare(const void *a, const void *b)
+{
+   const uint64_t x = static_cast<const struct rt_key *>(a)->id;
+   const uint64_t y = static_cast<const struct rt_key *>(b)->id;
+   return x < y ? -1 : x > y;
+}
+
+static void
+rt_sep_gather_keys(struct rt_sep *sep)
+{
+   const struct rt_link *link = sep->link;
+
+   for (unsigned i = 0; i < link->count; i++) {
+      struct rt_keys *keys = &sep->keys[link->stages[i].stage];
+      if (!link->duplicate[i])
+         keys->count++;
+   }
+   for (unsigned t = 0; t < MESA_ALL_SHADER_STAGES; t++) {
+      sep->keys[t].key = rzalloc_array(link->mem_ctx, struct rt_key,
+                                       sep->keys[t].count);
+      sep->keys[t].count = 0;
+   }
+   for (unsigned i = 0; i < link->count; i++) {
+      struct rt_keys *keys = &sep->keys[link->stages[i].stage];
+      if (!link->duplicate[i])
+         keys->key[keys->count++] = { link->stages[i].id, i };
+   }
+   for (unsigned t = 0; t < MESA_ALL_SHADER_STAGES; t++) {
+      qsort(sep->keys[t].key, sep->keys[t].count, sizeof(struct rt_key),
+            rt_key_compare);
+   }
+}
+
+static bool
+rt_should_vectorize_stack(unsigned align_mul, unsigned align_offset,
+                          unsigned bit_size, unsigned num_components,
+                          int64_t hole_size, nir_intrinsic_instr *low,
+                          nir_intrinsic_instr *high, void *data)
+{
+   const unsigned byte_size = bit_size / 8;
+
+   return hole_size <= 0 && bit_size <= 32 && num_components <= 4 &&
+          align_mul >= byte_size && align_offset % byte_size == 0;
+}
+
+/* What a stage keeps across a call goes to the frame of its activation, and
+ * the derefs of the data it is called with become relative to the offset of
+ * that data. The calls are split by nir_lower_shader_calls afterwards, or
+ * the stage is inlined in the traversal.
+ */
+static void
+rt_sep_lower_data(nir_shader *nir)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   NIR_PASS(_, nir, nir_lower_global_vars_to_local);
+   NIR_PASS(_, nir, nir_lower_vars_to_ssa);
+
+   /* The data that a stage passes to other shaders is private to it. */
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_trace_ray &&
+             intr->intrinsic != nir_intrinsic_execute_callable)
+            continue;
+
+         /* Data that the stage is called with is passed on as it is. */
+         nir_variable *data = rt_call_data(intr);
+         if (data->data.mode != nir_var_function_temp &&
+             data->data.mode != nir_var_shader_call_data_in) {
+            exec_node_remove(&data->node);
+            data->data.mode = nir_var_function_temp;
+            exec_list_push_tail(&impl->locals, &data->node);
+         }
+      }
+   }
+
+   /* The shader record buffer is global memory, also after a split. */
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic ||
+             nir_instr_as_intrinsic(instr)->intrinsic != nir_intrinsic_load_shader_record_ptr)
+            continue;
+
+         nir_foreach_use (use, &nir_instr_as_intrinsic(instr)->def) {
+            nir_instr *parent = nir_src_use_instr(use);
+            if (parent->type == nir_instr_type_deref)
+               nir_instr_as_deref(parent)->modes = nir_var_mem_global;
+         }
+      }
+   }
+   nir_fixup_deref_modes(nir);
+
+   NIR_PASS(_, nir, nir_lower_vars_to_explicit_types,
+            nir_var_function_temp | nir_var_shader_call_data_in | nir_var_ray_hit_attrib,
+            glsl_get_natural_size_align_bytes);
+
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *incoming = NULL;
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr_safe (instr, block) {
+         if (instr->type != nir_instr_type_deref)
+            continue;
+
+         nir_deref_instr *deref = nir_instr_as_deref(instr);
+         if (!nir_deref_mode_is(deref, nir_var_shader_call_data_in))
+            continue;
+
+         deref->modes = nir_var_function_temp;
+         if (deref->deref_type != nir_deref_type_var)
+            continue;
+
+         if (!incoming)
+            incoming = nir_load_rt_arg_scratch_offset_amd(&b);
+         b.cursor = nir_before_instr(&deref->instr);
+         nir_deref_instr *cast = nir_build_deref_cast(
+            &b, nir_iadd_imm(&b, incoming, deref->var->data.driver_location),
+            nir_var_function_temp, deref->var->type, 0);
+         nir_def_replace(&deref->def, &cast->def);
+      }
+   }
+
+   NIR_PASS(_, nir, nir_lower_explicit_io, nir_var_function_temp,
+            nir_address_format_32bit_offset);
+   NIR_PASS(_, nir, nir_remove_dead_variables, nir_var_function_temp, NULL);
+}
+
+/* maxRayRecursionDepth is 1, so the shaders that the traversal calls can't
+ * trace, and the ones that it inlines can't call either.
+ */
+static void
+rt_strip_calls(nir_function_impl *impl, bool callables)
+{
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr_safe (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         const nir_intrinsic_op op = nir_instr_as_intrinsic(instr)->intrinsic;
+         if (op == nir_intrinsic_trace_ray ||
+             (callables && op == nir_intrinsic_execute_callable)) {
+            nir_instr_remove(instr);
+            mesa_logw_once("rt_pipeline: calls that the shaders called by the "
+                           "traversal can't make are ignored");
+         }
+      }
+   }
+}
+
+/* The result of splitting a stage at its calls. */
+struct rt_split {
+   /* The stage, followed by one resume shader for each call. */
+   nir_shader **shaders;
+   unsigned count;
+
+   /* The stack the stage needs: the largest frame and the header after it. */
+   uint32_t stack;
+   bool has_trace;
+   unsigned instrs;
+};
+
+static void
+rt_split_stage(void *mem_ctx, nir_shader *nir, mesa_shader_stage type,
+               struct rt_split *split)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   if (type == MESA_SHADER_CLOSEST_HIT || type == MESA_SHADER_MISS)
+      rt_strip_calls(impl, false);
+
+   NIR_PASS(_, nir, nir_lower_returns);
+   rt_sep_lower_data(nir);
+
+   nir_builder b = nir_builder_create(impl);
+
+   /* The traversal doesn't have the descriptor of the acceleration structure,
+    * it gets its address.
+    */
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic ||
+             nir_instr_as_intrinsic(instr)->intrinsic != nir_intrinsic_trace_ray)
+            continue;
+
+         nir_intrinsic_instr *trace = nir_instr_as_intrinsic(instr);
+         if (nir_src_is_intrinsic(trace->src[0]) &&
+             nir_def_as_intrinsic(trace->src[0].ssa)->intrinsic ==
+                nir_intrinsic_load_vulkan_descriptor) {
+            b.cursor = nir_before_instr(instr);
+            nir_src_rewrite(&trace->src[0],
+                            tu_nir_load_tlas_address(&b, trace->src[0].ssa));
+         }
+      }
+   }
+
+   /* The end of the shader is where it returns to its caller. */
+   b.cursor = nir_after_impl(impl);
+   nir_rt_return_amd(&b);
+
+   const nir_lower_shader_calls_options opts = {
+      .address_format = nir_address_format_32bit_offset,
+      .stack_alignment = 16,
+      .localized_loads = true,
+      .vectorizer_callback = rt_should_vectorize_stack,
+   };
+   nir_shader **resumes = NULL;
+   uint32_t num_resumes = 0;
+   nir_lower_shader_calls(nir, &opts, &resumes, &num_resumes, mem_ctx);
+
+   split->count = num_resumes + 1;
+   split->shaders = rzalloc_array(mem_ctx, nir_shader *, split->count);
+   split->shaders[0] = nir;
+   if (num_resumes)
+      memcpy(split->shaders + 1, resumes, num_resumes * sizeof(*resumes));
+
+   split->stack = ALIGN_POT(nir->scratch_size, 16);
+   for (unsigned i = 0; i < split->count; i++) {
+      nir_foreach_block (block, nir_shader_get_entrypoint(split->shaders[i])) {
+         nir_foreach_instr (instr, block) {
+            split->instrs++;
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic == nir_intrinsic_rt_trace_ray ||
+                intr->intrinsic == nir_intrinsic_rt_execute_callable) {
+               split->stack = MAX2(split->stack,
+                                   nir_intrinsic_stack_size(intr) + TU_RT_STACK_HEADER);
+               split->has_trace |= intr->intrinsic == nir_intrinsic_rt_trace_ray;
+            }
+         }
+      }
+   }
+}
+
+static unsigned
+rt_sep_split(struct rt_sep *sep, unsigned index, nir_shader ***shaders)
+{
+   struct rt_link *link = sep->link;
+   struct rt_split split = {};
+
+   rt_split_stage(link->mem_ctx, nir_shader_clone(link->mem_ctx, link->nir[index]),
+                  link->stages[index].stage, &split);
+
+   *shaders = split.shaders;
+   sep->stack[index] = split.stack;
+   sep->has_trace |= split.has_trace;
+   sep->stats->split_instrs += split.instrs;
+   return split.count;
+}
+
+uint32_t
+rt_stage_stack(nir_shader *nir, mesa_shader_stage stage)
+{
+   void *mem_ctx = ralloc_context(NULL);
+   nir_shader *clone = nir_shader_clone(mem_ctx, nir);
+   uint32_t stack;
+
+   if (stage == MESA_SHADER_ANY_HIT || stage == MESA_SHADER_INTERSECTION) {
+      rt_strip_calls(nir_shader_get_entrypoint(clone), true);
+      rt_sep_lower_data(clone);
+      stack = ALIGN_POT(clone->scratch_size, 16);
+   } else {
+      struct rt_split split = {};
+      rt_split_stage(mem_ctx, clone, stage, &split);
+      stack = split.stack;
+   }
+
+   ralloc_free(mem_ctx);
+   return stack;
+}
+
+struct rt_rebase {
+   const struct rt_raygen *rg;
+
+   /* Where the scratch of the shader starts after `sp`. */
+   unsigned extra;
+};
+
+/* Make the scratch accesses of a shader relative to the stack pointer, and
+ * the offset of its incoming data too.
+ */
+static bool
+rt_rebase_scratch(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   const struct rt_rebase *state = static_cast<struct rt_rebase *>(data);
+   unsigned src;
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_scratch:
+      src = 0;
+      break;
+   case nir_intrinsic_store_scratch:
+      src = 1;
+      break;
+   case nir_intrinsic_load_rt_arg_scratch_offset_amd:
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def,
+                      nir_isub(b, nir_load_var(b, state->rg->incoming),
+                               nir_iadd_imm(b, nir_load_var(b, state->rg->sp),
+                                            state->extra)));
+      return true;
+   default:
+      return false;
+   }
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *base = nir_iadd_imm(b, nir_load_var(b, state->rg->sp), state->extra);
+   nir_src_rewrite(&intr->src[src], nir_iadd(b, base, intr->src[src].ssa));
+   return true;
+}
+
+/* Lower the builtins, the hit attributes and the returns of a shader that
+ * runs in a case or inlined in the traversal.
+ */
+static void
+rt_sep_lower_builtins(const struct rt_raygen *rg, nir_shader *nir,
+                      mesa_shader_stage stage)
+{
+   struct rt_builtins builtins = {
+      .rg = rg,
+      .committed = stage != MESA_SHADER_ANY_HIT && stage != MESA_SHADER_INTERSECTION,
+      .tmax_committed = stage != MESA_SHADER_ANY_HIT,
+      .exported = rg->aqe && (stage == MESA_SHADER_CLOSEST_HIT || stage == MESA_SHADER_MISS),
+   };
+   nir_index_ssa_defs(nir_shader_get_entrypoint(nir));
+   nir_shader_intrinsics_pass(nir, lower_rt_builtin, nir_metadata_none, &builtins);
+
+   if (stage == MESA_SHADER_CLOSEST_HIT) {
+      lower_rt_vars(nir, nir_var_ray_hit_attrib, TU_RT_SCRATCH_HIT_ATTRIB_COMMITTED);
+   } else if (stage == MESA_SHADER_ANY_HIT || stage == MESA_SHADER_INTERSECTION) {
+      lower_rt_vars(nir, nir_var_ray_hit_attrib, TU_RT_SCRATCH_HIT_ATTRIB_CAND);
+   }
+   nir_fixup_deref_modes(nir);
+}
+
+/* Push the frame of a call and the header after it, and make the data at
+ * `p` in the frame the incoming data of the callee.
+ */
+static void
+rt_sep_call(const struct rt_raygen *rg, nir_builder *b, unsigned frame,
+            nir_def *p, unsigned return_case)
+{
+   nir_def *sp = nir_load_var(b, rg->sp);
+   nir_def *header = nir_iadd_imm(b, sp, frame);
+   nir_def *record = nir_load_var(b, rg->record);
+
+   rt_stack_store(b, header, RT_HEADER_CASE, nir_imm_int(b, return_case));
+   rt_stack_store(b, header, RT_HEADER_INCOMING, nir_load_var(b, rg->incoming));
+   rt_stack_store(b, header, RT_HEADER_RECORD, nir_unpack_64_2x32_split_x(b, record));
+   rt_stack_store(b, header, RT_HEADER_RECORD + 4, nir_unpack_64_2x32_split_y(b, record));
+
+   nir_store_var(b, rg->sp, nir_iadd_imm(b, header, TU_RT_STACK_HEADER), 1);
+   nir_store_var(b, rg->incoming, nir_iadd(b, sp, p), 1);
+}
+
+/* The shader returns to the one that called it. */
+static void
+rt_sep_return(const struct rt_raygen *rg, nir_builder *b)
+{
+   nir_def *header = nir_iadd_imm(b, nir_load_var(b, rg->sp), -TU_RT_STACK_HEADER);
+
+   nir_store_var(b, rg->sp, header, 1);
+   nir_store_var(b, rg->next, rt_stack_load(b, header, RT_HEADER_CASE), 1);
+}
+
+struct rt_lower_case {
+   struct rt_sep *sep;
+   const struct rt_raygen *rg;
+   mesa_shader_stage type;
+   unsigned stage;
+   struct util_dynarray calls;
+};
+
+static bool
+lower_case_intrinsic(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   struct rt_lower_case *state = static_cast<struct rt_lower_case *>(data);
+   const struct rt_raygen *rg = state->rg;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_rt_trace_ray:
+   case nir_intrinsic_rt_execute_callable:
+      util_dynarray_append(&state->calls, intr);
+      return false;
+   case nir_intrinsic_rt_resume: {
+      /* The frame of the caller is below the header that the callee popped. */
+      nir_def *sp = nir_load_var(b, rg->sp);
+
+      nir_store_var(b, rg->incoming, rt_stack_load(b, sp, RT_HEADER_INCOMING), 1);
+      nir_store_var(b, rg->record,
+                    nir_pack_64_2x32_split(b, rt_stack_load(b, sp, RT_HEADER_RECORD),
+                                           rt_stack_load(b, sp, RT_HEADER_RECORD + 4)),
+                    1);
+      nir_store_var(b, rg->sp, nir_iadd_imm(b, sp, -(int)nir_intrinsic_stack_size(intr)), 1);
+      break;
+   }
+   case nir_intrinsic_rt_return_amd:
+      if (state->type == MESA_SHADER_RAYGEN)
+         nir_store_var(b, rg->next, nir_imm_int(b, state->sep->done), 1);
+      else
+         rt_sep_return(rg, b);
+      break;
+   default:
+      return false;
+   }
+
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+/* Whether `bytes` more of the stack in use fit in what the launch has. */
+static nir_def *
+rt_sep_fits(nir_builder *b, const struct rt_raygen *rg, unsigned bytes)
+{
+   return nir_uge(b, nir_load_scratch_base_ptr(b, 1, 32, TU_RT_UBO_STACK_LIMIT),
+                  nir_iadd_imm(b, nir_load_var(b, rg->sp), bytes));
+}
+
+static void
+lower_case_call(struct rt_lower_case *state, nir_intrinsic_instr *call)
+{
+   struct rt_sep *sep = state->sep;
+   const struct rt_raygen *rg = state->rg;
+   nir_builder b = nir_builder_at(nir_before_instr(&call->instr));
+   const unsigned resume = sep->first_case[state->stage] + 1 + nir_intrinsic_call_idx(call);
+   const unsigned frame = nir_intrinsic_stack_size(call);
+   const bool trace = call->intrinsic == nir_intrinsic_rt_trace_ray;
+
+   /* A call whose frame and header don't fit ends the ray, there is no way to
+    * continue it. What it calls checks its own frame when it starts, so the
+    * limit that the application sets only has to be big enough for the shaders
+    * that run.
+    */
+   nir_push_if(&b, rt_sep_fits(&b, rg, frame + TU_RT_STACK_HEADER));
+   if (trace) {
+      rt_sep_call(rg, &b, frame, call->src[10].ssa, resume);
+
+      nir_store_var(&b, rg->accel_struct, call->src[0].ssa, 1);
+      nir_store_var(&b, rg->ray_flags, nir_iand_imm(&b, call->src[1].ssa, 0xfff), 1);
+      nir_store_var(&b, rg->cull_mask, nir_iand_imm(&b, call->src[2].ssa, 0xff), 1);
+      nir_store_var(&b, rg->sbt_offset, nir_iand_imm(&b, call->src[3].ssa, 0xf), 1);
+      nir_store_var(&b, rg->sbt_stride, nir_iand_imm(&b, call->src[4].ssa, 0xf), 1);
+      nir_store_var(&b, rg->miss_index, nir_iand_imm(&b, call->src[5].ssa, 0xffff), 1);
+      nir_store_var(&b, rg->origin, call->src[6].ssa, 0x7);
+      nir_store_var(&b, rg->tmin, call->src[7].ssa, 1);
+      nir_store_var(&b, rg->direction, call->src[8].ssa, 0x7);
+      nir_store_var(&b, rg->tmax, call->src[9].ssa, 1);
+      nir_store_var(&b, rg->next, nir_imm_int(&b, sep->traversal), 1);
+   } else {
+      rt_sep_call(rg, &b, frame, call->src[1].ssa, resume);
+
+      nir_def *record = rt_sbt_record(&b, TU_RT_UBO_CALLABLE_SBT, call->src[0].ssa);
+      nir_store_var(&b, rg->record, nir_iadd_imm(&b, record, 32), 1);
+
+      /* A null callable returns. */
+      nir_store_var(&b, rg->next, nir_imm_int(&b, sep->ret), 1);
+      const struct rt_keys *keys = &sep->keys[MESA_SHADER_CALLABLE];
+      rt_select_id(&b, rt_record_id(&b, record, 0), keys->key, keys->count,
+                   [&](unsigned index) {
+         nir_store_var(&b, rg->next, nir_imm_int(&b, sep->first_case[index]), 1);
+      });
+   }
+   nir_push_else(&b, NULL);
+   nir_store_var(&b, rg->next, nir_imm_int(&b, sep->done), 1);
+   nir_pop_if(&b, NULL);
+
+   nir_instr_remove(&call->instr);
+}
+
+/* Get the case `index` of the scheduler ready to be inlined. */
+static nir_shader *
+rt_sep_lower_case(struct rt_sep *sep, unsigned index, struct rt_raygen *rg)
+{
+   const struct rt_case *cs = &sep->cases[index];
+   nir_shader *nir = cs->nir;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   const mesa_shader_stage type = sep->link->stages[cs->stage].stage;
+
+   rg->link = sep->link;
+   rg->aqe = sep->aqe;
+   rt_vars_create(rg, nir);
+
+   struct rt_rebase rebase = { rg, 0 };
+   nir_shader_intrinsics_pass(nir, rt_rebase_scratch, nir_metadata_none, &rebase);
+
+   struct rt_lower_case state = { sep, rg, type, cs->stage };
+   util_dynarray_init(&state.calls, NULL);
+   nir_shader_intrinsics_pass(nir, lower_case_intrinsic, nir_metadata_none, &state);
+
+   /* The shader leaves its case when a call transfers to another one. */
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type == nir_instr_type_jump &&
+             nir_instr_as_jump(instr)->type == nir_jump_halt)
+            nir_instr_as_jump(instr)->type = nir_jump_return;
+      }
+   }
+
+   util_dynarray_foreach (&state.calls, nir_intrinsic_instr *, call)
+      lower_case_call(&state, *call);
+   util_dynarray_fini(&state.calls);
+
+   rt_sep_lower_builtins(rg, nir, type);
+   nir_lower_returns(nir);
+   nir_remove_dead_variables(nir, nir_var_function_temp, NULL);
+   nir_index_ssa_defs(impl);
+   return nir;
+}
+
+static void
+rt_sep_inline_case(struct rt_sep *sep, nir_builder *b, unsigned index)
+{
+   struct rt_raygen rg = {};
+   nir_shader *nir = rt_sep_lower_case(sep, index, &rg);
+   struct hash_table *remap = rt_remap_create(&rg, &sep->rg);
+
+   /* A shader that doesn't fit when it starts ends the ray. */
+   const unsigned stage = sep->cases[index].stage;
+   const bool entry = index == sep->first_case[stage];
+   if (entry)
+      nir_push_if(b, rt_sep_fits(b, &sep->rg, sep->stack[stage]));
+   nir_inline_function_impl(b, nir_shader_get_entrypoint(nir), NULL, remap);
+   if (entry) {
+      nir_push_else(b, NULL);
+      nir_store_var(b, sep->rg.next, nir_imm_int(b, sep->done), 1);
+      nir_pop_if(b, NULL);
+   }
+   _mesa_hash_table_destroy(remap, NULL);
+}
+
+static void
+rt_sep_inline_stages(const struct rt_raygen *rg, nir_builder *b,
+                     mesa_shader_stage stage, nir_def *record, nir_def *id,
+                     const struct rt_call *callee);
+
+/* The any hit and intersection shaders run inside the traversal, with their
+ * scratch after `sp` and after the scratch of the intersection shader that
+ * calls an any hit shader.
+ */
+static void
+rt_sep_inline_hit_shader(const struct rt_raygen *caller, nir_builder *b,
+                         unsigned index, unsigned extra)
+{
+   struct rt_sep *sep = static_cast<struct rt_sep *>(caller->data);
+   const struct rt_link *link = sep->link;
+   const mesa_shader_stage stage = link->stages[index].stage;
+   nir_shader *nir = nir_shader_clone(link->mem_ctx, link->nir[index]);
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   rt_strip_calls(impl, true);
+
+   rt_sep_lower_data(nir);
+   sep->stack[index] = MAX2(sep->stack[index], ALIGN_POT(nir->scratch_size, 16));
+
+   /* The variables have to be created after the ones of the shader are
+    * lowered, which would turn them into local ones.
+    */
+   struct rt_raygen rg = *caller;
+   rt_vars_create(&rg, nir);
+
+   nir_builder bld = nir_builder_create(impl);
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr_safe (instr, block)
+         rt_lower_hit_exit(&rg, &bld, instr);
+   }
+   nir_lower_returns(nir);
+
+   struct rt_rebase rebase = { &rg, extra };
+   nir_shader_intrinsics_pass(nir, rt_rebase_scratch, nir_metadata_none, &rebase);
+   rt_sep_lower_builtins(&rg, nir, stage);
+
+   /* The any hit shader of a report runs while the intersection shader is
+    * live.
+    */
+   const struct rt_call callee = { .frame = ALIGN_POT(nir->scratch_size, 16) };
+   struct util_dynarray reports;
+   util_dynarray_init(&reports, NULL);
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type == nir_instr_type_intrinsic &&
+             nir_instr_as_intrinsic(instr)->intrinsic == nir_intrinsic_report_ray_intersection)
+            util_dynarray_append(&reports, nir_instr_as_intrinsic(instr));
+      }
+   }
+   util_dynarray_foreach (&reports, nir_intrinsic_instr *, report)
+      lower_report_intersection(&rg, impl, *report, &callee);
+   util_dynarray_fini(&reports);
+   nir_lower_returns(nir);
+   nir_remove_dead_variables(nir, nir_var_function_temp, NULL);
+   nir_index_ssa_defs(impl);
+
+   /* One that doesn't fit is skipped. */
+   struct hash_table *remap = rt_remap_create(&rg, caller);
+   nir_push_if(b, rt_sep_fits(b, caller, extra + ALIGN_POT(nir->scratch_size, 16)));
+   nir_inline_function_impl(b, impl, NULL, remap);
+   nir_pop_if(b, NULL);
+   _mesa_hash_table_destroy(remap, NULL);
+}
+
+static void
+rt_sep_inline_stages(const struct rt_raygen *rg, nir_builder *b,
+                     mesa_shader_stage stage, nir_def *record, nir_def *id,
+                     const struct rt_call *callee)
+{
+   struct rt_sep *sep = static_cast<struct rt_sep *>(rg->data);
+   const struct rt_keys *keys = &sep->keys[stage];
+   nir_def *prev_record = nir_load_var(b, rg->record);
+
+   nir_store_var(b, rg->record, nir_iadd_imm(b, record, 32), 1);
+
+   if (stage == MESA_SHADER_ANY_HIT || stage == MESA_SHADER_INTERSECTION) {
+      rt_select_id(b, id, keys->key, keys->count, [&](unsigned index) {
+         rt_sep_inline_hit_shader(rg, b, index, callee->frame);
+      });
+      nir_store_var(b, rg->record, prev_record, 1);
+   } else {
+      /* The closest hit or miss shader takes over from the traversal, and
+       * returns to what called it. The traversal selected the return before.
+       */
+      rt_select_id(b, id, keys->key, keys->count, [&](unsigned index) {
+         nir_store_var(b, rg->next, nir_imm_int(b, sep->first_case[index]), 1);
+      });
+   }
+}
+
+static void
+rt_sep_build_traversal(struct rt_sep *sep, nir_builder *b)
+{
+   const struct rt_raygen *rg = &sep->rg;
+   const struct rt_ray ray = {
+      .accel_struct = nir_load_var(b, rg->accel_struct),
+      .flags = nir_load_var(b, rg->ray_flags),
+      .cull_mask = nir_load_var(b, rg->cull_mask),
+      .sbt_offset = nir_load_var(b, rg->sbt_offset),
+      .sbt_stride = nir_load_var(b, rg->sbt_stride),
+      .miss_index = nir_load_var(b, rg->miss_index),
+      .origin = nir_load_var(b, rg->origin),
+      .tmin = nir_load_var(b, rg->tmin),
+      .direction = nir_load_var(b, rg->direction),
+      .tmax = nir_load_var(b, rg->tmax),
+   };
+   const struct rt_call callee = {};
+
+   /* Without a closest hit or miss shader to run, the trace is over. */
+   nir_store_var(b, rg->next, nir_imm_int(b, sep->ret), 1);
+   rt_build_trace(rg, b, &ray, &callee);
+}
+
+/* Split the stages that call other shaders, which makes the cases. */
+static void
+rt_sep_prepare(struct rt_sep *sep)
+{
+   struct rt_link *link = sep->link;
+
+   sep->first_case = rzalloc_array(link->mem_ctx, unsigned, link->count);
+   rt_sep_gather_keys(sep);
+
+   nir_shader ***shaders = rzalloc_array(link->mem_ctx, nir_shader **, link->count);
+   unsigned *count = rzalloc_array(link->mem_ctx, unsigned, link->count);
+   for (unsigned i = 0; i < link->count; i++) {
+      const mesa_shader_stage type = link->stages[i].stage;
+      if (link->duplicate[i] || type == MESA_SHADER_ANY_HIT ||
+          type == MESA_SHADER_INTERSECTION)
+         continue;
+
+      count[i] = rt_sep_split(sep, i, &shaders[i]);
+      sep->first_case[i] = sep->num_cases;
+      sep->num_cases += count[i];
+   }
+
+   sep->traversal = sep->num_cases;
+   sep->ret = sep->traversal + 1;
+   sep->done = sep->ret + 1;
+   sep->stats->cases = sep->done;
+
+   sep->cases = rzalloc_array(link->mem_ctx, struct rt_case, sep->num_cases);
+   for (unsigned i = 0; i < link->count; i++) {
+      for (unsigned j = 0; j < count[i]; j++)
+         sep->cases[sep->first_case[i] + j] = { shaders[i][j], i };
+   }
+}
+
+nir_shader *
+rt_build_separate(struct rt_link *link, const unsigned *raygens,
+                  unsigned num_raygens, uint32_t *stack, struct rt_stats *stats)
+{
+   struct rt_sep sep = {
+      .link = link,
+      .stats = stats,
+      .stack = stack,
+   };
+   rt_sep_prepare(&sep);
+
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, link->nir[raygens[0]]->options, "rt");
+   nir_shader *nir = b.shader;
+
+   nir->info.workgroup_size[0] = TU_RT_WORKGROUP_SIZE;
+   nir->info.workgroup_size[1] = TU_RT_WORKGROUP_SIZE;
+   nir->info.workgroup_size[2] = 1;
+   nir->info.float_controls_execution_mode = link->float_controls;
+
+   sep.rg.link = link;
+   sep.rg.inline_stages = rt_sep_inline_stages;
+   sep.rg.data = &sep;
+   rt_vars_create(&sep.rg, nir);
+   const struct rt_raygen *rg = &sep.rg;
+
+   /* The launch is rounded up to whole workgroups. */
+   nir_push_if(&b, nir_ball(&b, nir_ult(&b, nir_load_global_invocation_id(&b, 32),
+                                        rt_launch_size(&b))));
+   {
+      nir_def *record = rt_raygen_record(&b);
+
+      nir_store_var(&b, rg->sp,
+                    nir_load_scratch_base_ptr(&b, 1, 32, TU_RT_UBO_STACK_BASE), 1);
+      nir_store_var(&b, rg->incoming, nir_imm_int(&b, 0), 1);
+      nir_store_var(&b, rg->record, nir_iadd_imm(&b, record, 32), 1);
+      nir_store_var(&b, rg->next, nir_imm_int(&b, sep.done), 1);
+
+      const struct rt_keys *keys = &sep.keys[MESA_SHADER_RAYGEN];
+      rt_select_id(&b, rt_record_id(&b, record, 0), keys->key, keys->count,
+                   [&](unsigned index) {
+         nir_store_var(&b, rg->next, nir_imm_int(&b, sep.first_case[index]), 1);
+      });
+
+      nir_loop *loop = nir_push_loop(&b);
+      {
+         nir_def *cur = nir_load_var(&b, rg->next);
+
+         nir_break_if(&b, nir_ieq_imm(&b, cur, sep.done));
+         rt_select_case(&b, cur, 0, sep.done, [&](unsigned index) {
+            if (index < sep.num_cases)
+               rt_sep_inline_case(&sep, &b, index);
+            else if (index == sep.traversal && sep.has_trace)
+               rt_sep_build_traversal(&sep, &b);
+            else
+               rt_sep_return(rg, &b);
+         });
+      }
+      nir_pop_loop(&b, loop);
+   }
+   nir_pop_if(&b, NULL);
+
+   nir_index_ssa_defs(b.impl);
+   return nir;
+}
+
+/* AQE mode: the AQE firmware runs the cases as separate programs. It has a list
+ * of the threads (their IDs) that wait for each program and dispatches the
+ * program with the most, with the IDs in a list of u16 and a few constants
+ * (tu_rt_aqe_const). A program that has run enqueues each thread for the next
+ * program: it takes the slot of the program from a table, adds the thread to
+ * the count of the slot, and puts its ID in the list of the slot.
+ *
+ * The programs are [1] the traversal, [2] the starter, [3] the recycler and
+ * from [4] the cases of the stages. [0] is a NOP of the AQE.
+ *
+ * The variables that the cases of the separate mode share (RT_AQE_VARS) are in
+ * scratch0 of the thread ID. A program loads the ones it uses when it starts and
+ * stores the ones it can write when it ends. The other variables only live in
+ * one program: `next` is the one where the thread goes on, `rq` and the candidate
+ * hit are the traversal's. Scratch0 also has the launch ID and the ID of the
+ * next ray of the launch, and what the traversal exports about the committed hit
+ * to the closest hit and miss shaders, whose builtins read it (the ray query is
+ * private to the traversal):
+ *
+ *    0   sp u32, incoming u32, record u64
+ *    16  launch ID 3 x u32, ID of the next ray u32
+ *    32  the other variables
+ *    96  the committed hit (rt_aqe_exports)
+ *
+ * The stack is in scratch1, the loads and stores of the stack are made to global
+ * memory instead of private memory. The first 64 bytes of scratch1 are for the
+ * hit attributes, like the private memory of the separate mode, and the stack
+ * starts after them.
+ *
+ * Every thread that runs a program ends in exactly one of two ways: it goes
+ * to the next program, or it finishes its ray. The thread that finishes counts
+ * itself in the AQE (the `terminated` count that ends the launch) and takes
+ * over the next ID of the launch if there is one, which the recycler starts. The
+ * first dispatch of the launch is the starter, with a thread for each ray in
+ * flight. A closest hit or miss shader that is null, or skipped, never gets a
+ * dispatch: the traversal returns to the shader that called it.
+ *
+ * The AQE only sees the counts and the lists through the memory, so the
+ * atomics on them are coherent (the `coherent` bit of the instructions, as in
+ * the stock driver). The AQE does not write its table of slots through to the
+ * memory right away, a load of it returns old slots, so it is read with a
+ * coherent compare and swap that never swaps. A wave adds its threads to a
+ * count with one atomic, and enqueues those that go to the same program
+ * together: an atomic for each thread would make the launches too long for
+ * the hang detection of the kernel.
+ */
+#define RT_AQE_SCRATCH0_LAUNCH_ID 16
+#define RT_AQE_SCRATCH0_NEXT_ID 28
+#define RT_AQE_SCRATCH0_EXPORTS 96
+#define RT_AQE_TRAVERSAL 1
+#define RT_AQE_RECYCLER 3
+#define RT_AQE_FIRST_PIECE 4
+
+#define RT_AQE_VARS(X) \
+   X(sp, 0) X(incoming, 4) X(record, 8) X(accel_struct, 32) X(cull_mask, 40) \
+   X(ray_flags, 44) X(committed_hit_kind, 48) X(sbt_offset, 52) \
+   X(sbt_stride, 56) X(miss_index, 60) X(origin, 64) X(tmin, 76) \
+   X(direction, 80) X(tmax, 92)
+
+static const struct {
+   nir_variable *rt_raygen::*var;
+   unsigned offset;
+} rt_aqe_vars[] = {
+#define X(name, offset) { &rt_raygen::name, offset },
+   RT_AQE_VARS(X)
+#undef X
+};
+
+/* The committed hit that the closest hit and miss shaders read, by the ray
+ * query value that the traversal loads. The builtins of the shaders that they
+ * replace are in rt_aqe_export_field. The first is also valid for a miss.
+ */
+enum rt_aqe_export {
+   RT_AQE_EXPORT_T,
+   RT_AQE_EXPORT_CUSTOM_INDEX,
+   RT_AQE_EXPORT_INSTANCE_ID,
+   RT_AQE_EXPORT_PRIMITIVE_ID,
+   RT_AQE_EXPORT_GEOMETRY_INDEX,
+   RT_AQE_EXPORT_OBJECT_ORIGIN,
+   RT_AQE_EXPORT_OBJECT_DIRECTION,
+   RT_AQE_EXPORT_OBJECT_TO_WORLD,
+   RT_AQE_EXPORT_WORLD_TO_OBJECT,
+};
+
+static const struct {
+   nir_ray_query_value value;
+   unsigned offset, components, columns;
+} rt_aqe_exports[] = {
+   { nir_ray_query_value_intersection_t, 96, 1, 1 },
+   { nir_ray_query_value_intersection_instance_custom_index, 100, 1, 1 },
+   { nir_ray_query_value_intersection_instance_id, 104, 1, 1 },
+   { nir_ray_query_value_intersection_primitive_index, 108, 1, 1 },
+   { nir_ray_query_value_intersection_geometry_index, 112, 1, 1 },
+   { nir_ray_query_value_intersection_object_ray_origin, 116, 3, 1 },
+   { nir_ray_query_value_intersection_object_ray_direction, 128, 3, 1 },
+   { nir_ray_query_value_intersection_object_to_world, 140, 3, 4 },
+   { nir_ray_query_value_intersection_world_to_object, 188, 3, 4 },
+};
+
+enum rt_aqe_kind {
+   RT_AQE_KIND_TRAVERSAL = -3,
+   RT_AQE_KIND_STARTER = -2,
+   RT_AQE_KIND_RECYCLER = -1,
+};
+
+struct rt_aqe_state {
+   struct rt_sep *sep;
+
+   /* The addresses of scratch0 and scratch1 of the thread. */
+   nir_def *s0, *s1;
+
+   /* The variables that the program uses (RT_AQE_VARS). */
+   unsigned live;
+};
+
+static nir_def *
+rt_aqe_const(nir_builder *b, unsigned num_components, unsigned dword)
+{
+   return nir_load_const_ir3(b, num_components, 32, nir_imm_int(b, 0), .base = dword);
+}
+
+static nir_def *
+rt_aqe_const64(nir_builder *b, unsigned dword)
+{
+   return nir_pack_64_2x32(b, rt_aqe_const(b, 2, dword));
+}
+
+static int
+rt_aqe_export_field(nir_intrinsic_op op)
+{
+   switch (op) {
+   case nir_intrinsic_load_ray_t_max: return RT_AQE_EXPORT_T;
+   case nir_intrinsic_load_ray_instance_custom_index: return RT_AQE_EXPORT_CUSTOM_INDEX;
+   case nir_intrinsic_load_instance_id: return RT_AQE_EXPORT_INSTANCE_ID;
+   case nir_intrinsic_load_primitive_id: return RT_AQE_EXPORT_PRIMITIVE_ID;
+   case nir_intrinsic_load_ray_geometry_index: return RT_AQE_EXPORT_GEOMETRY_INDEX;
+   case nir_intrinsic_load_ray_object_origin: return RT_AQE_EXPORT_OBJECT_ORIGIN;
+   case nir_intrinsic_load_ray_object_direction: return RT_AQE_EXPORT_OBJECT_DIRECTION;
+   case nir_intrinsic_load_ray_object_to_world: return RT_AQE_EXPORT_OBJECT_TO_WORLD;
+   case nir_intrinsic_load_ray_world_to_object: return RT_AQE_EXPORT_WORLD_TO_OBJECT;
+   default: return -1;
+   }
+}
+
+static bool
+rt_aqe_lower_intrinsic(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   const struct rt_aqe_state *state = static_cast<struct rt_aqe_state *>(data);
+   nir_def *def;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_scratch:
+      def = nir_load_global(b, intr->def.num_components, intr->def.bit_size,
+                            nir_iadd(b, state->s1, nir_u2u64(b, intr->src[0].ssa)),
+                            .align_mul = nir_intrinsic_align_mul(intr),
+                            .align_offset = nir_intrinsic_align_offset(intr));
+      break;
+   case nir_intrinsic_store_scratch:
+      nir_store_global(b, intr->src[0].ssa,
+                       nir_iadd(b, state->s1, nir_u2u64(b, intr->src[1].ssa)),
+                       .write_mask = nir_intrinsic_write_mask(intr),
+                       .align_mul = nir_intrinsic_align_mul(intr),
+                       .align_offset = nir_intrinsic_align_offset(intr));
+      nir_instr_remove(&intr->instr);
+      return true;
+   case nir_intrinsic_load_ray_launch_id:
+      def = nir_load_global(b, 3, 32,
+                            nir_iadd_imm(b, state->s0, RT_AQE_SCRATCH0_LAUNCH_ID),
+                            .align_mul = 4);
+      break;
+   case nir_intrinsic_load_scratch_base_ptr: {
+      /* The launch UBO is the first constants, except for the launch size. */
+      unsigned dword = nir_intrinsic_base(intr);
+      if (dword >= TU_RT_UBO_LAUNCH_SIZE && dword < TU_RT_UBO_LAUNCH_SIZE + 3)
+         dword += TU_RT_AQE_LAUNCH_SIZE;
+      def = intr->def.bit_size == 64 ? rt_aqe_const64(b, dword) :
+                                       rt_aqe_const(b, 1, dword);
+      break;
+   }
+   default: {
+      /* The builtins of the closest hit and miss shaders. */
+      const int field = rt_aqe_export_field(intr->intrinsic);
+      if (field < 0)
+         return false;
+
+      const unsigned offset = rt_aqe_exports[field].offset;
+      const unsigned size = rt_aqe_exports[field].components * 4;
+      const unsigned column = rt_aqe_exports[field].columns > 1 ?
+                              nir_intrinsic_column(intr) : 0;
+
+      state->sep->exported |= BITFIELD_BIT(field);
+      def = nir_load_global(b, intr->def.num_components, 32,
+                            nir_iadd_imm(b, state->s0, offset + column * size),
+                            .align_mul = 4);
+      break;
+   }
+   }
+
+   nir_def_replace(&intr->def, def);
+   return true;
+}
+
+/* The traversal leaves the committed hit in scratch0 for the closest hit and
+ * miss shaders, the ones that they read. Only t is valid for a miss.
+ */
+static void
+rt_aqe_export_hit(struct rt_sep *sep, nir_builder *b, nir_def *s0)
+{
+   const struct rt_raygen *rg = &sep->rg;
+   nir_if *hit = NULL;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(rt_aqe_exports); i++) {
+      const auto &field = rt_aqe_exports[i];
+
+      if (!(sep->exported & BITFIELD_BIT(i)))
+         continue;
+      if (i && !hit) {
+         hit = nir_push_if(b, nir_ine_imm(b, rt_rq_load(b, rg, 1, 32,
+                                                        nir_ray_query_value_intersection_type,
+                                                        true), 0));
+      }
+      for (unsigned column = 0; column < field.columns; column++) {
+         nir_store_global(b, rt_rq_load(b, rg, field.components, 32, field.value, true,
+                                        column),
+                          nir_iadd_imm(b, s0, field.offset + column * field.components * 4),
+                          .write_mask = BITFIELD_MASK(field.components), .align_mul = 4);
+      }
+   }
+   if (hit)
+      nir_pop_if(b, hit);
+}
+
+/* The size of the state of a thread in scratch0. */
+static uint32_t
+rt_aqe_scratch0_size(unsigned exported)
+{
+   unsigned size = RT_AQE_SCRATCH0_EXPORTS;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(rt_aqe_exports); i++) {
+      if (exported & BITFIELD_BIT(i)) {
+         size = MAX2(size, rt_aqe_exports[i].offset + 4 * rt_aqe_exports[i].components *
+                                                          rt_aqe_exports[i].columns);
+      }
+   }
+   return ALIGN_POT(size, 16);
+}
+
+/* Load the variables that the program uses, and that it can write, from the
+ * state of the thread.
+ */
+static void
+rt_aqe_load_vars(nir_builder *b, const struct rt_raygen *rg,
+                 const struct rt_aqe_state *state)
+{
+   u_foreach_bit (i, state->live) {
+      nir_variable *var = rg->*rt_aqe_vars[i].var;
+      const unsigned components = glsl_get_components(var->type);
+      const unsigned bit_size = glsl_get_bit_size(var->type);
+
+      nir_store_var(b, var,
+                    nir_load_global(b, components, bit_size,
+                                    nir_iadd_imm(b, state->s0, rt_aqe_vars[i].offset),
+                                    .align_mul = bit_size / 8),
+                    BITFIELD_MASK(components));
+   }
+}
+
+/* Store the variables that the program wrote in the state of the thread. What
+ * the program reads or writes is loaded when it starts, so a variable that it
+ * writes on some paths keeps its value on the others.
+ */
+static void
+rt_aqe_store_vars(nir_builder *b, const struct rt_raygen *rg,
+                  struct rt_aqe_state *state)
+{
+   unsigned read = 0, written = 0;
+
+   nir_foreach_block (block, b->impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_load_deref &&
+             intr->intrinsic != nir_intrinsic_store_deref)
+            continue;
+
+         nir_variable *var = nir_deref_instr_get_variable(nir_src_as_deref(intr->src[0]));
+         for (unsigned i = 0; i < ARRAY_SIZE(rt_aqe_vars); i++) {
+            if (var == rg->*rt_aqe_vars[i].var) {
+               (intr->intrinsic == nir_intrinsic_load_deref ? read : written) |= BITFIELD_BIT(i);
+            }
+         }
+      }
+   }
+   state->live = read | written;
+
+   u_foreach_bit (i, written) {
+      nir_variable *var = rg->*rt_aqe_vars[i].var;
+      const unsigned components = glsl_get_components(var->type);
+
+      nir_store_global(b, nir_load_var(b, var),
+                       nir_iadd_imm(b, state->s0, rt_aqe_vars[i].offset),
+                       .write_mask = BITFIELD_MASK(components),
+                       .align_mul = glsl_get_bit_size(var->type) / 8);
+   }
+}
+
+/* The active lanes add themselves to the counter in one atomic add of the first
+ * of them, and get the value before their own part: what an atomic add of one
+ * for each lane would return.
+ */
+static nir_def *
+rt_aqe_wave_add(nir_builder *b, nir_def *counter)
+{
+   nir_def *ballot = nir_ballot(b, 4, 32, nir_imm_true(b));
+   nir_variable *base = nir_local_variable_create(b->impl, glsl_uint_type(), "base");
+
+   nir_store_var(b, base, nir_imm_int(b, 0), 1);
+   nir_push_if(b, nir_elect(b, 1));
+   {
+      nir_store_var(b, base, nir_global_atomic(b, 32, counter,
+                                               nir_ballot_bit_count_reduce(b, ballot),
+                                               .access = ACCESS_COHERENT,
+                                               .atomic_op = nir_atomic_op_iadd), 1);
+   }
+   nir_pop_if(b, NULL);
+
+   return nir_iadd(b, nir_read_first_invocation(b, nir_load_var(b, base)),
+                   nir_ballot_bit_count_exclusive(b, ballot));
+}
+
+/* The program of the thread has ended: it goes on to the next program, or it
+ * finishes its ray and starts the next one of the launch.
+ */
+static void
+rt_aqe_end_thread(struct rt_sep *sep, nir_builder *b, nir_def *id,
+                  struct rt_aqe_state *state)
+{
+   const struct rt_raygen *rg = &sep->rg;
+   nir_def *s0 = state->s0;
+
+   /* A null callable, closest hit or miss shader returns, the next program is
+    * the one that called it.
+    */
+   nir_push_if(b, nir_ieq_imm(b, nir_load_var(b, rg->next), sep->ret));
+   rt_sep_return(rg, b);
+   nir_pop_if(b, NULL);
+
+   rt_aqe_store_vars(b, rg, state);
+
+   /* The shader to enqueue the thread for, 0 for none. */
+   nir_variable *dest = nir_local_variable_create(b->impl, glsl_uint_type(), "dest");
+   nir_def *next = nir_load_var(b, rg->next);
+
+   nir_store_var(b, dest, nir_imm_int(b, 0), 1);
+   nir_push_if(b, nir_ieq_imm(b, next, sep->done));
+   {
+      nir_def *max_active = rt_aqe_const(b, 1, TU_RT_AQE_MAX_ACTIVE);
+      nir_def *k = rt_aqe_wave_add(b, rt_aqe_const64(b, TU_RT_AQE_GLOBAL_COUNTS));
+      nir_def *item = nir_iadd(b, k, max_active);
+
+      nir_push_if(b, nir_ult(b, item, rt_aqe_const(b, 1, TU_RT_AQE_CTX_THREADS)));
+      {
+         nir_store_global(b, nir_iadd(b, item, rt_aqe_const(b, 1, TU_RT_AQE_CTX_OFFSET)),
+                          nir_iadd_imm(b, s0, RT_AQE_SCRATCH0_NEXT_ID),
+                          .write_mask = 1, .align_mul = 4);
+         nir_store_var(b, dest, nir_imm_int(b, RT_AQE_RECYCLER), 1);
+      }
+      nir_pop_if(b, NULL);
+   }
+   nir_push_else(b, NULL);
+   {
+      nir_store_var(b, dest, nir_bcsel(b, nir_ieq_imm(b, next, sep->traversal),
+                                       nir_imm_int(b, RT_AQE_TRAVERSAL),
+                                       nir_iadd_imm(b, next, RT_AQE_FIRST_PIECE)), 1);
+   }
+   nir_pop_if(b, NULL);
+
+   /* The lanes that go to the same program are enqueued together. */
+   nir_def *shader = nir_load_var(b, dest);
+   nir_push_if(b, nir_ine_imm(b, shader, 0));
+   {
+      nir_loop *loop = nir_push_loop(b);
+      nir_push_if(b, nir_ieq(b, shader, nir_read_first_invocation(b, shader)));
+      {
+         /* The AQE writes the table when it dispatches a program, a load of it
+          * can return the slot from before. A compare and swap that never
+          * swaps reads the current one.
+          */
+         nir_variable *slot_var = nir_local_variable_create(b->impl, glsl_uint_type(), "slot");
+         nir_store_var(b, slot_var, nir_imm_int(b, 0), 1);
+         nir_push_if(b, nir_elect(b, 1));
+         {
+            nir_store_var(b, slot_var, nir_global_atomic_swap(
+               b, 32,
+               nir_iadd(b, rt_aqe_const64(b, TU_RT_AQE_SHADER_TO_SLOT),
+                        nir_u2u64(b, nir_imul_imm(b, shader, 4))),
+               nir_imm_int(b, UINT32_MAX), nir_imm_int(b, UINT32_MAX),
+               .access = ACCESS_COHERENT, .atomic_op = nir_atomic_op_cmpxchg), 1);
+         }
+         nir_pop_if(b, NULL);
+
+         nir_def *slot = nir_read_first_invocation(b, nir_load_var(b, slot_var));
+         nir_def *list = nir_iadd(
+            b, rt_aqe_const64(b, TU_RT_AQE_PENDING),
+            nir_umul_2x32_64(b, slot, rt_aqe_const(b, 1, TU_RT_AQE_PENDING_STRIDE)));
+
+         /* The AQE can dispatch the thread as soon as it is counted, so the ID
+          * has to be stored right after.
+          */
+         nir_def *index = rt_aqe_wave_add(
+            b, nir_iadd(b, rt_aqe_const64(b, TU_RT_AQE_COUNTS),
+                        nir_u2u64(b, nir_imul_imm(b, slot, 4))));
+         nir_store_global(b, nir_u2u16(b, id),
+                          nir_iadd(b, list, nir_u2u64(b, nir_imul_imm(b, index, 2))),
+                          .write_mask = 1, .align_mul = 2);
+         nir_jump(b, nir_jump_break);
+      }
+      nir_pop_if(b, NULL);
+      nir_pop_loop(b, loop);
+   }
+   nir_pop_if(b, NULL);
+
+   /* Everything the thread wrote has to be visible to the AQE, which reads the
+    * counts when the dispatch is over, and to the other programs.
+    */
+   nir_barrier(b, .memory_scope = SCOPE_DEVICE, .memory_semantics = NIR_MEMORY_ACQ_REL,
+               .memory_modes = nir_var_mem_global);
+}
+
+/* The starter and the recycler start the ray of the thread with the next ID of
+ * the launch: they set the state of the thread and go on to its raygen shader.
+ * The linear ID is the thread for the starter, the one that the thread that
+ * finished left in its state for the recycler.
+ */
+static void
+rt_aqe_start_ray(struct rt_sep *sep, nir_builder *b, nir_def *linear, nir_def *s0)
+{
+   const struct rt_raygen *rg = &sep->rg;
+   const struct rt_keys *keys = &sep->keys[MESA_SHADER_RAYGEN];
+
+   nir_def *size = rt_launch_size(b);
+   nir_def *width = nir_channel(b, size, 0);
+   nir_def *height = nir_channel(b, size, 1);
+
+   nir_def *row = nir_udiv(b, linear, width);
+   nir_def *layer = nir_udiv(b, row, height);
+   nir_def *launch_id = nir_vec3(b, nir_isub(b, linear, nir_imul(b, row, width)),
+                                 nir_isub(b, row, nir_imul(b, layer, height)), layer);
+   nir_store_global(b, launch_id, nir_iadd_imm(b, s0, RT_AQE_SCRATCH0_LAUNCH_ID),
+                    .write_mask = 0x7, .align_mul = 4);
+
+   nir_def *record = rt_raygen_record(b);
+
+   nir_store_var(b, rg->sp, nir_imm_int(b, TU_RT_SCRATCH_STACK), 1);
+   nir_store_var(b, rg->incoming, nir_imm_int(b, 0), 1);
+   nir_store_var(b, rg->record, nir_iadd_imm(b, record, 32), 1);
+   rt_select_id(b, rt_record_id(b, record, 0), keys->key, keys->count,
+                [&](unsigned index) {
+      nir_store_var(b, rg->next, nir_imm_int(b, sep->first_case[index]), 1);
+   });
+}
+
+/* The program for the case `index` of the stages, or the traversal, the starter
+ * or the recycler.
+ */
+static nir_shader *
+rt_aqe_build_piece(struct rt_sep *sep, int index)
+{
+   const struct rt_link *link = sep->link;
+   const bool traversal = index == RT_AQE_KIND_TRAVERSAL;
+   const bool starter = index == RT_AQE_KIND_STARTER;
+   const bool recycler = index == RT_AQE_KIND_RECYCLER;
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, sep->options,
+                                                  traversal ? "rt_aqe_traversal" :
+                                                  starter ? "rt_aqe_starter" :
+                                                  recycler ? "rt_aqe_recycler" :
+                                                             "rt_aqe_%s",
+                                                  index >= 0 ?
+                                                  mesa_shader_stage_name(link->stages[sep->cases[index].stage].stage) :
+                                                  "");
+   nir_shader *nir = b.shader;
+   struct rt_raygen *rg = &sep->rg;
+   struct rt_aqe_state state = { sep };
+   nir_cursor entry;
+
+   nir->info.workgroup_size[0] = 64;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+   nir->info.float_controls_execution_mode = link->float_controls;
+
+   rg->link = link;
+   rg->aqe = true;
+   rg->inline_stages = rt_sep_inline_stages;
+   rg->data = sep;
+   rt_vars_create(rg, nir);
+
+   /* The dispatches are rounded up to whole workgroups. The AQE starts the
+    * launch with the number of threads that it also writes to c16.
+    */
+   nir_def *tid = nir_iadd(&b, nir_imul_imm(&b, nir_channel(&b, nir_load_workgroup_id(&b), 0), 64),
+                           nir_channel(&b, nir_load_local_invocation_id(&b), 0));
+   nir_def *bound = starter ?
+      nir_umin(&b, rt_aqe_const(&b, 1, TU_RT_AQE_MAX_ACTIVE),
+               rt_aqe_const(&b, 1, TU_RT_AQE_CTX_THREADS)) :
+      rt_aqe_const(&b, 1, TU_RT_AQE_NUM);
+
+   nir_push_if(&b, nir_ult(&b, tid, bound));
+   {
+      /* The starter has no list of IDs, its IDs are the threads. */
+      nir_def *id = tid;
+      if (!starter) {
+         id = nir_u2u32(&b, nir_load_global(&b, 1, 16,
+                                            nir_iadd(&b, rt_aqe_const64(&b, TU_RT_AQE_IDS),
+                                                     nir_u2u64(&b, nir_imul_imm(&b, tid, 2))),
+                                            .align_mul = 2));
+      }
+
+      state.s0 = nir_iadd(&b, rt_aqe_const64(&b, TU_RT_AQE_SCRATCH0),
+                          nir_umul_2x32_64(&b, id, rt_aqe_const(&b, 1, TU_RT_AQE_SCRATCH0_STRIDE)));
+      state.s1 = nir_iadd(&b, rt_aqe_const64(&b, TU_RT_AQE_SCRATCH1),
+                          nir_umul_2x32_64(&b, id, rt_aqe_const(&b, 1, TU_RT_AQE_SCRATCH1_STRIDE)));
+
+      /* A path of a case that does not say where to go on ends the ray. */
+      nir_store_var(&b, rg->next, nir_imm_int(&b, sep->done), 1);
+      entry = b.cursor;
+
+      if (starter) {
+         rt_aqe_start_ray(sep, &b, nir_iadd(&b, tid, rt_aqe_const(&b, 1, TU_RT_AQE_CTX_OFFSET)),
+                          state.s0);
+      } else if (recycler) {
+         rt_aqe_start_ray(sep, &b,
+                          nir_load_global(&b, 1, 32, nir_iadd_imm(&b, state.s0, RT_AQE_SCRATCH0_NEXT_ID),
+                                          .align_mul = 4),
+                          state.s0);
+      } else if (traversal) {
+         /* A pipeline that does not trace has nothing to run in it. */
+         if (sep->has_trace) {
+            rt_sep_build_traversal(sep, &b);
+            rt_aqe_export_hit(sep, &b, state.s0);
+         }
+      } else {
+         rt_sep_inline_case(sep, &b, index);
+      }
+
+      rt_aqe_end_thread(sep, &b, id, &state);
+   }
+   nir_pop_if(&b, NULL);
+
+   nir_builder entry_b = nir_builder_at(entry);
+   rt_aqe_load_vars(&entry_b, rg, &state);
+
+   nir_shader_intrinsics_pass(nir, rt_aqe_lower_intrinsic, nir_metadata_none, &state);
+   nir_index_ssa_defs(b.impl);
+   return nir;
+}
+
+nir_shader **
+rt_build_aqe(struct rt_link *link, const unsigned *raygens, unsigned num_raygens,
+             uint32_t *stack, struct rt_stats *stats, unsigned *count,
+             uint32_t *scratch0_size)
+{
+   struct rt_sep sep = {
+      .link = link,
+      .stats = stats,
+      .stack = stack,
+      .aqe = true,
+      .options = link->nir[raygens[0]]->options,
+   };
+   rt_sep_prepare(&sep);
+
+   *count = sep.num_cases + 3;
+   nir_shader **pieces = rzalloc_array(link->mem_ctx, nir_shader *, *count);
+
+   pieces[1] = rt_aqe_build_piece(&sep, RT_AQE_KIND_STARTER);
+   pieces[2] = rt_aqe_build_piece(&sep, RT_AQE_KIND_RECYCLER);
+   for (unsigned i = 0; i < sep.num_cases; i++)
+      pieces[3 + i] = rt_aqe_build_piece(&sep, i);
+
+   /* The traversal exports what the closest hit and miss shaders read, which
+    * is known when they are built.
+    */
+   pieces[0] = rt_aqe_build_piece(&sep, RT_AQE_KIND_TRAVERSAL);
+   *scratch0_size = rt_aqe_scratch0_size(sep.exported);
+
+   return pieces;
+}
