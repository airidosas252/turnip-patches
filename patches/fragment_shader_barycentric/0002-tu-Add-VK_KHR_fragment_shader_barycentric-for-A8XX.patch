diff --git a/src/freedreno/vulkan/tu_nir_lower_fs_barycentric.cc b/src/freedreno/vulkan/tu_nir_lower_fs_barycentric.cc
new file mode 100644
index 00000000000..85f0528d436
--- /dev/null
+++ b/src/freedreno/vulkan/tu_nir_lower_fs_barycentric.cc
@@ -0,0 +1,517 @@
+/*
+ * Copyright © 2026 Turnip contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nir/nir_builder.h"
+#include "nir/nir_xfb_info.h"
+
+#include "tu_shader.h"
+
+struct bary_map {
+   uint8_t lo_slot, lo_comp, hi_slot, hi_comp;
+};
+
+struct bary_state {
+   nir_shader *producer;
+   nir_shader *fs;
+   nir_builder entry;
+
+   uint64_t free_slots;
+   unsigned smooth_slot;
+   unsigned smooth_comp;
+   bool failed;
+
+   uint64_t per_vertex_only;
+   uint64_t remove;
+   unsigned id_flat_slot;
+   struct bary_map id;
+   nir_def *rot, *is_line, *is_point;
+
+   struct bary_map map[NUM_TOTAL_VARYING_SLOTS][4];
+   bool mapped[NUM_TOTAL_VARYING_SLOTS][4];
+};
+
+static unsigned
+take_slot(struct bary_state *s)
+{
+   if (!s->free_slots) {
+      s->failed = true;
+      return VARYING_SLOT_VAR0;
+   }
+
+   unsigned slot = util_last_bit64(s->free_slots) - 1;
+   s->free_slots &= ~BITFIELD64_BIT(slot);
+   return slot;
+}
+
+static void
+alloc_smooth(struct bary_state *s, uint8_t *slot, uint8_t *comp)
+{
+   if (!s->smooth_slot || s->smooth_comp == 4) {
+      s->smooth_slot = take_slot(s);
+      s->smooth_comp = 0;
+   }
+
+   *slot = s->smooth_slot;
+   *comp = s->smooth_comp++;
+}
+
+static nir_def *
+load_flat(nir_builder *b, unsigned slot)
+{
+   return nir_load_input(b, 1, 32, nir_imm_int(b, 0),
+                         .base = 0, .component = 0,
+                         .dest_type = nir_type_uint32,
+                         .io_semantics = { .location = slot, .num_slots = 1 });
+}
+
+static nir_def *
+load_hw_vertex(nir_builder *b, unsigned slot, unsigned comp, unsigned vertex)
+{
+   nir_def *ij = nir_imm_vec2(b, vertex == 1, vertex == 2);
+   return nir_load_interpolated_input(b, 1, 32, ij, nir_imm_int(b, 0),
+                                      .base = 0, .component = comp,
+                                      .dest_type = nir_type_float32,
+                                      .io_semantics = { .location = slot, .num_slots = 1 });
+}
+
+static void
+store_smooth(nir_builder *b, nir_def *val, unsigned slot, unsigned comp)
+{
+   nir_store_output(b, val, nir_imm_int(b, 0), .base = 0, .write_mask = 1,
+                    .component = comp, .src_type = nir_type_float32,
+                    .io_semantics = { .location = slot, .num_slots = 1 });
+}
+
+static nir_def *
+load_hw_dword(nir_builder *b, const struct bary_map *m, unsigned vertex)
+{
+   nir_def *lo = nir_f2u32(b, load_hw_vertex(b, m->lo_slot, m->lo_comp, vertex));
+   nir_def *hi = nir_f2u32(b, load_hw_vertex(b, m->hi_slot, m->hi_comp, vertex));
+   return nir_ior(b, nir_ishl_imm(b, hi, 16), lo);
+}
+
+static void
+init_primitive(struct bary_state *s)
+{
+   if (s->rot)
+      return;
+
+   nir_builder *b = &s->entry;
+   nir_def *pv = load_flat(b, s->id_flat_slot);
+   nir_def *h[3];
+   for (unsigned i = 0; i < 3; i++)
+      h[i] = load_hw_dword(b, &s->id, i);
+
+   nir_def *eq10 = nir_ieq(b, h[1], h[0]);
+   nir_def *eq20 = nir_ieq(b, h[2], h[0]);
+   s->is_point = nir_iand(b, eq10, eq20);
+   s->is_line = eq20;
+   nir_def *k = nir_bcsel(b, nir_ieq(b, pv, h[0]), nir_imm_int(b, 0),
+                          nir_bcsel(b, nir_ieq(b, pv, h[1]), nir_imm_int(b, 1),
+                                    nir_imm_int(b, 2)));
+   nir_def *last = nir_ine_imm(b, nir_load_provoking_last(b), 0);
+   nir_def *off = nir_iadd(b, k, nir_b2i32(b, last));
+   s->rot = nir_bcsel(b, nir_uge_imm(b, off, 3), nir_iadd_imm(b, off, -3), off);
+}
+
+static nir_def *
+hw_vertex(struct bary_state *s, nir_builder *b, nir_def *k)
+{
+   nir_def *sum = nir_iadd(b, k, s->rot);
+   nir_def *tri = nir_bcsel(b, nir_uge_imm(b, sum, 3), nir_iadd_imm(b, sum, -3), sum);
+   nir_def *line = nir_umin(b, k, nir_imm_int(b, 1));
+
+   return nir_bcsel(b, s->is_point, nir_imm_int(b, 0),
+                    nir_bcsel(b, s->is_line, line, tri));
+}
+
+static nir_def *
+select3(nir_builder *b, nir_def *idx, nir_def *v0, nir_def *v1, nir_def *v2)
+{
+   return nir_bcsel(b, nir_ieq_imm(b, idx, 0), v0,
+                    nir_bcsel(b, nir_ieq_imm(b, idx, 1), v1, v2));
+}
+
+static nir_def *
+lower_coord(struct bary_state *s, nir_builder *b, nir_intrinsic_instr *intr)
+{
+   const enum glsl_interp_mode mode = (enum glsl_interp_mode)nir_intrinsic_interp_mode(intr);
+   nir_def *ij;
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_barycentric_coord_pixel:
+      ij = nir_load_barycentric_pixel(b, 32, .interp_mode = mode);
+      break;
+   case nir_intrinsic_load_barycentric_coord_centroid:
+      ij = nir_load_barycentric_centroid(b, 32, .interp_mode = mode);
+      break;
+   case nir_intrinsic_load_barycentric_coord_sample:
+      ij = nir_load_barycentric_sample(b, 32, .interp_mode = mode);
+      break;
+   case nir_intrinsic_load_barycentric_coord_at_offset:
+      ij = nir_load_barycentric_at_offset(b, 32, intr->src[0].ssa, .interp_mode = mode);
+      break;
+   default: {
+      assert(intr->intrinsic == nir_intrinsic_load_barycentric_coord_at_sample);
+      nir_def *pos = nir_load_sample_pos_from_id(b, 32, intr->src[0].ssa);
+      ij = nir_load_barycentric_at_offset(b, 32, nir_fadd_imm(b, pos, -0.5f),
+                                          .interp_mode = mode);
+      break;
+   }
+   }
+
+   init_primitive(s);
+
+   nir_def *i = nir_channel(b, ij, 0);
+   nir_def *j = nir_channel(b, ij, 1);
+   nir_def *zero = nir_imm_float(b, 0.0f);
+   nir_def *w0 = nir_fsub(b, nir_fsub_imm(b, 1.0f, i), j);
+
+   nir_def *chan[3];
+   nir_def *tri[3] = { select3(b, s->rot, w0, i, j), select3(b, s->rot, i, j, w0),
+                       select3(b, s->rot, j, w0, i) };
+   nir_def *line[3] = { nir_fsub_imm(b, 1.0f, i), i, zero };
+   nir_def *point[3] = { nir_imm_float(b, 1.0f), zero, zero };
+
+   for (unsigned k = 0; k < 3; k++) {
+      chan[k] = nir_bcsel(b, s->is_point, point[k],
+                          nir_bcsel(b, s->is_line, line[k], tri[k]));
+   }
+
+   return nir_vec(b, chan, 3);
+}
+
+static nir_def *
+read_vertex(struct bary_state *s, nir_builder *b, unsigned slot, unsigned comp,
+            nir_def *vertex)
+{
+   struct bary_map *m = &s->map[slot][comp];
+
+   if (!s->mapped[slot][comp]) {
+      alloc_smooth(s, &m->lo_slot, &m->lo_comp);
+      alloc_smooth(s, &m->hi_slot, &m->hi_comp);
+      s->mapped[slot][comp] = true;
+   }
+
+   init_primitive(s);
+
+   nir_def *v[3];
+   nir_builder *e = &s->entry;
+   for (unsigned i = 0; i < 3; i++)
+      v[i] = load_hw_dword(e, m, i);
+
+   return select3(b, hw_vertex(s, b, vertex), v[0], v[1], v[2]);
+}
+
+static bool
+lower_fs(struct bary_state *s)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(s->fs);
+   nir_builder bld = nir_builder_create(impl), *b = &bld;
+   bool progress = false;
+
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr_safe (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         nir_def *res;
+
+         b->cursor = nir_before_instr(instr);
+
+         switch (intr->intrinsic) {
+         case nir_intrinsic_load_barycentric_coord_pixel:
+         case nir_intrinsic_load_barycentric_coord_centroid:
+         case nir_intrinsic_load_barycentric_coord_sample:
+         case nir_intrinsic_load_barycentric_coord_at_offset:
+         case nir_intrinsic_load_barycentric_coord_at_sample:
+            res = lower_coord(s, b, intr);
+            break;
+         case nir_intrinsic_load_input_vertex: {
+            if (intr->def.bit_size != 32 || !nir_src_is_const(intr->src[1])) {
+               s->failed = true;
+               return false;
+            }
+
+            unsigned slot = nir_intrinsic_io_semantics(intr).location +
+                            nir_src_as_uint(intr->src[1]);
+            unsigned comp = nir_intrinsic_component(intr);
+            nir_def *chan[NIR_MAX_VEC_COMPONENTS];
+
+            for (unsigned i = 0; i < intr->def.num_components; i++)
+               chan[i] = read_vertex(s, b, slot, comp + i, intr->src[0].ssa);
+
+            res = nir_vec(b, chan, intr->def.num_components);
+            break;
+         }
+         default:
+            continue;
+         }
+
+         nir_def_replace(&intr->def, res);
+         progress = true;
+      }
+   }
+
+   return progress;
+}
+
+static void
+store_dword(nir_builder *b, nir_def *val, const struct bary_map *m)
+{
+   store_smooth(b, nir_u2f32(b, nir_iand_imm(b, val, 0xffff)), m->lo_slot, m->lo_comp);
+   store_smooth(b, nir_u2f32(b, nir_ushr_imm(b, val, 16)), m->hi_slot, m->hi_comp);
+}
+
+static void
+store_ids(struct bary_state *s, nir_builder *b, nir_def *id)
+{
+   nir_store_output(b, id, nir_imm_int(b, 0), .base = 0, .write_mask = 1,
+                    .component = 0, .src_type = nir_type_uint32,
+                    .io_semantics = { .location = s->id_flat_slot, .num_slots = 1 });
+   store_dword(b, id, &s->id);
+}
+
+static void
+lower_producer(struct bary_state *s)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(s->producer);
+   nir_builder bld = nir_builder_create(impl), *b = &bld;
+   nir_variable *emitted = NULL;
+   struct util_dynarray orig;
+
+   util_dynarray_init(&orig, NULL);
+
+   if (s->producer->info.stage == MESA_SHADER_GEOMETRY) {
+      emitted = nir_local_variable_create(impl, glsl_uint_type(), "bary_id");
+      b->cursor = nir_before_impl(impl);
+      nir_store_var(b, emitted, nir_imm_int(b, 0), 0x1);
+   }
+
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type == nir_instr_type_intrinsic)
+            util_dynarray_append(&orig, instr);
+      }
+   }
+
+   util_dynarray_foreach (&orig, nir_instr *, p) {
+      nir_instr *instr = *p;
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+
+      if (intr->intrinsic == nir_intrinsic_emit_vertex) {
+         b->cursor = nir_before_instr(instr);
+         nir_def *id = nir_load_var(b, emitted);
+         store_ids(s, b, id);
+         nir_store_var(b, emitted, nir_iadd_imm(b, id, 1), 0x1);
+         continue;
+      }
+
+      if (intr->intrinsic != nir_intrinsic_store_output ||
+          !nir_src_is_const(intr->src[1]))
+         continue;
+
+      unsigned slot = nir_intrinsic_io_semantics(intr).location +
+                      nir_src_as_uint(intr->src[1]);
+      if (slot >= NUM_TOTAL_VARYING_SLOTS)
+         continue;
+
+      b->cursor = nir_after_instr(instr);
+
+      u_foreach_bit(i, nir_intrinsic_write_mask(intr)) {
+         unsigned comp = nir_intrinsic_component(intr) + i;
+         if (comp >= 4 || !s->mapped[slot][comp])
+            continue;
+
+         store_dword(b, nir_channel(b, intr->src[0].ssa, i), &s->map[slot][comp]);
+      }
+
+      if (slot < 64 && (s->remove & BITFIELD64_BIT(slot)))
+         nir_instr_remove(instr);
+   }
+
+   util_dynarray_fini(&orig);
+
+   if (emitted)
+      return;
+
+   b->cursor = nir_after_impl(impl);
+   nir_def *id;
+   if (s->producer->info.stage == MESA_SHADER_TESS_EVAL) {
+      nir_def *tc = nir_f2u32(b, nir_fadd_imm(b, nir_fmul_imm(b, nir_load_tess_coord_xy(b), 65535.0f), 0.5f));
+      id = nir_ior(b, nir_channel(b, tc, 0), nir_ishl_imm(b, nir_channel(b, tc, 1), 16));
+   } else {
+      id = nir_load_vertex_id(b);
+   }
+   store_ids(s, b, id);
+}
+
+bool
+tu_nir_fs_uses_barycentric(nir_shader *fs)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(fs);
+
+   nir_foreach_shader_in_variable (var, fs) {
+      if (var->data.per_vertex)
+         return true;
+   }
+
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+         case nir_intrinsic_load_input_vertex:
+         case nir_intrinsic_load_barycentric_coord_pixel:
+         case nir_intrinsic_load_barycentric_coord_centroid:
+         case nir_intrinsic_load_barycentric_coord_sample:
+         case nir_intrinsic_load_barycentric_coord_at_offset:
+         case nir_intrinsic_load_barycentric_coord_at_sample:
+            return true;
+         default:
+            break;
+         }
+      }
+   }
+
+   return false;
+}
+
+static uint64_t
+per_vertex_only_slots(nir_shader *fs)
+{
+   uint64_t vertex = 0, other = 0;
+
+   nir_foreach_block (block, nir_shader_get_entrypoint(fs)) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_load_input_vertex &&
+             intr->intrinsic != nir_intrinsic_load_input &&
+             intr->intrinsic != nir_intrinsic_load_interpolated_input)
+            continue;
+
+         nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+         unsigned first = sem.location;
+         unsigned last = sem.location;
+         if (nir_src_is_const(*nir_get_io_offset_src(intr)))
+            first = last = sem.location + nir_src_as_uint(*nir_get_io_offset_src(intr));
+         else
+            last = sem.location + sem.num_slots - 1;
+
+         for (unsigned slot = first; slot <= last && slot < 64; slot++) {
+            if (intr->intrinsic == nir_intrinsic_load_input_vertex)
+               vertex |= BITFIELD64_BIT(slot);
+            else
+               other |= BITFIELD64_BIT(slot);
+         }
+      }
+   }
+
+   return vertex & ~other;
+}
+
+bool
+tu_nir_lower_fs_barycentric(nir_shader *fs, uint64_t reserved,
+                            struct tu_bary_request *req)
+{
+   memset(req, 0, sizeof(*req));
+
+   if (!tu_nir_fs_uses_barycentric(fs))
+      return true;
+
+   nir_shader_gather_info(fs, nir_shader_get_entrypoint(fs));
+
+   struct bary_state *s = rzalloc(NULL, struct bary_state);
+   s->fs = fs;
+   s->entry = nir_builder_at(nir_before_impl(nir_shader_get_entrypoint(fs)));
+   s->per_vertex_only = BITFIELD64_RANGE(VARYING_SLOT_VAR0, 32) & per_vertex_only_slots(fs);
+   s->free_slots = (BITFIELD64_RANGE(VARYING_SLOT_VAR0, 32) &
+                    ~(fs->info.inputs_read | reserved)) | s->per_vertex_only;
+
+   alloc_smooth(s, &s->id.lo_slot, &s->id.lo_comp);
+   alloc_smooth(s, &s->id.hi_slot, &s->id.hi_comp);
+   s->id_flat_slot = take_slot(s);
+
+   lower_fs(s);
+   bool ok = !s->failed;
+   if (ok) {
+      req->per_vertex_only = s->per_vertex_only;
+      req->id_flat_slot = s->id_flat_slot;
+      req->id[0] = s->id.lo_slot;
+      req->id[1] = s->id.lo_comp;
+      req->id[2] = s->id.hi_slot;
+      req->id[3] = s->id.hi_comp;
+
+      for (unsigned slot = 0; slot < NUM_TOTAL_VARYING_SLOTS; slot++) {
+         for (unsigned comp = 0; comp < 4; comp++) {
+            if (!s->mapped[slot][comp])
+               continue;
+            if (req->count == TU_BARY_MAX_MAPPED) {
+               ok = false;
+               continue;
+            }
+            const struct bary_map *m = &s->map[slot][comp];
+            req->map[req->count++] = {
+               (uint8_t)slot, (uint8_t)comp, m->lo_slot, m->lo_comp,
+               m->hi_slot, m->hi_comp,
+            };
+         }
+      }
+   }
+
+   if (ok) {
+      nir_progress(true, nir_shader_get_entrypoint(fs), nir_metadata_none);
+      nir_shader_gather_info(fs, nir_shader_get_entrypoint(fs));
+      nir_recompute_io_bases(fs, nir_var_shader_in);
+   }
+
+   ralloc_free(s);
+   return ok;
+}
+
+bool
+tu_nir_lower_producer_barycentric(nir_shader *producer,
+                                  const struct tu_bary_request *req)
+{
+   struct bary_state *s = rzalloc(NULL, struct bary_state);
+   s->producer = producer;
+   s->id_flat_slot = req->id_flat_slot;
+   s->id = { req->id[0], req->id[1], req->id[2], req->id[3] };
+   s->remove = req->per_vertex_only | BITFIELD64_BIT(req->id_flat_slot) |
+               BITFIELD64_BIT(req->id[0]) | BITFIELD64_BIT(req->id[2]);
+
+   for (unsigned i = 0; i < req->count; i++) {
+      s->map[req->map[i].slot][req->map[i].comp] = {
+         req->map[i].lo_slot, req->map[i].lo_comp,
+         req->map[i].hi_slot, req->map[i].hi_comp,
+      };
+      s->mapped[req->map[i].slot][req->map[i].comp] = true;
+      s->remove |= BITFIELD64_BIT(req->map[i].lo_slot) |
+                   BITFIELD64_BIT(req->map[i].hi_slot);
+   }
+
+   bool ok = true;
+   if (producer->xfb_info) {
+      for (unsigned i = 0; i < producer->xfb_info->output_count; i++) {
+         if (s->remove & BITFIELD64_BIT(producer->xfb_info->outputs[i].location))
+            ok = false;
+      }
+   }
+
+   if (ok) {
+      lower_producer(s);
+      nir_progress(true, nir_shader_get_entrypoint(producer), nir_metadata_none);
+      nir_shader_gather_info(producer, nir_shader_get_entrypoint(producer));
+      nir_recompute_io_bases(producer, nir_var_shader_out);
+   }
+
+   ralloc_free(s);
+   return ok;
+}
