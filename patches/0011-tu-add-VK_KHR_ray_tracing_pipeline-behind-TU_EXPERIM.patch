+/* The IB that the AQE runs before it dispatches a ray tracing program: the
+ * registers of the program, like the ones of the stock driver, and after them
+ * the constants it loads from its binary. The AQE writes the rest of the
+ * compute state (the dimensions and c12..c17) itself.
+ */
+template <chip CHIP>
+static void
+tu6_emit_rt_aqe_ib(struct tu_cs *cs, const struct ir3_shader_variant *v,
+                   const struct tu_pvtmem_config *pvtmem, uint64_t binary_iova)
+{
+   const enum a6xx_threadsize thrsz = v->info.double_threadsize ? THREAD128 : THREAD64;
+   const uint32_t shared_size = MAX2((static_cast<int>(v->shared_size) - 1) / 1024, 1);
+   const enum a6xx_const_ram_mode mode =
+      v->constlen > 256 ? CONSTLEN_512 :
+      (v->constlen > 192 ? CONSTLEN_256 :
+      (v->constlen > 128 ? CONSTLEN_192 : CONSTLEN_128));
+
+   with_crb (cs) {
+      /* No early preamble, like the stock driver: with one the waves of a
+       * dispatch with more than two workgroups can see preamble results
+       * computed from the other context's c12..c17. An early preamble is
+       * also valid as a normal one.
+       */
+      crb.add(A6XX_SP_CS_CNTL_0(.halfregfootprint = v->info.max_half_reg + 1,
+                                .fullregfootprint = v->info.max_reg + 1,
+                                .branchstack = ir3_shader_branchstack_hw(v),
+                                .threadsize = thrsz,
+                                .earlypreamble = false,
+                                .mergedregs = v->mergedregs));
+      crb.add(A6XX_SP_CS_CNTL_1(.shared_size = shared_size,
+                                .constantrammode = mode));
+      crb.add({ REG_A6XX_SP_CS_BOOLEAN_CF_MASK, 0, false });
+      crb.add(A6XX_SP_CS_PROGRAM_COUNTER_OFFSET(0));
+      crb.add(A6XX_SP_CS_BASE(.qword = binary_iova));
+      crb.add(A6XX_SP_CS_PVT_MEM_PARAM(.memsizeperitem = pvtmem->per_fiber_size));
+      crb.add(A6XX_SP_CS_PVT_MEM_SIZE(.totalpvtmemsize = pvtmem->per_sp_size,
+                                      .perwavememlayout = v->pvtmem_per_wave));
+      crb.add(A6XX_SP_CS_PVT_MEM_STACK_OFFSET(.offset = pvtmem->per_sp_size));
+      if (pvtmem->iova)
+         crb.add(A6XX_SP_CS_PVT_MEM_BASE(.qword = pvtmem->iova));
+      tu6_emit_xs_config<CHIP>(crb, { .cs = v });
+
+      /* The instruction fetch of the programs that the AQE runs hangs if the
+       * program ends exactly where this size does, one more unit is enough.
+       */
+      crb.add(A6XX_SP_CS_INSTR_SIZE(v->instrlen + 1));
+      crb.add(SP_CS_HYSTERESIS(CHIP, 0));
+      crb.add(A6XX_SP_CS_WIE_CNTL_0(
+         .wgidconstid = ir3_find_sysval_regid(v, SYSTEM_VALUE_WORKGROUP_ID),
+         .wgsizeconstid = regid(63, 0), .wgoffsetconstid = regid(63, 0),
+         .localidregid = ir3_find_sysval_regid(v, SYSTEM_VALUE_LOCAL_INVOCATION_ID)));
+      crb.add(SP_CS_WIE_CNTL_1(CHIP, .linearlocalidregid = regid(63, 0),
+                               .threadsize = thrsz,
+                               .workitemrastorder = WORKITEMRASTORDER_TILED));
+      crb.add(SP_CS_WGE_CNTL(CHIP, .linearlocalidregid = regid(63, 0),
+                             .threadsize = thrsz,
+                             .workgrouprastorderzfirsten = true,
+                             .wgtilewidth = 4, .wgtileheight = 16));
+      crb.add(SP_CS_VGS_CNTL(CHIP, 0));
+
+      /* The graphics registers that the stock driver also sets: no fragment
+       * shader inputs.
+       */
+      crb.add({ 0xa9c6, 0, false });
+      crb.add({ 0xa9c8, 0xfcfcfcfc, false });
+      crb.add({ 0xa9c9, 0xfcfcfcfc, false });
+      crb.add({ 0xa9ca, 0xfcfcfcfc, false });
+      crb.add({ 0xa9cb, 0xfc00, false });
+   }
+
+   tu6_emit_xs_constants(cs, MESA_SHADER_COMPUTE, v, binary_iova);
+}
+
+void
+tu_shader_emit_aqe_ib(struct tu_device *dev, struct tu_cs *cs,
+                      const struct tu_shader *shader,
+                      const struct tu_pvtmem_config *pvtmem)
+{
+   TU_CALLX(dev, tu6_emit_rt_aqe_ib)(cs, shader->variant, pvtmem, shader->binary_iova);
+}
