diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 42b9689ca67..70ba88d447c 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -199,6 +199,13 @@ tu_subgroup_size(const struct tu_physical_device *device)
           (device->expose_double_threadsize ? 2 : 1);
 }
 
+static bool
+tu_virtual_subgroup32_supported(const struct tu_physical_device *device)
+{
+   return device->info->props.has_getfiberid &&
+          device->info->threadsize_base == 64;
+}
+
 static void
 get_device_extensions(const struct tu_physical_device *device,
                       struct vk_device_extension_table *ext)
@@ -1001,6 +1008,10 @@ tu_get_physical_device_properties_1_1(struct tu_physical_device *pdevice,
                                     VK_SUBGROUP_FEATURE_ARITHMETIC_BIT;
    if (pdevice->info->props.has_getfiberid) {
       p->subgroupSupportedStages |= VK_SHADER_STAGE_ALL_GRAPHICS;
+      if (TU_EXPERIMENTAL(MESH_SHADER) && pdevice->info->chip >= A8XX) {
+         p->subgroupSupportedStages |=
+            VK_SHADER_STAGE_TASK_BIT_EXT | VK_SHADER_STAGE_MESH_BIT_EXT;
+      }
       p->subgroupSupportedOperations |= VK_SUBGROUP_FEATURE_QUAD_BIT;
    }
    p->subgroupQuadOperationsInAllStages = pdevice->info->props.has_getfiberid;
@@ -1124,18 +1135,28 @@ static void
 tu_get_physical_device_properties_1_3(struct tu_physical_device *pdevice,
                                       struct vk_properties *p)
 {
-   p->minSubgroupSize = pdevice->info->threadsize_base;
+   const bool virtual32 = tu_virtual_subgroup32_supported(pdevice);
+   p->minSubgroupSize = virtual32 ? 32 : pdevice->info->threadsize_base;
    p->maxSubgroupSize = tu_subgroup_size(pdevice);
-   p->maxComputeWorkgroupSubgroups = pdevice->info->max_waves;
+   p->maxComputeWorkgroupSubgroups =
+      tu_subgroup_size(pdevice) * pdevice->info->max_waves / p->minSubgroupSize;
    /* Only compute and fragment shaders can run with a doubled wave size, the
     * geometry stages always run at threadsize_base.  So when we expose more
     * than one possible subgroup size we can't honor a required subgroup size
     * in those stages.
     */
-   p->requiredSubgroupSizeStages =
-      p->minSubgroupSize == p->maxSubgroupSize
-         ? VK_SHADER_STAGE_ALL
-         : (VK_SHADER_STAGE_COMPUTE_BIT | VK_SHADER_STAGE_FRAGMENT_BIT);
+   if (virtual32) {
+      p->requiredSubgroupSizeStages = VK_SHADER_STAGE_COMPUTE_BIT;
+      if (TU_EXPERIMENTAL(MESH_SHADER)) {
+         p->requiredSubgroupSizeStages |=
+            VK_SHADER_STAGE_TASK_BIT_EXT | VK_SHADER_STAGE_MESH_BIT_EXT;
+      }
+   } else {
+      p->requiredSubgroupSizeStages =
+         p->minSubgroupSize == p->maxSubgroupSize
+            ? VK_SHADER_STAGE_ALL
+            : (VK_SHADER_STAGE_COMPUTE_BIT | VK_SHADER_STAGE_FRAGMENT_BIT);
+   }
 
    p->maxInlineUniformBlockSize = MAX_INLINE_UBO_RANGE;
    p->maxPerStageDescriptorInlineUniformBlocks = MAX_INLINE_UBOS;
