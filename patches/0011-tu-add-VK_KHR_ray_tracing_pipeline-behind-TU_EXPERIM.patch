+/* A shader group handle is {general, closest hit, any hit, intersection},
+ * where each member is the 64-bit ID of the stage or 0.
+ */
+#define TU_RT_HANDLE_SIZE 32
+
+struct tu_rt_stage {
+   mesa_shader_stage stage;
+
+   /* The identity of the stage, and the ID taken from it. */
+   uint8_t hash[BLAKE3_OUT_LEN];
+   uint64_t id;
+
+   /* The stack the stage needs, set when the pipeline is compiled. */
+   uint32_t stack;
+
+   /* Serialized NIR. */
+   void *nir;
+   size_t nir_size;
+};
+
+struct tu_rt_group {
+   uint64_t ids[4];
+
+   /* The stack that each member needs, in the order of the IDs. */
+   uint32_t stack[4];
+};
+
+/* What a pipeline in the AQE mode launches. The shaders the AQE schedules are
+ * numbered [0] a NOP, [1] the traversal, [2] the starter of the rays, [3] the
+ * recycler that starts the next ray of a thread that finished, then the pieces
+ * that the stages are split into. The programs of [1..] are `shaders`.
+ */
+struct tu_rt_aqe {
+   uint32_t num_shaders;
+
+   /* The programs of the shaders from [1], the first is the pipeline's. */
+   struct tu_shader **shaders;
+
+   /* The size of the state of a thread in scratch0, the same for all the pieces. */
+   uint32_t scratch0_size;
+
+   /* Their IBs, the tables of their addresses and lengths and the index of
+    * the starter, which the launch points the AQE to as the raygen record,
+    * are in one BO.
+    */
+   struct tu_suballoc_bo bo;
+   struct tu_cs cs;
+   uint64_t ib_addrs, ib_lengths, starter_index;
+
+   /* The private memory of the shaders, for the lifetime of the pipeline, by
+    * layout (per fiber, per wave).
+    */
+   struct tu_bo *pvtmem_bo[2];
+
+   /* The shader whose descriptors and push constants are loaded before a launch. */
+   struct tu_shader *consts;
+
+   /* The biggest instruction size of the programs. */
+   uint32_t instrlen;
+};
+
+/* The stages are only kept for libraries, the groups are always kept and
+ * include the ones of the libraries.
+ */
+struct tu_rt_pipeline {
+   struct tu_pipeline base;
+
+   struct tu_rt_stage *stages;
+   uint32_t stage_count;
+
+   struct tu_rt_group *groups;
+   uint32_t group_count;
+
+   /* The stack of a separate mode pipeline, which is in private memory after
+    * the one of the shader and sized when the rays are traced. The default
+    * is used if the application doesn't set one. It is 0 for the monolithic
+    * mode.
+    */
+   uint32_t stack_default;
+
+   /* Whether the application sets the stack size. */
+   bool stack_dynamic;
+
+   struct tu_rt_aqe *aqe;
+};
+
+void
+tu_rt_pipeline_finish(struct tu_rt_pipeline *pipeline, struct tu_device *dev,
+                      const VkAllocationCallbacks *alloc);
