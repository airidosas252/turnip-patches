+      desc[9] *= layout->num_views;
+      desc[11] *= layout->num_views;
+      if (layout->has_cull)
+         desc[0] |= 0x200;
+   }
+   desc[13] = layout->has_cull ? 0x20 : 0;
+   desc[15] = layout->max_vertices;
+   desc[16] = layout->max_primitives;
+   desc[17] = 1 | (layout->has_viewport ? 2 : 0) | (layout->has_layer ? 4 : 0);
+   desc[19] = ndrange_0;
