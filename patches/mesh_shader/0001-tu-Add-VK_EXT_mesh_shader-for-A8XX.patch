@@ -0,0 +1,1618 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nir/nir_builder.h"
+#include "nir/nir_control_flow.h"
+
+#include "tu_device.h"
+#include "tu_shader.h"
+
+static unsigned
+type_size_vec4(const struct glsl_type *type, bool bindless)
+{
+   return glsl_count_attribute_slots(type, false);
+}
+
+static int
+slot_index(const uint8_t *slots, unsigned count, unsigned slot)
+{
+   for (unsigned i = 0; i < count; i++) {
+      if (slots[i] == slot)
+         return i;
+   }
+   return -1;
+}
+
+static int
+first_prim_span_slot(const uint8_t *slots, unsigned count,
+                     const nir_variable *var)
+{
+   const unsigned n = nir_variable_count_slots(var, var->type);
+
+   for (unsigned j = 0; j < n; j++) {
+      if (slot_index(slots, count, var->data.location + j) >= 0)
+         return j;
+   }
+   return -1;
+}
+
+static bool
+native_prim_type_ok(const struct glsl_type *type)
+{
+   if (glsl_type_is_array(type))
+      return native_prim_type_ok(glsl_get_array_element(type));
+
+   if (glsl_type_is_struct_or_ifc(type)) {
+      for (unsigned i = 0; i < glsl_get_length(type); i++) {
+         if (!native_prim_type_ok(glsl_get_struct_field(type, i)))
+            return false;
+      }
+      return true;
+   }
+
+   return glsl_type_is_vector_or_scalar(type) && glsl_get_bit_size(type) == 32;
+}
+
+static gl_varying_slot
+prim_vs_location(unsigned slot)
+{
+   return slot == VARYING_SLOT_PRIMITIVE_ID ? VARYING_SLOT_TEX0 :
+          (gl_varying_slot)slot;
+}
+
+static void
+init_layout(struct tu_mesh_layout *layout, const nir_shader *nir)
+{
+   const shader_info *info = &nir->info;
+
+   *layout = {};
+   layout->max_vertices = info->mesh.max_vertices_out;
+   layout->max_primitives = info->mesh.max_primitives_out;
+   layout->prim = info->mesh.primitive_type;
+   layout->verts_per_prim = mesa_vertices_per_prim(layout->prim);
+   layout->clip_distance_array_size = info->clip_distance_array_size;
+   layout->cull_distance_array_size = info->cull_distance_array_size;
+   layout->num_views = 1;
+
+   uint64_t written = info->outputs_written & ~info->per_primitive_outputs &
+      ~(VARYING_BIT_PRIMITIVE_INDICES | VARYING_BIT_CULL_PRIMITIVE);
+   u_foreach_bit64 (slot, written)
+      layout->vtx_slots[layout->num_vtx_slots++] = slot;
+
+   written = info->outputs_written & info->per_primitive_outputs &
+      ~(VARYING_BIT_PRIMITIVE_INDICES | VARYING_BIT_CULL_PRIMITIVE |
+        VARYING_BIT_PRIMITIVE_SHADING_RATE);
+   u_foreach_bit64 (slot, written)
+      layout->prim_slots[layout->num_prim_slots++] = slot;
+   layout->has_cull = info->outputs_written & VARYING_BIT_CULL_PRIMITIVE;
+
+   layout->indices_offset = 16;
+   layout->cull_offset = layout->indices_offset +
+      align(layout->max_primitives * layout->verts_per_prim * 4, 16);
+   layout->prims_offset = layout->cull_offset +
+      (layout->has_cull ? align(layout->max_primitives * 4, 16) : 0);
+   layout->vertices_offset = layout->prims_offset +
+      layout->max_primitives * layout->num_prim_slots * 16;
+   layout->slot_stride = layout->vertices_offset +
+      layout->max_vertices * layout->num_vtx_slots * 16;
+}
+
+enum tu_mesh_native_const {
+   TU_MESH_NATIVE_C0 = 0,
+   TU_MESH_NATIVE_C0_ZW = 2,
+   TU_MESH_NATIVE_C1 = 4,
+   TU_MESH_NATIVE_C1_ZW = 6,
+   TU_MESH_NATIVE_C2 = 8,
+   TU_MESH_NATIVE_C2_ZW = 10,
+   TU_MESH_NATIVE_C3 = 12,
+   TU_MESH_NATIVE_C3_Z = 14,
+   TU_MESH_NATIVE_C3_W = 15,
+   TU_MESH_NATIVE_C4 = 16,
+};
+
+static bool
+fs_reads_layer_viewport(nir_shader *fs)
+{
+   nir_foreach_variable_with_modes (var, fs, nir_var_shader_in | nir_var_system_value) {
+      if (var->data.mode == nir_var_system_value ?
+             var->data.location == SYSTEM_VALUE_LAYER_ID :
+             (var->data.location == VARYING_SLOT_LAYER ||
+              var->data.location == VARYING_SLOT_VIEWPORT))
+         return true;
+   }
+
+   nir_foreach_function_impl (impl, fs) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic == nir_intrinsic_load_layer_id)
+               return true;
+            if ((intr->intrinsic == nir_intrinsic_load_input ||
+                 intr->intrinsic == nir_intrinsic_load_interpolated_input) &&
+                (nir_intrinsic_io_semantics(intr).location == VARYING_SLOT_LAYER ||
+                 nir_intrinsic_io_semantics(intr).location == VARYING_SLOT_VIEWPORT))
+               return true;
+         }
+      }
+   }
+
+   return false;
+}
+
+static const char *
+native_unsupported(const nir_shader *nir, const struct tu_mesh_layout *layout,
+                   nir_shader *fs)
+{
+   const shader_info *info = &nir->info;
+   const uint64_t vertex_outputs =
+      info->outputs_written & ~info->per_primitive_outputs &
+      ~(VARYING_BIT_PRIMITIVE_INDICES | VARYING_BIT_CULL_PRIMITIVE);
+   const uint64_t prim_outputs =
+      info->outputs_written & info->per_primitive_outputs &
+      ~(VARYING_BIT_PRIMITIVE_INDICES | VARYING_BIT_CULL_PRIMITIVE);
+   const uint64_t user_slots = BITFIELD64_RANGE(VARYING_SLOT_VAR0, 32);
+
+   if (layout->prim != MESA_PRIM_TRIANGLES && layout->prim != MESA_PRIM_POINTS &&
+       layout->prim != MESA_PRIM_LINES)
+      return "primitive type";
+
+   if (layout->num_vtx_slots > MAX_VERTEX_ATTRIBS ||
+       !(vertex_outputs & VARYING_BIT_POS) ||
+       (vertex_outputs & ~(VARYING_BIT_POS | VARYING_BIT_PSIZ |
+                           VARYING_BIT_CLIP_DIST0 | VARYING_BIT_CLIP_DIST1 |
+                           user_slots)))
+      return "per-vertex outputs";
+
+   if (prim_outputs & ~(VARYING_BIT_PRIMITIVE_ID | VARYING_BIT_LAYER |
+                        VARYING_BIT_VIEWPORT | user_slots))
+      return "per-primitive builtin outputs";
+
+   if (info->derivative_group == DERIVATIVE_GROUP_QUADS)
+      return "derivative group quads";
+
+   if (prim_outputs & (VARYING_BIT_PRIMITIVE_ID | user_slots)) {
+      if (!fs)
+         return "per-primitive outputs without a fragment shader";
+      nir_foreach_shader_out_variable (var, nir) {
+         if (!var->data.per_primitive ||
+             (var->data.location != VARYING_SLOT_PRIMITIVE_ID &&
+              (var->data.location < VARYING_SLOT_VAR0 ||
+               var->data.location >= VARYING_SLOT_VAR0 + 32)))
+            continue;
+         if (!native_prim_type_ok(glsl_get_array_element(var->type)))
+            return "per-primitive output type (not 32-bit vector, scalar, array or struct of them)";
+      }
+   }
+
+   if (prim_outputs & (VARYING_BIT_LAYER | VARYING_BIT_VIEWPORT)) {
+      if (!fs || fs_reads_layer_viewport(fs) || layout->prim == MESA_PRIM_LINES)
+         return "gl_Layer / gl_ViewportIndex output";
+   }
+
+   return NULL;
+}
+
+static const char *
+init_native_layout(struct tu_mesh_layout *layout, nir_shader *fs,
+                   uint32_t view_mask)
+{
+   uint8_t slots[ARRAY_SIZE(layout->vtx_slots)];
+   unsigned num = 0;
+
+   layout->native = true;
+   if (util_last_bit(view_mask) > 1) {
+      layout->num_views = util_last_bit(view_mask);
+      layout->view_mask = view_mask;
+   }
+   for (unsigned i = 0; i < layout->num_vtx_slots; i++) {
+      if (layout->vtx_slots[i] == VARYING_SLOT_PSIZ)
+         layout->has_psiz = layout->prim == MESA_PRIM_POINTS;
+      else if (layout->vtx_slots[i] != VARYING_SLOT_POS)
+         slots[num++] = layout->vtx_slots[i];
+   }
+   slots[num++] = VARYING_SLOT_POS;
+   memcpy(layout->vtx_slots, slots, num);
+   layout->num_vtx_slots = num;
+   layout->vertex_stride = num * 16 + (layout->has_psiz ? 4 : 0);
+   layout->vertices_offset = 0;
+
+   unsigned prim_num = 0;
+   for (unsigned i = 0; i < layout->num_prim_slots; i++) {
+      if (layout->prim_slots[i] == VARYING_SLOT_LAYER)
+         layout->has_layer = true;
+      else if (layout->prim_slots[i] == VARYING_SLOT_VIEWPORT)
+         layout->has_viewport = true;
+      else
+         layout->prim_slots[prim_num++] = layout->prim_slots[i];
+   }
+   layout->num_prim_slots = prim_num;
+   layout->point_list = layout->prim == MESA_PRIM_POINTS &&
+                        !layout->has_layer && !layout->has_viewport;
+
+   if (!prim_num)
+      return NULL;
+
+   unsigned next = 0;
+   nir_foreach_shader_in_variable (var, fs) {
+      const unsigned loc = var->data.location;
+      if (loc < VARYING_SLOT_VAR0 || loc >= VARYING_SLOT_VAR0 + 32 ||
+          first_prim_span_slot(layout->prim_slots, prim_num, var) >= 0)
+         continue;
+      next = MAX2(next, loc - VARYING_SLOT_VAR0 +
+                           glsl_count_attribute_slots(var->type, false));
+   }
+
+   nir_foreach_shader_in_variable (var, fs) {
+      const int first = first_prim_span_slot(layout->prim_slots, prim_num, var);
+      if (first < 0)
+         continue;
+      const unsigned span = nir_variable_count_slots(var, var->type);
+      if (next + span > 32)
+         return "per-primitive fragment inputs do not fit in the user locations";
+      for (unsigned j = first; j < span; j++) {
+         const int i = slot_index(layout->prim_slots, prim_num,
+                                  var->data.location + j);
+         if (i < 0)
+            continue;
+         if (layout->prim_fs_slot[i])
+            return "per-primitive location read by two fragment inputs";
+         layout->prim_fs_slot[i] = VARYING_SLOT_VAR0 + next + j;
+      }
+      next += span;
+   }
+
+   return NULL;
+}
+
+static void
+relocate_fs_prim_inputs(const struct tu_mesh_layout *layout, nir_shader *fs)
+{
+   bool progress = false;
+
+   nir_foreach_shader_in_variable (var, fs) {
+      const int first = first_prim_span_slot(layout->prim_slots,
+                                             layout->num_prim_slots, var);
+      if (first < 0)
+         continue;
+      const int i = slot_index(layout->prim_slots, layout->num_prim_slots,
+                               var->data.location + first);
+      var->data.location = layout->prim_fs_slot[i] - first;
+      var->data.interpolation = INTERP_MODE_FLAT;
+      progress = true;
+   }
+
+   if (progress)
+      nir_shader_gather_info(fs, nir_shader_get_entrypoint(fs));
+}
+
+void
+tu_nir_mesh_layout(nir_shader *nir, struct tu_mesh_layout *layout,
+                   uint32_t task_payload_size, bool want_native,
+                   nir_shader *fs, uint32_t view_mask)
+{
+   assert(nir->info.stage == MESA_SHADER_MESH);
+
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+   init_layout(layout, nir);
+   layout->task_payload_size = task_payload_size;
+
+   layout->native_reject = want_native ? native_unsupported(nir, layout, fs) :
+      "native mesh shaders disabled or task shader unsupported";
+   if (!layout->native_reject) {
+      struct tu_mesh_layout native = *layout;
+      layout->native_reject = init_native_layout(&native, fs, view_mask);
+      if (!layout->native_reject) {
+         *layout = native;
+         if (layout->num_prim_slots)
+            relocate_fs_prim_inputs(layout, fs);
+      }
+   }
+}
+
+void
+tu_nir_mesh_resolve_prims(struct tu_mesh_layout *layout,
+                          const struct ir3_shader_variant *fs)
+{
+   unsigned lo = ~0u, hi = 0;
+
+   for (unsigned i = 0; i < layout->num_prim_slots; i++) {
+      layout->prim_comps[i] = 0;
+      const int in = layout->prim_fs_slot[i] ?
+         ir3_find_input(fs, (gl_varying_slot)layout->prim_fs_slot[i]) : -1;
+      if (in < 0)
+         continue;
+      const unsigned loc = fs->inputs[in].inloc;
+      const unsigned comps = util_last_bit(fs->inputs[in].compmask);
+      layout->prim_off[i] = loc;
+      layout->prim_comps[i] = comps;
+      lo = MIN2(lo, loc);
+      hi = MAX2(hi, loc + comps);
+   }
+
+   layout->prim_dwords = 0;
+   layout->prim_loc = 0;
+   if (lo == ~0u)
+      return;
+
+   for (unsigned i = 0; i < layout->num_prim_slots; i++)
+      layout->prim_off[i] -= lo;
+   layout->prim_loc = lo;
+   layout->prim_dwords = hi - lo;
+}
+
+struct native_addr {
+   nir_def *base;
+   nir_def *off;
+};
+
+struct lower_mesh_state {
+   const struct tu_mesh_layout *layout;
+   bool native;
+   struct native_addr vtx;
+   struct native_addr idx;
+   struct native_addr cnt_prim;
+   struct native_addr cnt_vert;
+   nir_def *slot_base;
+   nir_def *payload_base;
+   struct native_addr prim;
+   struct native_addr cull;
+   nir_def *record;
+   nir_def *view;
+   nir_def *app_wg;
+   nir_def *app_num;
+   nir_def *hw_wg;
+   nir_def *hw_num;
+};
+
+static nir_def *
+ubo32(nir_builder *b, enum tu_mesh_ubo_dword dword)
+{
+   return nir_load_scratch_base_ptr(b, 1, 32, dword);
+}
+
+static nir_def *
+ubo64(nir_builder *b, enum tu_mesh_ubo_dword dword)
+{
+   return nir_load_scratch_base_ptr(b, 1, 64, dword);
+}
+
+static nir_def *
+linear_wg_id(nir_builder *b, nir_def *wg, nir_def *num_wg)
+{
+   return nir_iadd(b, nir_channel(b, wg, 0),
+                   nir_imul(b, nir_channel(b, num_wg, 0),
+                            nir_iadd(b, nir_channel(b, wg, 1),
+                                     nir_imul(b, nir_channel(b, num_wg, 1),
+                                              nir_channel(b, wg, 2)))));
+}
+
+static nir_def *
+elem_addr(nir_builder *b, nir_def *base, nir_def *index, unsigned stride)
+{
+   return nir_iadd(b, base, nir_imul_imm(b, nir_u2u64(b, index), stride));
+}
+
+static struct native_addr
+native_addr_at(nir_builder *b, struct native_addr a, nir_def *index,
+               unsigned stride)
+{
+   return { a.base, nir_iadd(b, a.off, nir_imul_imm(b, index, stride)) };
+}
+
+static nir_def *
+native_addr64(nir_builder *b, struct native_addr a, unsigned imm)
+{
+   return nir_iadd(b, a.base, nir_u2u64(b, nir_iadd_imm(b, a.off, imm)));
+}
+
+static nir_def *
+native_ldg(nir_builder *b, unsigned num_components, unsigned bit_size,
+           struct native_addr a, unsigned imm, unsigned align_mul)
+{
+   nir_def *off = imm < 256 ? a.off : nir_iadd_imm(b, a.off, imm);
+   return nir_load_global_offset(b, num_components, bit_size, a.base, off,
+                                 .base = imm < 256 ? imm : 0,
+                                 .align_mul = align_mul,
+                                 .align_offset = imm % align_mul);
+}
+
+static void
+native_stg(nir_builder *b, nir_def *value, struct native_addr a, unsigned imm,
+           unsigned write_mask, unsigned align_mul)
+{
+   nir_def *off = imm < 256 ? a.off : nir_iadd_imm(b, a.off, imm);
+   nir_store_global_offset(b, value, a.base, off,
+                           .base = imm < 256 ? imm : 0,
+                           .write_mask = write_mask,
+                           .align_mul = align_mul,
+                           .align_offset = imm % align_mul);
+}
+
+static bool
+lower_payload_access(nir_builder *b, nir_intrinsic_instr *intr,
+                     struct lower_mesh_state *state)
+{
+   b->cursor = nir_before_instr(&intr->instr);
+
+   const bool is_store = intr->intrinsic == nir_intrinsic_store_task_payload;
+   nir_def *addr = nir_iadd(b, state->payload_base,
+                            nir_u2u64(b, intr->src[is_store ? 1 : 0].ssa));
+   addr = nir_iadd_imm(b, addr, nir_intrinsic_base(intr));
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_task_payload:
+      nir_def_replace(&intr->def,
+                      nir_load_global(b, intr->def.num_components,
+                                      intr->def.bit_size, addr,
+                                      .align_mul = nir_intrinsic_align_mul(intr),
+                                      .align_offset = nir_intrinsic_align_offset(intr)));
+      break;
+   case nir_intrinsic_store_task_payload:
+      nir_store_global(b, intr->src[0].ssa, addr,
+                       .write_mask = nir_intrinsic_write_mask(intr),
+                       .align_mul = nir_intrinsic_align_mul(intr),
+                       .align_offset = nir_intrinsic_align_offset(intr));
+      nir_instr_remove(&intr->instr);
+      break;
+   case nir_intrinsic_task_payload_atomic:
+      nir_def_replace(&intr->def,
+                      nir_global_atomic(b, intr->def.bit_size, addr,
+                                        intr->src[1].ssa,
+                                        .atomic_op = nir_intrinsic_atomic_op(intr)));
+      break;
+   default:
+      nir_def_replace(&intr->def,
+                      nir_global_atomic_swap(b, intr->def.bit_size, addr,
+                                             intr->src[1].ssa, intr->src[2].ssa,
+                                             .atomic_op = nir_intrinsic_atomic_op(intr)));
+      break;
+   }
+   return true;
+}
+
+static unsigned
+native_record_bytes(const struct tu_mesh_layout *layout)
+{
+   return layout->point_list ? 2 : layout->verts_per_prim == 2 ? 6 : 8;
+}
+
+static bool
+lower_native_indices(nir_builder *b, nir_intrinsic_instr *intr,
+                     struct lower_mesh_state *state, bool is_store)
+{
+   const struct tu_mesh_layout *layout = state->layout;
+   const unsigned verts = layout->verts_per_prim;
+   nir_def *prim = intr->src[is_store ? 1 : 0].ssa;
+   unsigned comp = nir_intrinsic_component(intr);
+   struct native_addr record =
+      native_addr_at(b, state->idx, prim, native_record_bytes(layout));
+
+   if (!is_store) {
+      nir_def *chans[3];
+      for (unsigned i = 0; i < intr->def.num_components; i++)
+         chans[i] = nir_u2u32(b, native_ldg(b, 1, 16, record, (comp + i) * 2, 2));
+      nir_def_replace(&intr->def,
+                      nir_vec(b, chans, intr->def.num_components));
+      return true;
+   }
+
+   nir_def *value = intr->src[0].ssa;
+   unsigned write_mask = nir_intrinsic_write_mask(intr);
+   const bool keep_siv = layout->has_layer || layout->has_viewport;
+   if (layout->point_list) {
+      native_stg(b, nir_u2u16(b, nir_channel(b, value, 0)), record, 0, 0x1, 2);
+   } else if (comp == 0 && write_mask == BITFIELD_MASK(verts) && verts != 2) {
+      nir_def *a = nir_channel(b, value, 0);
+      nir_def *c = nir_channel(b, value, verts == 3 ? 2 : 0);
+      nir_def *lo = nir_pack_32_2x16_split(
+         b, nir_u2u16(b, a), nir_u2u16(b, nir_channel(b, value, verts == 3 ? 1 : 0)));
+      if (keep_siv) {
+         native_stg(b, lo, record, 0, 0x1, 8);
+         native_stg(b, nir_u2u16(b, c), record, 4, 0x1, 4);
+      } else {
+         native_stg(b, nir_vec2(b, lo, nir_iand_imm(b, c, 0xffff)), record, 0,
+                    0x3, 8);
+      }
+   } else {
+      u_foreach_bit (i, write_mask) {
+         native_stg(b, nir_u2u16(b, nir_channel(b, value, i)), record,
+                    (comp + i) * 2, 0x1, 2);
+      }
+      if (verts == 2) {
+         native_stg(b, nir_imm_intN_t(b, 0, 16), record, 4, 0x1, 2);
+      } else if (!keep_siv) {
+         native_stg(b, nir_imm_intN_t(b, 0, 16), record, 6, 0x1, 2);
+      }
+   }
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+static bool
+lower_native_siv(nir_builder *b, nir_intrinsic_instr *intr,
+                 struct lower_mesh_state *state, bool is_store)
+{
+   const struct tu_mesh_layout *layout = state->layout;
+   const bool is_layer =
+      nir_intrinsic_io_semantics(intr).location == VARYING_SLOT_LAYER;
+   nir_def *prim = intr->src[is_store ? 1 : 0].ssa;
+   struct native_addr addr =
+      native_addr_at(b, state->idx, prim, native_record_bytes(layout));
+
+   if (!is_store) {
+      nir_def *half = nir_u2u32(b, native_ldg(b, 1, 16, addr, 6, 2));
+      nir_def_replace(&intr->def,
+                      is_layer ? nir_ushr_imm(b, half, 8) : nir_iand_imm(b, half, 0xff));
+      return true;
+   }
+
+   nir_def *value = nir_iand_imm(b, intr->src[0].ssa, 0xff);
+   nir_def *half = is_layer ? nir_ishl_imm(b, value, 8) : value;
+   if (layout->has_layer && layout->has_viewport) {
+      nir_def *old = nir_u2u32(b, native_ldg(b, 1, 16, addr, 6, 2));
+      half = nir_ior(b, half, nir_iand_imm(b, old, is_layer ? 0xff : 0xff00));
+   }
+   native_stg(b, nir_u2u16(b, half), addr, 6, 0x1, 2);
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+static bool
+lower_native_cull(nir_builder *b, nir_intrinsic_instr *intr,
+                  struct lower_mesh_state *state, bool is_store)
+{
+   if (!is_store) {
+      nir_def_replace(&intr->def, nir_imm_zero(b, intr->def.num_components,
+                                               intr->def.bit_size));
+      return true;
+   }
+
+   nir_def *prim = intr->src[1].ssa;
+   nir_def *value = intr->src[0].ssa;
+   nir_def *culled = value->bit_size == 1 ? value : nir_ine_imm(b, value, 0);
+   nir_def *addr = native_addr64(
+      b, { state->cull.base,
+           nir_iadd(b, state->cull.off,
+                    nir_ishl_imm(b, nir_ushr_imm(b, prim, 5), 2)) }, 0);
+   nir_def *clear = nir_inot(b, nir_ishl(b, nir_imm_int(b, 1),
+                                         nir_iand_imm(b, prim, 31)));
+
+   nir_push_if(b, culled);
+   nir_global_atomic(b, 32, addr, clear, .atomic_op = nir_atomic_op_iand);
+   nir_pop_if(b, NULL);
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+static void
+native_store(nir_builder *b, nir_intrinsic_instr *intr, struct native_addr addr,
+             unsigned imm, unsigned limit, unsigned align_mul)
+{
+   const unsigned comp = nir_intrinsic_component(intr);
+   nir_def *value = intr->src[0].ssa;
+   if (value->bit_size == 1)
+      value = nir_b2i32(b, value);
+
+   u_foreach_bit (i, nir_intrinsic_write_mask(intr)) {
+      if (comp + i >= limit)
+         continue;
+      native_stg(b, nir_channel(b, value, i), addr, imm + (comp + i) * 4, 0x1,
+                 align_mul);
+   }
+}
+
+static void
+native_load(nir_builder *b, nir_intrinsic_instr *intr, const struct native_addr *addr,
+            unsigned imm, unsigned limit, unsigned align_mul, nir_def **chans)
+{
+   const unsigned comp = nir_intrinsic_component(intr);
+
+   for (unsigned i = 0; i < intr->def.num_components; i++) {
+      if (addr && comp + i < limit) {
+         chans[i] = native_ldg(b, 1, intr->def.bit_size, *addr,
+                               imm + (comp + i) * 4, align_mul);
+      } else {
+         chans[i] = nir_imm_zero(b, 1, intr->def.bit_size);
+      }
+   }
+}
+
+static struct native_addr
+native_prim_addr(nir_builder *b, struct lower_mesh_state *state, nir_def *prim)
+{
+   return native_addr_at(b, state->prim, prim, state->layout->prim_dwords * 4);
+}
+
+static bool
+lower_native_prim_indirect(nir_builder *b, nir_intrinsic_instr *intr,
+                           struct lower_mesh_state *state, bool is_store)
+{
+   const struct tu_mesh_layout *layout = state->layout;
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   nir_def *prim = intr->src[is_store ? 1 : 0].ssa;
+   nir_def *offset = intr->src[is_store ? 2 : 1].ssa;
+   nir_def *chans[4];
+
+   if (!is_store) {
+      for (unsigned c = 0; c < intr->def.num_components; c++)
+         chans[c] = nir_imm_zero(b, 1, intr->def.bit_size);
+   }
+
+   for (unsigned j = 0; j < sem.num_slots; j++) {
+      const int i = slot_index(layout->prim_slots, layout->num_prim_slots,
+                               sem.location + j);
+      if (i < 0 || !layout->prim_comps[i])
+         continue;
+
+      struct native_addr addr = native_prim_addr(b, state, prim);
+      nir_def *hit = nir_ieq_imm(b, offset, j);
+      if (is_store) {
+         nir_push_if(b, hit);
+         native_store(b, intr, addr, layout->prim_off[i] * 4,
+                      layout->prim_comps[i], 4);
+         nir_pop_if(b, NULL);
+      } else {
+         nir_def *loaded[4];
+         native_load(b, intr, &addr, layout->prim_off[i] * 4,
+                     layout->prim_comps[i], 4, loaded);
+         for (unsigned c = 0; c < intr->def.num_components; c++)
+            chans[c] = nir_bcsel(b, hit, loaded[c], chans[c]);
+      }
+   }
+
+   if (is_store) {
+      nir_instr_remove(&intr->instr);
+   } else {
+      nir_def_replace(&intr->def, nir_vec(b, chans, intr->def.num_components));
+   }
+   return true;
+}
+
+static bool
+lower_native_output(nir_builder *b, nir_intrinsic_instr *intr,
+                    struct lower_mesh_state *state, bool is_store, bool is_prim)
+{
+   const struct tu_mesh_layout *layout = state->layout;
+   nir_src *index_src = &intr->src[is_store ? 1 : 0];
+   nir_src *offset_src = &intr->src[is_store ? 2 : 1];
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   struct native_addr addr = {};
+   bool have_addr = false;
+   unsigned imm = 0;
+   unsigned align_mul = 4;
+
+   if (is_prim) {
+      switch (sem.location) {
+      case VARYING_SLOT_PRIMITIVE_INDICES:
+         return lower_native_indices(b, intr, state, is_store);
+      case VARYING_SLOT_CULL_PRIMITIVE:
+         return lower_native_cull(b, intr, state, is_store);
+      case VARYING_SLOT_LAYER:
+      case VARYING_SLOT_VIEWPORT:
+         return lower_native_siv(b, intr, state, is_store);
+      default:
+         break;
+      }
+
+      if (!nir_src_is_const(*offset_src))
+         return lower_native_prim_indirect(b, intr, state, is_store);
+   }
+
+   unsigned limit = 4;
+   unsigned loc = sem.location;
+   if (nir_src_is_const(*offset_src))
+      loc += nir_src_as_uint(*offset_src);
+
+   if (is_prim) {
+      const int i = slot_index(layout->prim_slots, layout->num_prim_slots, loc);
+      if (i >= 0 && layout->prim_comps[i]) {
+         limit = layout->prim_comps[i];
+         addr = native_prim_addr(b, state, index_src->ssa);
+         imm = layout->prim_off[i] * 4;
+         have_addr = true;
+      }
+   } else if (sem.location == VARYING_SLOT_PSIZ) {
+      if (layout->has_psiz) {
+         addr = native_addr_at(b, state->vtx, index_src->ssa,
+                               layout->vertex_stride);
+         imm = layout->num_vtx_slots * 16;
+         have_addr = true;
+      }
+   } else {
+      nir_def *slot = NULL;
+      if (nir_src_is_const(*offset_src)) {
+         const int i = slot_index(layout->vtx_slots, layout->num_vtx_slots, loc);
+         if (i >= 0)
+            imm = i * 16;
+         have_addr = i >= 0;
+      } else {
+         const int i = slot_index(layout->vtx_slots, layout->num_vtx_slots,
+                                  sem.location);
+         if (i >= 0) {
+            slot = nir_imul_imm(b, offset_src->ssa, 16);
+            imm = i * 16;
+         }
+         have_addr = i >= 0;
+      }
+      if (have_addr) {
+         addr = native_addr_at(b, state->vtx, index_src->ssa,
+                               layout->vertex_stride);
+         if (slot)
+            addr.off = nir_iadd(b, addr.off, slot);
+         if (layout->vertex_stride % 16 == 0)
+            align_mul = 16;
+      }
+   }
+
+   if (is_store) {
+      if (have_addr)
+         native_store(b, intr, addr, imm, limit, align_mul);
+      nir_instr_remove(&intr->instr);
+   } else {
+      nir_def *chans[4];
+      native_load(b, intr, have_addr ? &addr : NULL, imm, limit, align_mul,
+                  chans);
+      nir_def_replace(&intr->def, nir_vec(b, chans, intr->def.num_components));
+   }
+   return true;
+}
+
+static bool
+lower_mesh_intrinsic(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   struct lower_mesh_state *state = (struct lower_mesh_state *)data;
+   const struct tu_mesh_layout *layout = state->layout;
+   bool is_store, is_prim;
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_barrier: {
+      nir_variable_mode modes = nir_intrinsic_memory_modes(intr);
+      if (!(modes & (nir_var_shader_out | nir_var_mem_task_payload)))
+         return false;
+      nir_intrinsic_set_memory_modes(intr, (modes & ~nir_var_shader_out) |
+                                           nir_var_mem_global);
+      return true;
+   }
+   case nir_intrinsic_load_draw_id:
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def, ubo32(b, TU_MESH_UBO_DRAW_INDEX));
+      return true;
+   case nir_intrinsic_load_view_index:
+      if (!state->view)
+         return false;
+      nir_def_replace(&intr->def, state->view);
+      return true;
+   case nir_intrinsic_load_base_workgroup_id:
+      if (!state->native)
+         return false;
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def, nir_imm_zero(b, 3, intr->def.bit_size));
+      return true;
+   case nir_intrinsic_load_workgroup_id:
+   case nir_intrinsic_load_num_workgroups: {
+      bool is_id = intr->intrinsic == nir_intrinsic_load_workgroup_id;
+      if (!state->app_wg || &intr->def == state->hw_wg ||
+          &intr->def == state->hw_num)
+         return false;
+      nir_def_replace(&intr->def, is_id ? state->app_wg : state->app_num);
+      return true;
+   }
+   case nir_intrinsic_load_global_invocation_id: {
+      if (!state->app_wg || intr->def.bit_size != 32)
+         return false;
+      b->cursor = nir_before_instr(&intr->instr);
+      const uint16_t *size = b->shader->info.workgroup_size;
+      nir_def_replace(&intr->def,
+                      nir_iadd(b, nir_imul(b, state->app_wg,
+                                           nir_imm_ivec3(b, size[0], size[1],
+                                                         size[2])),
+                               nir_load_local_invocation_id(b)));
+      return true;
+   }
+   case nir_intrinsic_load_task_payload:
+   case nir_intrinsic_store_task_payload:
+   case nir_intrinsic_task_payload_atomic:
+   case nir_intrinsic_task_payload_atomic_swap:
+      if (!state->payload_base)
+         return false;
+      return lower_payload_access(b, intr, state);
+   case nir_intrinsic_launch_mesh_workgroups: {
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_push_if(b, nir_ieq_imm(b, nir_load_local_invocation_index(b), 0));
+      nir_def *dim = intr->src[0].ssa;
+      if (state->native) {
+         nir_def *x = nir_channel(b, dim, 0);
+         nir_def *y = nir_channel(b, dim, 1);
+         nir_def *z = nir_channel(b, dim, 2);
+         nir_def *count = nir_imul(b, x, nir_imul(b, y, z));
+         nir_def *rec = nir_vec3(
+            b, count,
+            nir_ior(b, nir_ishl_imm(b, nir_iadd_imm(b, y, -1), 16),
+                    nir_iadd_imm(b, x, -1)),
+            nir_iadd_imm(b, z, -1));
+         rec = nir_bcsel(b, nir_ieq_imm(b, count, 0),
+                         nir_imm_zero(b, 3, 32), rec);
+         nir_store_global(b, rec, state->record, .write_mask = 0x7,
+                          .align_mul = 4);
+         nir_store_global(b, state->app_wg, nir_iadd_imm(b, state->record, 12),
+                          .write_mask = 0x7, .align_mul = 4);
+      } else {
+         nir_store_global(b, nir_vec4(b, nir_channel(b, dim, 0),
+                                      nir_channel(b, dim, 1),
+                                      nir_channel(b, dim, 2), nir_imm_int(b, 0)),
+                          state->record, .write_mask = 0xf, .align_mul = 16);
+      }
+      nir_pop_if(b, NULL);
+      nir_instr_remove(&intr->instr);
+      return true;
+   }
+   case nir_intrinsic_set_vertex_and_primitive_count:
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_push_if(b, nir_ieq_imm(b, nir_load_local_invocation_index(b), 0));
+      if (state->native) {
+         native_stg(b, intr->src[0].ssa, state->cnt_vert, 0, 0x1, 4);
+         native_stg(b, intr->src[1].ssa, state->cnt_prim, 0, 0x1, 4);
+      } else {
+         nir_store_global(b, nir_vec2(b, intr->src[0].ssa, intr->src[1].ssa),
+                          state->slot_base, .write_mask = 0x3, .align_mul = 16);
+      }
+      nir_pop_if(b, NULL);
+      nir_instr_remove(&intr->instr);
+      return true;
+   case nir_intrinsic_load_per_vertex_output:
+      is_store = false, is_prim = false;
+      break;
+   case nir_intrinsic_load_per_primitive_output:
+      is_store = false, is_prim = true;
+      break;
+   case nir_intrinsic_store_per_vertex_output:
+      is_store = true, is_prim = false;
+      break;
+   case nir_intrinsic_store_per_primitive_output:
+      is_store = true, is_prim = true;
+      break;
+   default:
+      return false;
+   }
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   nir_src *index_src = &intr->src[is_store ? 1 : 0];
+   nir_src *offset_src = &intr->src[is_store ? 2 : 1];
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   unsigned comp = nir_intrinsic_component(intr);
+
+   if (state->native)
+      return lower_native_output(b, intr, state, is_store, is_prim);
+
+   nir_def *base = state->slot_base;
+   nir_def *offset = NULL;
+   unsigned align_mul = 4;
+   bool is_cull = is_prim && sem.location == VARYING_SLOT_CULL_PRIMITIVE;
+   if (is_prim && sem.location == VARYING_SLOT_PRIMITIVE_INDICES) {
+      offset = nir_iadd_imm(
+         b, nir_imul_imm(b, index_src->ssa, layout->verts_per_prim * 4),
+         layout->indices_offset + comp * 4);
+   } else if (is_cull) {
+      offset = nir_iadd_imm(b, nir_imul_imm(b, index_src->ssa, 4),
+                            layout->cull_offset);
+   } else {
+      const uint8_t *slots = is_prim ? layout->prim_slots : layout->vtx_slots;
+      unsigned count = is_prim ? layout->num_prim_slots : layout->num_vtx_slots;
+      unsigned region = is_prim ? layout->prims_offset : layout->vertices_offset;
+      nir_def *index = NULL;
+      if (nir_src_is_const(*offset_src)) {
+         int idx = slot_index(slots, count,
+                              sem.location + nir_src_as_uint(*offset_src));
+         if (idx >= 0)
+            index = nir_imm_int(b, idx);
+      } else {
+         int idx = slot_index(slots, count, sem.location);
+         if (idx >= 0)
+            index = nir_iadd_imm(b, offset_src->ssa, idx);
+      }
+
+      if (index) {
+         offset = nir_imul_imm(
+            b, nir_iadd(b, nir_imul_imm(b, index_src->ssa, count), index), 16);
+         offset = nir_iadd_imm(b, offset, region + comp * 4);
+         align_mul = 16;
+      }
+   }
+
+   if (is_store) {
+      if (offset) {
+         nir_def *value = intr->src[0].ssa;
+         if (is_cull && value->bit_size == 1)
+            value = nir_b2i32(b, value);
+         assert(value->bit_size == 32);
+         nir_store_global(b, value,
+                          nir_iadd(b, base, nir_u2u64(b, offset)),
+                          .write_mask = nir_intrinsic_write_mask(intr),
+                          .align_mul = align_mul,
+                          .align_offset = align_mul == 16 ? comp * 4 : 0);
+      }
+      nir_instr_remove(&intr->instr);
+   } else {
+      nir_def *res;
+      if (offset) {
+         bool bool_load = is_cull && intr->def.bit_size == 1;
+         res = nir_load_global(b, intr->def.num_components,
+                               bool_load ? 32 : intr->def.bit_size,
+                               nir_iadd(b, base, nir_u2u64(b, offset)),
+                               .align_mul = align_mul,
+                               .align_offset = align_mul == 16 ? comp * 4 : 0);
+         if (bool_load)
+            res = nir_i2b(b, res);
+      } else {
+         res = nir_imm_zero(b, intr->def.num_components, intr->def.bit_size);
+      }
+      nir_def_replace(&intr->def, res);
+   }
+
+   return true;
+}
+
+static void
+lower_task_payload_io(nir_shader *nir)
+{
+   NIR_PASS(_, nir, nir_lower_vars_to_explicit_types, nir_var_mem_task_payload,
+            glsl_get_natural_size_align_bytes);
+   NIR_PASS(_, nir, nir_lower_explicit_io, nir_var_mem_task_payload,
+            nir_address_format_32bit_offset);
+   NIR_PASS(_, nir, nir_remove_dead_variables, nir_var_mem_task_payload, NULL);
+}
+
+static bool
+flatten_local_id(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   const uint16_t *size = (const uint16_t *)data;
+
+   if (intr->intrinsic == nir_intrinsic_load_workgroup_size) {
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def,
+                      nir_u2uN(b, nir_imm_ivec3(b, size[0], size[1], size[2]),
+                               intr->def.bit_size));
+      return true;
+   }
+
+   if (intr->intrinsic != nir_intrinsic_load_local_invocation_id)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *index = nir_load_local_invocation_index(b);
+   nir_def *id = nir_vec3(b, nir_umod_imm(b, index, size[0]),
+                          nir_umod_imm(b, nir_udiv_imm(b, index, size[0]),
+                                       size[1]),
+                          nir_udiv_imm(b, index, size[0] * size[1]));
+   nir_def_replace(&intr->def, nir_u2uN(b, id, intr->def.bit_size));
+   return true;
+}
+
+static void
+finish_lowering(nir_shader *nir, struct lower_mesh_state *state)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   nir_progress(true, impl, nir_metadata_none);
+   NIR_PASS(_, nir, nir_shader_intrinsics_pass, lower_mesh_intrinsic,
+            nir_metadata_none, state);
+   uint16_t *size = nir->info.workgroup_size;
+   if (state->native && (size[1] != 1 || size[2] != 1)) {
+      uint16_t orig[3] = { size[0], size[1], size[2] };
+      NIR_PASS(_, nir, nir_shader_intrinsics_pass, flatten_local_id,
+               nir_metadata_none, orig);
+      size[0] = orig[0] * orig[1] * orig[2];
+      size[1] = size[2] = 1;
+   }
+   NIR_PASS(_, nir, nir_lower_vars_to_ssa);
+   NIR_PASS(_, nir, nir_opt_dce);
+   NIR_PASS(_, nir, nir_remove_dead_variables, nir_var_shader_out, NULL);
+
+   memset(&nir->info.mesh, 0, sizeof(nir->info.mesh));
+   memset(&nir->info.cs, 0, sizeof(nir->info.cs));
+   nir->info.stage = MESA_SHADER_COMPUTE;
+   nir_shader_gather_info(nir, impl);
+}
+
+static nir_def *
+load_native_const(nir_builder *b, unsigned num_components, unsigned base)
+{
+   return nir_load_const_ir3(b, num_components, 32, nir_imm_int(b, 0),
+                             .base = base);
+}
+
+static nir_def *
+load_native_const_64(nir_builder *b, unsigned base)
+{
+   return nir_pack_64_2x32(b, load_native_const(b, 2, base));
+}
+
+static void
+set_native_app_wg(nir_builder *b, struct lower_mesh_state *state, nir_def *c0,
+                  nir_def *slot, nir_def *nx, nir_def *ny, nir_def *nz)
+{
+   nir_def *linear = nir_iadd(b, nir_imul(b, nir_channel(b, c0, 0),
+                                          nir_channel(b, c0, 1)), slot);
+   state->app_num = nir_vec3(b, nx, ny, nz);
+   state->app_wg = nir_vec3(b, nir_umod(b, linear, nx),
+                            nir_umod(b, nir_udiv(b, linear, nx), ny),
+                            nir_udiv(b, linear, nir_imul(b, nx, ny)));
+}
+
+static nir_loop *
+begin_view_loop(nir_builder *b, struct lower_mesh_state *state)
+{
+   nir_variable *rest = nir_local_variable_create(
+      nir_shader_get_entrypoint(b->shader), glsl_uint_type(), "views_left");
+   nir_store_var(b, rest, nir_imm_int(b, state->layout->view_mask), 1);
+
+   nir_loop *loop = nir_push_loop(b);
+   nir_def *left = nir_load_var(b, rest);
+   nir_break_if(b, nir_ieq_imm(b, left, 0));
+   state->view = nir_find_lsb(b, left);
+   nir_store_var(b, rest, nir_iand(b, left, nir_iadd_imm(b, left, -1)), 1);
+   return loop;
+}
+
+static void
+end_view_loop(nir_builder *b, nir_loop *loop)
+{
+   b->cursor = nir_after_cf_list(&loop->body);
+   nir_foreach_variable_with_modes (var, b->shader, nir_var_mem_shared) {
+      nir_barrier(b, .execution_scope = SCOPE_WORKGROUP,
+                  .memory_scope = SCOPE_WORKGROUP,
+                  .memory_semantics = NIR_MEMORY_ACQ_REL,
+                  .memory_modes = nir_var_mem_shared);
+      break;
+   }
+   nir_pop_loop(b, loop);
+}
+
+static void
+setup_native(nir_builder *b, const struct tu_mesh_layout *layout,
+             struct lower_mesh_state *state, nir_loop **loop)
+{
+   state->native = true;
+   state->hw_wg = nir_load_workgroup_id(b);
+   nir_def *slot = nir_channel(b, state->hw_wg, 0);
+
+   nir_def *c0 = load_native_const(b, 2, TU_MESH_NATIVE_C0);
+   nir_def *slots_per_batch = nir_channel(b, c0, 1);
+   const unsigned views = layout->num_views;
+   const unsigned vtx_view_bytes = layout->max_vertices * layout->vertex_stride;
+   const unsigned idx_view_bytes =
+      layout->max_primitives * native_record_bytes(layout);
+   const unsigned prim_view_bytes =
+      layout->max_primitives * layout->prim_dwords * 4;
+
+   state->vtx = { load_native_const_64(b, TU_MESH_NATIVE_C1),
+                  nir_imul_imm(b, slot, views * vtx_view_bytes) };
+   state->idx = { load_native_const_64(b, TU_MESH_NATIVE_C2),
+                  nir_imul_imm(b, slot, views * idx_view_bytes) };
+   nir_def *counts = load_native_const_64(b, TU_MESH_NATIVE_C2_ZW);
+   state->cnt_prim = { counts, nir_imul_imm(b, slot, 4) };
+   state->cnt_vert = { counts, nir_iadd(b, state->cnt_prim.off,
+                                        nir_imul_imm(b, slots_per_batch, 4)) };
+
+   nir_def *nx = load_native_const(b, 1, TU_MESH_NATIVE_C3_W);
+   nir_def *nyz = load_native_const(b, 2, TU_MESH_NATIVE_C4);
+   set_native_app_wg(b, state, c0, slot, nx, nir_channel(b, nyz, 0),
+                     nir_channel(b, nyz, 1));
+
+   if (layout->task_payload_size) {
+      state->payload_base = elem_addr(
+         b, load_native_const_64(b, TU_MESH_NATIVE_C0_ZW),
+         load_native_const(b, 1, TU_MESH_NATIVE_C3_Z),
+         layout->task_payload_size);
+   }
+
+   if (layout->prim_dwords) {
+      state->prim = { load_native_const_64(b, TU_MESH_NATIVE_C1_ZW),
+                      nir_imul_imm(b, slot, views * prim_view_bytes) };
+   }
+
+   nir_def *cull_slot = slot;
+   if (views > 1) {
+      *loop = begin_view_loop(b, state);
+      state->vtx = native_addr_at(b, state->vtx, state->view, vtx_view_bytes);
+      state->idx = native_addr_at(b, state->idx, state->view, idx_view_bytes);
+      if (state->prim.base)
+         state->prim = native_addr_at(b, state->prim, state->view,
+                                      prim_view_bytes);
+      cull_slot = nir_iadd(b, slot, nir_imul(b, state->view, slots_per_batch));
+   }
+
+   if (layout->has_cull) {
+      state->cull = { load_native_const_64(b, TU_MESH_NATIVE_C3),
+                      nir_imul_imm(b, cull_slot, 32) };
+   }
+   nir_push_if(b, nir_ieq_imm(b, nir_load_local_invocation_index(b), 0));
+   native_stg(b, nir_imm_int(b, 0), state->cnt_vert, 0, 0x1, 4);
+   native_stg(b, nir_imm_int(b, 0), state->cnt_prim, 0, 0x1, 4);
+   if (layout->has_cull) {
+      nir_def *ones = nir_imm_ivec4(b, -1, -1, -1, -1);
+      native_stg(b, ones, state->cull, 0, 0xf, 16);
+      native_stg(b, ones, state->cull, 16, 0xf, 16);
+   }
+   nir_pop_if(b, NULL);
+   if (layout->has_cull) {
+      nir_barrier(b, .execution_scope = SCOPE_WORKGROUP,
+                  .memory_scope = SCOPE_WORKGROUP,
+                  .memory_semantics = NIR_MEMORY_ACQ_REL,
+                  .memory_modes = nir_var_mem_global);
+   }
+}
+
+void
+tu_nir_lower_mesh(nir_shader *nir, struct tu_mesh_layout *layout,
+                  uint32_t task_payload_size)
+{
+   assert(nir->info.stage == MESA_SHADER_MESH);
+
+   const bool has_task = task_payload_size != 0;
+
+   if (has_task) {
+      lower_task_payload_io(nir);
+   } else {
+      bool has_payload = false;
+      nir_foreach_variable_with_modes (var, nir, nir_var_mem_task_payload) {
+         var->data.mode = nir_var_mem_shared;
+         has_payload = true;
+      }
+      if (has_payload)
+         NIR_PASS(_, nir, nir_fixup_deref_modes);
+   }
+
+   NIR_PASS(_, nir, nir_lower_io, nir_var_shader_out, type_size_vec4,
+            nir_lower_io_lower_64bit_to_32);
+   if (layout->native)
+      NIR_PASS(_, nir, nir_opt_constant_folding);
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_cf_list body;
+   nir_cf_extract(&body, nir_before_impl(impl), nir_after_impl(impl));
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+
+   struct lower_mesh_state state = { .layout = layout };
+
+   if (layout->native) {
+      nir_loop *view_loop = NULL;
+      setup_native(&b, layout, &state, &view_loop);
+      nir_cf_reinsert(&body, b.cursor);
+      if (view_loop)
+         end_view_loop(&b, view_loop);
+      finish_lowering(nir, &state);
+      return;
+   }
+
+   nir_def *hw_wg = nir_load_workgroup_id(&b);
+   nir_def *hw_num = nir_load_num_workgroups(&b);
+   nir_def *slot = linear_wg_id(&b, hw_wg, hw_num);
+   nir_def *draw_index = ubo32(&b, TU_MESH_UBO_DRAW_INDEX);
+   nir_def *count_limit = ubo32(&b, TU_MESH_UBO_COUNT_LIMIT);
+   nir_def *capacity = ubo32(&b, TU_MESH_UBO_CAPACITY);
+
+   state.slot_base = elem_addr(&b, ubo64(&b, TU_MESH_UBO_SCRATCH), slot,
+                               layout->slot_stride);
+
+   nir_def *summary = NULL;
+   nir_def *in_range;
+   if (has_task) {
+      summary = nir_load_global(&b, 2, 32, ubo64(&b, TU_MESH_UBO_TASK_SUMMARY),
+                                .align_mul = 16);
+      in_range = nir_ult(&b, slot, nir_channel(&b, summary, 1));
+   } else {
+      in_range = nir_ult(&b, slot, capacity);
+   }
+
+   nir_push_if(&b, nir_iand(&b, nir_ult(&b, draw_index, count_limit), in_range));
+   {
+      if (has_task) {
+         nir_def *num_tasks = nir_channel(&b, summary, 0);
+         nir_def *base_va = ubo64(&b, TU_MESH_UBO_TASK_BASE);
+         nir_variable *lo_var =
+            nir_local_variable_create(impl, glsl_uint_type(), "lo");
+         nir_variable *hi_var =
+            nir_local_variable_create(impl, glsl_uint_type(), "hi");
+         nir_store_var(&b, lo_var, nir_imm_int(&b, 0), 1);
+         nir_store_var(&b, hi_var, num_tasks, 1);
+
+         nir_loop *loop = nir_push_loop(&b);
+         {
+            nir_def *lo = nir_load_var(&b, lo_var);
+            nir_def *hi = nir_load_var(&b, hi_var);
+            nir_break_if(&b, nir_ult(&b, nir_isub(&b, hi, lo),
+                                     nir_imm_int(&b, 2)));
+            nir_def *mid = nir_ushr_imm(&b, nir_iadd(&b, lo, hi), 1);
+            nir_def *mid_base =
+               nir_load_global(&b, 1, 32, elem_addr(&b, base_va, mid, 4),
+                               .align_mul = 4);
+            nir_def *le = nir_uge(&b, slot, mid_base);
+            nir_store_var(&b, lo_var, nir_bcsel(&b, le, mid, lo), 1);
+            nir_store_var(&b, hi_var, nir_bcsel(&b, le, hi, mid), 1);
+         }
+         nir_pop_loop(&b, loop);
+
+         nir_def *task = nir_load_var(&b, lo_var);
+         nir_def *task_base =
+            nir_load_global(&b, 1, 32, elem_addr(&b, base_va, task, 4),
+                            .align_mul = 4);
+         nir_def *rec =
+            nir_load_global(&b, 4, 32,
+                            elem_addr(&b, ubo64(&b, TU_MESH_UBO_TASK_RECORDS),
+                                      task, 16),
+                            .align_mul = 16);
+         nir_def *mx = nir_channel(&b, rec, 0);
+         nir_def *my = nir_channel(&b, rec, 1);
+         nir_def *mz = nir_channel(&b, rec, 2);
+         nir_def *local = nir_isub(&b, slot, task_base);
+
+         state.hw_wg = hw_wg;
+         state.hw_num = hw_num;
+         state.app_num = nir_vec3(&b, mx, my, mz);
+         state.app_wg = nir_vec3(&b, nir_umod(&b, local, mx),
+                                 nir_umod(&b, nir_udiv(&b, local, mx), my),
+                                 nir_udiv(&b, local, nir_imul(&b, mx, my)));
+         state.payload_base =
+            elem_addr(&b, ubo64(&b, TU_MESH_UBO_TASK_PAYLOADS), task,
+                      task_payload_size);
+      } else {
+         nir_def *args = ubo64(&b, TU_MESH_UBO_ARGS);
+         nir_def *first = nir_iand(&b, nir_ieq_imm(&b, slot, 0),
+                                   nir_ieq_imm(&b, nir_load_local_invocation_index(&b), 0));
+         nir_push_if(&b, nir_iand(&b, first, nir_ine_imm(&b, args, 0)));
+         {
+            nir_def *groups =
+               nir_imul(&b, nir_channel(&b, hw_num, 0),
+                        nir_imul(&b, nir_channel(&b, hw_num, 1),
+                                 nir_channel(&b, hw_num, 2)));
+            nir_def *verts =
+               nir_imul_imm(&b, nir_umin(&b, groups, capacity),
+                            layout->max_primitives * layout->verts_per_prim);
+            nir_store_global(&b, nir_vec4(&b, verts, nir_imm_int(&b, 1),
+                                          nir_imm_int(&b, 0), nir_imm_int(&b, 0)),
+                             args, .write_mask = 0xf, .align_mul = 16);
+         }
+         nir_pop_if(&b, NULL);
+      }
+
+      nir_push_if(&b, nir_ieq_imm(&b, nir_load_local_invocation_index(&b), 0));
+      nir_store_global(&b, nir_imm_ivec2(&b, 0, 0), state.slot_base,
+                       .write_mask = 0x3, .align_mul = 16);
+      nir_pop_if(&b, NULL);
+      nir_cf_reinsert(&body, b.cursor);
+   }
+   nir_pop_if(&b, NULL);
+
+   finish_lowering(nir, &state);
+}
+
+void
+tu_nir_lower_task(nir_shader *nir, uint32_t *payload_size)
+{
+   assert(nir->info.stage == MESA_SHADER_TASK);
+
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+   lower_task_payload_io(nir);
+   nir_lower_task_shader_options task_options = {};
+   NIR_PASS(_, nir, nir_lower_task_shader, task_options);
+
+   *payload_size = MAX2(align(nir->info.task_payload_size, 16), 16);
+}
+
+bool
+tu_nir_task_native_supported(const nir_shader *nir, uint32_t payload_size)
+{
+   return nir->info.derivative_group != DERIVATIVE_GROUP_QUADS &&
+          payload_size <= 16384;
+}
+
+static void
+setup_native_task(nir_builder *b, uint32_t payload_size,
+                  struct lower_mesh_state *state)
+{
+   state->native = true;
+   state->hw_wg = nir_load_workgroup_id(b);
+   nir_def *slot = nir_channel(b, state->hw_wg, 0);
+
+   nir_def *nxy = load_native_const(b, 2, TU_MESH_NATIVE_C1_ZW);
+   set_native_app_wg(b, state, load_native_const(b, 2, TU_MESH_NATIVE_C0), slot,
+                     nir_channel(b, nxy, 0), nir_channel(b, nxy, 1),
+                     load_native_const(b, 1, TU_MESH_NATIVE_C2));
+
+   state->payload_base = elem_addr(
+      b, load_native_const_64(b, TU_MESH_NATIVE_C1), slot, payload_size);
+   state->record = elem_addr(
+      b, load_native_const_64(b, TU_MESH_NATIVE_C0_ZW), slot, 24);
+}
+
+void
+tu_nir_lower_task_body(nir_shader *nir, uint32_t payload_size, bool native)
+{
+   assert(nir->info.stage == MESA_SHADER_TASK);
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_cf_list body;
+   nir_cf_extract(&body, nir_before_impl(impl), nir_after_impl(impl));
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+
+   struct lower_mesh_state state = {};
+
+   if (native) {
+      setup_native_task(&b, payload_size, &state);
+      nir_cf_reinsert(&body, b.cursor);
+      finish_lowering(nir, &state);
+      return;
+   }
+
+   nir_def *task = linear_wg_id(&b, nir_load_workgroup_id(&b),
+                                nir_load_num_workgroups(&b));
+
+   state.record = elem_addr(&b, ubo64(&b, TU_MESH_UBO_TASK_RECORDS), task, 16);
+   state.payload_base =
+      elem_addr(&b, ubo64(&b, TU_MESH_UBO_TASK_PAYLOADS), task, payload_size);
+
+   nir_push_if(&b, nir_iand(&b, nir_ult(&b, task,
+                                        ubo32(&b, TU_MESH_UBO_TASK_CAPACITY)),
+                            nir_ult(&b, ubo32(&b, TU_MESH_UBO_DRAW_INDEX),
+                                    ubo32(&b, TU_MESH_UBO_COUNT_LIMIT))));
+   {
+      nir_push_if(&b, nir_ieq_imm(&b, nir_load_local_invocation_index(&b), 0));
+      nir_store_global(&b, nir_imm_ivec4(&b, 0, 0, 0, 0), state.record,
+                       .write_mask = 0xf, .align_mul = 16);
+      nir_pop_if(&b, NULL);
+      nir_cf_reinsert(&body, b.cursor);
+   }
+   nir_pop_if(&b, NULL);
+
+   finish_lowering(nir, &state);
+}
+
+nir_shader *
+tu_nir_build_mesh_vs(struct tu_device *dev, const struct tu_mesh_layout *layout)
+{
+   nir_builder b =
+      nir_builder_init_simple_shader(MESA_SHADER_VERTEX,
+                                     ir3_get_compiler_options(dev->compiler),
+                                     "mesh_pull_vs");
+   nir_shader *nir = b.shader;
+   nir->info.clip_distance_array_size = layout->clip_distance_array_size;
+   nir->info.cull_distance_array_size = layout->cull_distance_array_size;
+
+   nir_variable *outs[ARRAY_SIZE(layout->vtx_slots)];
+   nir_variable *prim_outs[ARRAY_SIZE(layout->prim_slots)];
+   nir_variable *pos = NULL;
+   for (unsigned i = 0; i < layout->num_vtx_slots; i++) {
+      outs[i] = nir_create_variable_with_location(
+         nir, nir_var_shader_out, layout->vtx_slots[i], glsl_vec4_type());
+      if (layout->vtx_slots[i] == VARYING_SLOT_POS)
+         pos = outs[i];
+   }
+   if (!pos) {
+      pos = nir_create_variable_with_location(
+         nir, nir_var_shader_out, VARYING_SLOT_POS, glsl_vec4_type());
+   }
+   for (unsigned i = 0; i < layout->num_prim_slots; i++) {
+      unsigned slot = layout->prim_slots[i];
+      bool is_int = slot == VARYING_SLOT_LAYER ||
+                    slot == VARYING_SLOT_VIEWPORT ||
+                    slot == VARYING_SLOT_PRIMITIVE_ID;
+      prim_outs[i] = nir_create_variable_with_location(
+         nir, nir_var_shader_out, prim_vs_location(slot),
+         is_int ? glsl_int_type() : glsl_vec4_type());
+   }
+
+   nir_def *vertex = nir_load_vertex_id(&b);
+   nir_def *prim = nir_udiv_imm(&b, vertex, layout->verts_per_prim);
+   nir_def *k = nir_umod_imm(&b, vertex, layout->verts_per_prim);
+   nir_def *slot = nir_udiv_imm(&b, prim, layout->max_primitives);
+   nir_def *local_prim = nir_umod_imm(&b, prim, layout->max_primitives);
+
+   nir_def *base =
+      nir_iadd(&b, nir_load_scratch_base_ptr(&b, 1, 64, TU_MESH_UBO_SCRATCH),
+               nir_imul_imm(&b, nir_u2u64(&b, slot), layout->slot_stride));
+
+   nir_def *prim_count =
+      nir_load_global(&b, 1, 32,
+                      nir_iadd_imm(&b, base, 4),
+                      .align_mul = 4);
+
+   nir_store_var(&b, pos, nir_imm_vec4(&b, 2.0f, 2.0f, 2.0f, 1.0f), 0xf);
+
+   nir_push_if(&b, nir_ult(&b, local_prim, prim_count));
+   {
+      if (layout->has_cull) {
+         nir_def *cull =
+            nir_load_global(&b, 1, 32,
+                            nir_iadd(&b, base,
+                                     nir_u2u64(&b, nir_iadd_imm(
+                                        &b, nir_imul_imm(&b, local_prim, 4),
+                                        layout->cull_offset))),
+                            .align_mul = 4);
+         nir_push_if(&b, nir_ieq_imm(&b, cull, 0));
+      }
+      nir_def *index_offset =
+         nir_iadd_imm(&b, nir_imul_imm(&b,
+                                       nir_iadd(&b, nir_imul_imm(&b, local_prim,
+                                                                 layout->verts_per_prim),
+                                                k), 4),
+                      layout->indices_offset);
+      nir_def *index =
+         nir_load_global(&b, 1, 32,
+                         nir_iadd(&b, base, nir_u2u64(&b, index_offset)),
+                         .align_mul = 4);
+
+      nir_def *vertex_base =
+         nir_iadd(&b, base,
+                  nir_u2u64(&b, nir_iadd_imm(&b, nir_imul_imm(&b, index,
+                                                              layout->num_vtx_slots * 16),
+                                             layout->vertices_offset)));
+      for (unsigned i = 0; i < layout->num_vtx_slots; i++) {
+         nir_def *val =
+            nir_load_global(&b, 4, 32, nir_iadd_imm(&b, vertex_base, i * 16),
+                            .align_mul = 16);
+         nir_store_var(&b, outs[i], val, 0xf);
+      }
+
+      nir_def *prim_base =
+         nir_iadd(&b, base,
+                  nir_u2u64(&b, nir_iadd_imm(
+                     &b, nir_imul_imm(&b, local_prim,
+                                      layout->num_prim_slots * 16),
+                     layout->prims_offset)));
+      for (unsigned i = 0; i < layout->num_prim_slots; i++) {
+         nir_def *val =
+            nir_load_global(&b, 4, 32, nir_iadd_imm(&b, prim_base, i * 16),
+                            .align_mul = 16);
+         if (glsl_type_is_vector(prim_outs[i]->type))
+            nir_store_var(&b, prim_outs[i], val, 0xf);
+         else
+            nir_store_var(&b, prim_outs[i], nir_channel(&b, val, 0), 0x1);
+      }
+
+      if (layout->has_cull)
+         nir_pop_if(&b, NULL);
+   }
+   nir_pop_if(&b, NULL);
+
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+   return nir;
+}
+
+nir_shader *
+tu_nir_build_mesh_native_vs(struct tu_device *dev,
+                            const struct tu_mesh_layout *layout)
+{
+   nir_builder b =
+      nir_builder_init_simple_shader(MESA_SHADER_VERTEX,
+                                     ir3_get_compiler_options(dev->compiler),
+                                     "mesh_native_vs");
+   b.shader->info.clip_distance_array_size = layout->clip_distance_array_size;
+   b.shader->info.cull_distance_array_size = layout->cull_distance_array_size;
+
+   for (unsigned i = 0; i < layout->num_vtx_slots; i++) {
+      nir_variable *in = nir_create_variable_with_location(
+         b.shader, nir_var_shader_in, VERT_ATTRIB_GENERIC0 + i,
+         glsl_vec4_type());
+      nir_variable *out = nir_create_variable_with_location(
+         b.shader, nir_var_shader_out, layout->vtx_slots[i], glsl_vec4_type());
+      nir_store_var(&b, out, nir_load_var(&b, in), 0xf);
+   }
+
+   if (layout->has_psiz) {
+      nir_variable *in = nir_create_variable_with_location(
+         b.shader, nir_var_shader_in,
+         VERT_ATTRIB_GENERIC0 + layout->num_vtx_slots, glsl_uint_type());
+      nir_variable *out = nir_create_variable_with_location(
+         b.shader, nir_var_shader_out, VARYING_SLOT_PSIZ, glsl_float_type());
+      nir_store_var(&b, out, nir_load_var(&b, in), 0x1);
+   }
+
+   nir_shader_gather_info(b.shader, nir_shader_get_entrypoint(b.shader));
+   return b.shader;
+}
+
+nir_shader *
+tu_nir_build_mesh_prefix(struct tu_device *dev)
+{
+   nir_builder b =
+      nir_builder_init_simple_shader(MESA_SHADER_COMPUTE,
+                                     ir3_get_compiler_options(dev->compiler),
+                                     "mesh_prefix");
+   nir_shader *nir = b.shader;
+   nir->info.workgroup_size[0] = dev->compiler->info->threadsize_base;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   nir_def *records = ubo64(&b, TU_MESH_UBO_TASK_RECORDS);
+   nir_def *base_va = ubo64(&b, TU_MESH_UBO_TASK_BASE);
+   nir_def *capacity = ubo32(&b, TU_MESH_UBO_CAPACITY);
+   nir_def *lane = nir_load_subgroup_invocation(&b);
+   nir_def *step = nir_load_subgroup_size(&b);
+
+   nir_def *xyz = nir_load_global(&b, 3, 32, ubo64(&b, TU_MESH_UBO_TASK_XYZ),
+                                  .align_mul = 4);
+   nir_def *num_tasks =
+      nir_umin(&b, ubo32(&b, TU_MESH_UBO_TASK_CAPACITY),
+               nir_imul(&b, nir_channel(&b, xyz, 0),
+                        nir_imul(&b, nir_channel(&b, xyz, 1),
+                                 nir_channel(&b, xyz, 2))));
+
+   nir_variable *chunk_var =
+      nir_local_variable_create(impl, glsl_uint_type(), "chunk");
+   nir_variable *total_var =
+      nir_local_variable_create(impl, glsl_uint_type(), "total");
+   nir_variable *groups_var =
+      nir_local_variable_create(impl, glsl_uint_type(), "groups");
+   nir_store_var(&b, chunk_var, nir_imm_int(&b, 0), 1);
+   nir_store_var(&b, total_var, nir_imm_int(&b, 0), 1);
+
+   nir_loop *loop = nir_push_loop(&b);
+   {
+      nir_def *chunk = nir_load_var(&b, chunk_var);
+      nir_break_if(&b, nir_uge(&b, chunk, num_tasks));
+
+      nir_def *task = nir_iadd(&b, chunk, lane);
+      nir_def *valid = nir_ult(&b, task, num_tasks);
+      nir_store_var(&b, groups_var, nir_imm_int(&b, 0), 1);
+      nir_push_if(&b, valid);
+      {
+         nir_def *rec = nir_load_global(&b, 4, 32,
+                                        elem_addr(&b, records, task, 16),
+                                        .align_mul = 16);
+         nir_store_var(&b, groups_var,
+                       nir_imul(&b, nir_channel(&b, rec, 0),
+                                nir_imul(&b, nir_channel(&b, rec, 1),
+                                         nir_channel(&b, rec, 2))), 1);
+      }
+      nir_pop_if(&b, NULL);
+
+      nir_def *groups = nir_load_var(&b, groups_var);
+      nir_def *total = nir_load_var(&b, total_var);
+      nir_def *prefix = nir_exclusive_scan(&b, groups,
+                                           .reduction_op = nir_op_iadd);
+      nir_push_if(&b, valid);
+      nir_store_global(&b, nir_iadd(&b, total, prefix),
+                       elem_addr(&b, base_va, task, 4),
+                       .write_mask = 1, .align_mul = 4);
+      nir_pop_if(&b, NULL);
+
+      nir_def *sum = nir_reduce(&b, groups, .reduction_op = nir_op_iadd);
+      nir_store_var(&b, total_var, nir_umin(&b, nir_iadd(&b, total, sum),
+                                            capacity), 1);
+      nir_store_var(&b, chunk_var, nir_iadd(&b, chunk, step), 1);
+   }
+   nir_pop_loop(&b, loop);
+
+   nir_push_if(&b, nir_ieq_imm(&b, lane, 0));
+   {
+      nir_def *total = nir_load_var(&b, total_var);
+      nir_def *zero = nir_imm_int(&b, 0);
+      nir_store_global(&b, nir_vec4(&b, num_tasks, total, zero, zero),
+                       ubo64(&b, TU_MESH_UBO_TASK_SUMMARY),
+                       .write_mask = 0xf, .align_mul = 16);
+
+      nir_def *dim_x = nir_umin(&b, total, nir_imm_int(&b, 65535));
+      nir_def *dim_y = nir_udiv_imm(&b, nir_iadd_imm(&b, total, 65534), 65535);
+      nir_def *dim_z = nir_b2i32(&b, nir_ine_imm(&b, total, 0));
+      nir_store_global(&b, nir_vec4(&b, dim_x, dim_y, dim_z, zero),
+                       ubo64(&b, TU_MESH_UBO_TASK_MESH_DIMS),
+                       .write_mask = 0xf, .align_mul = 16);
+
+      nir_def *verts = nir_imul(&b, total,
+                                ubo32(&b, TU_MESH_UBO_TASK_VERTS_PER_GROUP));
+      nir_store_global(&b, nir_vec4(&b, verts, nir_imm_int(&b, 1), zero, zero),
+                       ubo64(&b, TU_MESH_UBO_ARGS),
+                       .write_mask = 0xf, .align_mul = 16);
+   }
+   nir_pop_if(&b, NULL);
+
+   NIR_PASS(_, nir, nir_lower_vars_to_ssa);
+   nir_shader_gather_info(nir, impl);
+   return nir;
+}
diff --git a/src/freedreno/vulkan/tu_pipeline.cc b/src/freedreno/vulkan/tu_pipeline.cc
index 5f06dd5dadb..d3933059f36 100644
--- a/src/freedreno/vulkan/tu_pipeline.cc
+++ b/src/freedreno/vulkan/tu_pipeline.cc
@@ -782,7 +782,8 @@ tu6_emit_vpc(struct tu_cs *cs,
              const struct ir3_shader_variant *hs,
              const struct ir3_shader_variant *ds,
              const struct ir3_shader_variant *gs,
-             const struct ir3_shader_variant *fs)
+             const struct ir3_shader_variant *fs,
