From 099d22166c2e563151238e8557482def30a3ef1d Mon Sep 17 00:00:00 2001
From: airidosas252 <airidaslideikis@gmail.com>
Date: Mon, 23 Nov 2026 19:44:58 +0200
Subject: [PATCH 32/32] ir3: encode the coherent bit of global atomics

The NONCOHERENT field of atomic.g is not in the display string, so the
encoder never wrote it and every global atomic came out coherent, which
only the AQE needs. That made the BVH build atomics slow (Q2RTX ray
queries 59 -> 45 fps before the uniform atomics fix hid it). Force the
field, and drop the coherent bit of ldg, which was never encoded either
and isn't needed.
---
 src/freedreno/ir3/ir3.h        |  2 +-
 src/freedreno/ir3/ir3_a6xx.c   |  2 --
 src/freedreno/isa/ir3-cat6.xml | 10 ++--------
 3 files changed, 3 insertions(+), 11 deletions(-)

diff --git a/src/freedreno/ir3/ir3.h b/src/freedreno/ir3/ir3.h
index eb9aea62ea5..4e0d0310585 100644
--- a/src/freedreno/ir3/ir3.h
+++ b/src/freedreno/ir3/ir3.h
@@ -497,7 +497,7 @@ struct ir3_instruction {
          int iim_val;       /* for ldgb/stgb, # of components */
          unsigned d    : 3; /* for ldc, component offset */
          bool typed    : 1;
-         bool coherent : 1; /* ldg, atomic.g: visible to the CP and the AQE */
+         bool coherent : 1; /* atomic.g: visible to the CP and the AQE */
          unsigned base : 3;
          ir3_shfl_mode shfl_mode : 3;
          unsigned stack_base : 8; /* ray_stack: first reg of the state block */
diff --git a/src/freedreno/ir3/ir3_a6xx.c b/src/freedreno/ir3/ir3_a6xx.c
index f5ee4bf835a..f33ff0e8012 100644
--- a/src/freedreno/ir3/ir3_a6xx.c
+++ b/src/freedreno/ir3/ir3_a6xx.c
@@ -454,8 +454,6 @@ emit_intrinsic_load_global(struct ir3_context *ctx, nir_intrinsic_instr *intr,
    }
 
    load->cat6.type = type_uint_size(intr->def.bit_size);
-   load->cat6.coherent = ctx->compiler->gen >= 8 &&
-                         (nir_intrinsic_access(intr) & ACCESS_COHERENT);
    load->dsts[0]->wrmask = MASK(dest_components);
 
    load->barrier_class = IR3_BARRIER_BUFFER_R;
diff --git a/src/freedreno/isa/ir3-cat6.xml b/src/freedreno/isa/ir3-cat6.xml
index 03a28542773..85fbf38fcf1 100644
--- a/src/freedreno/isa/ir3-cat6.xml
+++ b/src/freedreno/isa/ir3-cat6.xml
@@ -98,19 +98,13 @@ TODO rename UAV src to "UAV" so disasm_field_cb can find it easily?
 	</field>
 	<pattern pos="23"          >1</pattern>
 	<field   low="24" high="26" name="SIZE" type="uint"/>
-	<pattern pos="31"          >0</pattern>
-	<field   pos="30"          name="COHERENT" type="bool"/>
-	<pattern low="27" high="29">xxx</pattern>
+	<pattern low="27" high="31">00xxx</pattern>
 	<field   low="32" high="39" name="DST" type="#reg-gpr"/>
 	<pattern pos="40">x</pattern>
 	<pattern low="52" high="53">00</pattern>
 	<pattern low="54" high="58">00000</pattern>  <!-- OPC -->
 
 	<derived name="SRC1_CONST" expr="#false" type="bool"/>
-
-	<encode>
-		<map name="COHERENT">src->cat6.coherent</map>
-	</encode>
 </bitset>
 
 <bitset name="ldg" extends="#instruction-cat6-ldg">
@@ -1148,7 +1142,7 @@ TODO rename UAV src to "UAV" so disasm_field_cb can find it easily?
 	<!-- Clear for the atomics that the CP has to see (the AQE of the stock driver). -->
 	<field   pos="0"            name="NONCOHERENT" type="bool"/>
 	<encode>
-		<map name="NONCOHERENT">!src->cat6.coherent</map>
+		<map name="NONCOHERENT" force="true">!src->cat6.coherent</map>
 	</encode>
 	<pattern low="1"  high="8"  >00000000</pattern> <!-- SRC3 -->
 	<pattern low="41" high="48" >00000000</pattern> <!-- SSBO/image binding point -->
-- 
