+/* The most wave slots that an SP hands out to a compute shader with this
+ * register footprint (in vec4 registers), measured on X2-90 under full load.
+ */
+static unsigned
+tu_rt_wave_slots(unsigned regs)
+{
+   static const struct { uint8_t regs, slots; } measured[] = {
+      { 8, 64 }, { 16, 48 }, { 20, 44 }, { 24, 42 }, { 28, 40 }, { 36, 38 }, { 44, 36 },
+   };
+   unsigned slots = 64;
+   for (unsigned i = 0; i < ARRAY_SIZE(measured) && regs >= measured[i].regs; i++)
+      slots = measured[i].slots;
+   return slots;
+}
+
+/* Get the BO of the stack and size the share of GMEM of each wave slot for the
+ * bottom of the stack, see rt_sep_gmem_stack().
+ */
+static VkResult
+tu_rt_gmem_stack(struct tu_cmd_buffer *cmd, const struct ir3_shader_variant *v,
+                 uint32_t stack, uint32_t *ubo)
+{
+   const struct tu_physical_device *phys = cmd->device->physical_device;
+
+   /* The BO has a share for each of the 64 wave slots of an SP, fibers_per_sp
+    * is 64 waves of 64 lanes. The stack is no bigger than what fits in private
+    * memory, which keeps the offsets in the BO within 32 bits.
+    */
+   struct tu_bo *bo;
+   VkResult result = tu_get_rt_bo(
+      cmd->device, &cmd->device->rt_stack_bo,
+      util_next_power_of_two64((uint64_t)phys->info->num_sp_cores * 64 * 64 * stack),
+      VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, "rt_stack", &bo);
+   if (result != VK_SUCCESS)
+      return result;
+   if (bo != cmd->state.rt_stack_bo) {
+      util_dynarray_append(&cmd->rt_pvtmem_bos, bo);
+      cmd->state.rt_stack_bo = bo;
+   } else {
+      tu_bo_finish(cmd->device, bo);
+   }
+   tu_mesh_ubo_set_va(ubo, TU_RT_UBO_STACK_ADDR, bo->iova);
+
+   /* A wave of 128 lanes takes the registers of two. Two more slots in case
+    * the measurements missed some.
+    */
+   const unsigned regs = (v->info.max_reg + 1 + (v->info.max_half_reg + 2) / 2) *
+                         (v->info.double_threadsize ? 2 : 1);
+   const uint32_t waves = tu_rt_wave_slots(regs) + 2;
+
+   /* Below the CCU and VPC caches, whichever mode the CCU is in. */
+   const uint32_t gmem = MIN2(phys->usable_gmem_size_gmem,
+                              phys->config_sysmem.depth_ccu_offset);
+   uint32_t size = (gmem / (phys->info->num_sp_cores * waves * 64)) & ~15u;
+
+   /* Where shaders see GMEM. MSM_PARAM_GMEM_BASE is 0 since A650, the msm
+    * kernel puts it at 64 MiB on A8XX.
+    */
+   const uint64_t gmem_va = phys->gmem_base ? phys->gmem_base : 64 * 1024 * 1024;
+   if (gmem_va + gmem > UINT32_MAX)
+      size = 0;
+
+   ubo[TU_RT_UBO_GMEM_STACK_ADDR] = gmem_va;
+   ubo[TU_RT_UBO_GMEM_STACK_SIZE] = MIN2(size, stack);
+   ubo[TU_RT_UBO_GMEM_STACK_WAVES] = waves;
+
+   if (cmd->device->rt_log) {
+      mesa_logi_once("rt_pipeline: gmem stack %u of %u bytes, %u regs, %u wave slots, "
+                     "%u bytes of GMEM", MIN2(size, stack), stack, regs, waves, gmem);
+   }
+   return VK_SUCCESS;
+}
+
 /* Launch the rays with the direct dimensions, or from the command at
  * indirect_va. The shader binding tables are at `sbt`, if they are not in the
  * indirect command.
@@ -11439,7 +11515,18 @@ tu_trace_rays(struct tu_cmd_buffer *cmd,
       ubo.map[TU_RT_UBO_STACK_BASE] = v->pvtmem_size;
       ubo.map[TU_RT_UBO_STACK_LIMIT] = v->pvtmem_size + size;
 
-      result = tu_get_pvtmem(cmd->device, &pvtmem, &bo, v->pvtmem_size + size,
+      /* The GMEM stack keeps the stack out of private memory. */
+      uint32_t pvtmem_size = v->pvtmem_size + size;
+      if (cmd->device->rt_gmem_stack) {
+         result = tu_rt_gmem_stack(cmd, v, size, ubo.map);
+         if (result != VK_SUCCESS) {
+            vk_command_buffer_set_error(&cmd->vk, result);
+            return;
+         }
+         pvtmem_size = v->pvtmem_size;
+      }
+
+      result = tu_get_pvtmem(cmd->device, &pvtmem, &bo, pvtmem_size,
                              v->pvtmem_per_wave);
       if (result != VK_SUCCESS) {
          vk_command_buffer_set_error(&cmd->vk, result);
@@ -11472,6 +11559,16 @@ tu_trace_rays(struct tu_cmd_buffer *cmd,
    tu_cs_emit_state_ib(&cmd->cs, shader->state);
    tu_dispatch<CHIP>(cmd, &info);
 
+   /* The dispatch isn't marked as using GMEM: with the msm kernel on A8XX,
