diff --git a/src/freedreno/ir3/ir3_lower_subgroups.c b/src/freedreno/ir3/ir3_lower_subgroups.c
index c3542897556..29bc84d740f 100644
--- a/src/freedreno/ir3/ir3_lower_subgroups.c
+++ b/src/freedreno/ir3/ir3_lower_subgroups.c
@@ -876,3 +876,273 @@ ir3_nir_lower_shuffle(nir_shader *nir, struct ir3_shader *shader)
    return nir_shader_lower_instructions(nir, filter_shuffle, lower_shuffle,
                                         NULL);
 }
+
+static nir_def *
+virt_lane(nir_builder *b)
+{
+   return nir_iand_imm(b, nir_load_subgroup_invocation(b), 31);
+}
+
+static nir_def *
+virt_upper_half(nir_builder *b)
+{
+   return nir_test_mask(b, nir_load_subgroup_invocation(b), 32);
+}
+
+static nir_def *
+virt_ballot(nir_builder *b, nir_def *cond)
+{
+   nir_def *words = nir_ballot(b, 2, 32, cond);
+   return nir_bcsel(b, virt_upper_half(b), nir_channel(b, words, 1),
+                    nir_channel(b, words, 0));
+}
+
+static nir_def *
+virt_read_first(nir_builder *b, nir_intrinsic_instr *intrin)
+{
+   return nir_read_first_invocation(b, intrin->src[0].ssa);
+}
+
+static nir_def *
+virt_read_invocation(nir_builder *b, nir_intrinsic_instr *intrin)
+{
+   nir_def *cond = nir_ieq(b, intrin->src[1].ssa, virt_lane(b));
+   nir_def *chan[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned i = 0; i < intrin->def.num_components; i++) {
+      chan[i] = nir_read_invocation_cond_ir3(
+         b, intrin->def.bit_size, nir_channel(b, intrin->src[0].ssa, i), cond);
+   }
+   return nir_vec(b, chan, intrin->def.num_components);
+}
+
+static nir_def *
+virt_read_cond(nir_builder *b, nir_intrinsic_instr *intrin)
+{
+   return nir_read_invocation_cond_ir3(b, intrin->def.bit_size,
+                                       intrin->src[0].ssa, intrin->src[1].ssa);
+}
+
+static nir_def *
+virt_per_half(nir_builder *b, nir_intrinsic_instr *intrin,
+              nir_def *(*op)(nir_builder *, nir_intrinsic_instr *))
+{
+   nir_if *nif = nir_push_if(b, virt_upper_half(b));
+   nir_def *upper = op(b, intrin);
+   nir_push_else(b, nif);
+   nir_def *lower = op(b, intrin);
+   nir_pop_if(b, nif);
+   return nir_if_phi(b, upper, lower);
+}
+
+static nir_def *
+virt_scan_reduce_fast(nir_builder *b, nir_intrinsic_op kind, nir_op op,
+                      nir_def *data, unsigned cluster_size)
+{
+   if (kind == nir_intrinsic_reduce) {
+      for (unsigned i = 1; i < cluster_size; i *= 2) {
+         data = nir_build_alu2(b, op, data,
+                               nir_shuffle_xor(b, data, nir_imm_int(b, i)));
+      }
+      return data;
+   }
+
+   nir_def *lane = virt_lane(b);
+   for (unsigned i = 1; i < 32; i *= 2) {
+      nir_def *buddy = nir_shuffle_up(b, data, nir_imm_int(b, i));
+      data = nir_bcsel(b, nir_uge_imm(b, lane, i),
+                       nir_build_alu2(b, op, data, buddy), data);
+   }
+
+   if (kind == nir_intrinsic_exclusive_scan) {
+      nir_const_value ident = nir_alu_binop_identity(op, data->bit_size);
+      nir_def *buddy = nir_shuffle_up(b, data, nir_imm_int(b, 1));
+      data = nir_bcsel(b, nir_uge_imm(b, lane, 1), buddy,
+                       nir_build_imm(b, 1, data->bit_size, &ident));
+   }
+
+   return data;
+}
+
+static nir_def *
+virt_scan_reduce(nir_builder *b, nir_intrinsic_op kind, nir_op op,
+                 nir_def *data, unsigned cluster_size)
+{
+   nir_def *fast = NULL;
+   nir_def *slow;
+
+   nir_if *nif = NULL;
+   if (data->bit_size < 64) {
+      nir_def *full =
+         nir_ieq_imm(b, virt_ballot(b, nir_imm_true(b)), 0xffffffff);
+      nif = nir_push_if(b, full);
+      fast = virt_scan_reduce_fast(b, kind, op, data, cluster_size);
+      nir_push_else(b, nif);
+   }
+
+   switch (kind) {
+   case nir_intrinsic_reduce:
+      slow = nir_reduce(b, data, .reduction_op = op,
+                        .cluster_size = cluster_size);
+      break;
+   default: {
+      nir_const_value id = nir_alu_binop_identity(op, data->bit_size);
+      nir_def *ident = nir_build_imm(b, 1, data->bit_size, &id);
+      nir_def *upper = virt_upper_half(b);
+      nir_def *lo_in = nir_bcsel(b, upper, ident, data);
+      nir_def *up_in = nir_bcsel(b, upper, data, ident);
+      nir_def *lo, *up;
+      if (kind == nir_intrinsic_inclusive_scan) {
+         lo = nir_inclusive_scan(b, lo_in, .reduction_op = op);
+         up = nir_inclusive_scan(b, up_in, .reduction_op = op);
+      } else {
+         lo = nir_exclusive_scan(b, lo_in, .reduction_op = op);
+         up = nir_exclusive_scan(b, up_in, .reduction_op = op);
+      }
+      slow = nir_bcsel(b, upper, up, lo);
+      break;
+   }
+   }
+
+   if (!nif)
+      return slow;
+
+   nir_pop_if(b, nif);
+   return nir_if_phi(b, fast, slow);
+}
+
+static nir_def *
+virt_lower_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   nir_shader *nir = b->shader;
+   nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+   b->cursor = nir_before_instr(instr);
+
+   switch (intrin->intrinsic) {
+   case nir_intrinsic_load_subgroup_size:
+      return nir_imm_int(b, 32);
+
+   case nir_intrinsic_load_subgroup_invocation:
+      return virt_lane(b);
+
+   case nir_intrinsic_load_subgroup_id:
+      return nir_iadd(b, nir_ishl_imm(b, nir_load_subgroup_id(b), 1),
+                      nir_ushr_imm(b, nir_load_subgroup_invocation(b), 5));
+
+   case nir_intrinsic_load_num_subgroups: {
+      if (!nir->info.workgroup_size_variable) {
+         unsigned n = nir->info.workgroup_size[0] * nir->info.workgroup_size[1] *
+                      nir->info.workgroup_size[2];
+         return nir_imm_int(b, DIV_ROUND_UP(n, 32));
+      }
+      nir_def *size = nir_load_workgroup_size(b);
+      nir_def *n = nir_imul24(b, nir_channel(b, size, 0),
+                              nir_imul24(b, nir_channel(b, size, 1),
+                                         nir_channel(b, size, 2)));
+      return nir_ushr_imm(b, nir_iadd_imm(b, n, 31), 5);
+   }
+
+   case nir_intrinsic_ballot:
+      if (intrin->def.num_components != 1)
+         return NULL;
+      return virt_ballot(b, intrin->src[0].ssa);
+
+   case nir_intrinsic_read_first_invocation:
+      return virt_per_half(b, intrin, virt_read_first);
+
+   case nir_intrinsic_read_invocation:
+      return virt_per_half(b, intrin, virt_read_invocation);
+
+   case nir_intrinsic_read_invocation_cond_ir3:
+      return virt_per_half(b, intrin, virt_read_cond);
+
+   case nir_intrinsic_shuffle:
+      return nir_shuffle(b, intrin->src[0].ssa,
+                         nir_ior(b, nir_iand_imm(b, intrin->src[1].ssa, 31),
+                                 nir_iand_imm(b, nir_load_subgroup_invocation(b), 32)));
+
+   case nir_intrinsic_reduce:
+   case nir_intrinsic_inclusive_scan:
+   case nir_intrinsic_exclusive_scan: {
+      unsigned cluster_size = 32;
+      if (intrin->intrinsic == nir_intrinsic_reduce) {
+         unsigned cs = nir_intrinsic_cluster_size(intrin);
+         if (cs && cs < 32)
+            cluster_size = cs;
+      }
+      nir_op op = nir_intrinsic_reduction_op(intrin);
+      nir_def *src = intrin->src[0].ssa;
+      if (intrin->def.bit_size == 1) {
+         nir_def *res = virt_scan_reduce(b, intrin->intrinsic, op,
+                                         nir_b2i32(b, src), cluster_size);
+         return nir_ine_imm(b, res, 0);
+      }
+      return virt_scan_reduce(b, intrin->intrinsic, op, src, cluster_size);
+   }
+
+   default:
+      return NULL;
+   }
+}
+
+static bool
+virt_filter(const nir_instr *instr, const void *data)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+
+   switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+   case nir_intrinsic_load_subgroup_size:
+   case nir_intrinsic_load_subgroup_invocation:
+   case nir_intrinsic_load_subgroup_id:
+   case nir_intrinsic_load_num_subgroups:
+   case nir_intrinsic_ballot:
+   case nir_intrinsic_read_first_invocation:
+   case nir_intrinsic_read_invocation:
+   case nir_intrinsic_read_invocation_cond_ir3:
+   case nir_intrinsic_shuffle:
+   case nir_intrinsic_reduce:
+   case nir_intrinsic_inclusive_scan:
+   case nir_intrinsic_exclusive_scan:
+      return true;
+   default:
+      return false;
+   }
+}
+
+bool
+ir3_nir_lower_virtual_subgroup32(nir_shader *nir, struct ir3_shader *shader)
+{
+   nir_lower_subgroups_options options = {
+      .subgroup_size = 32,
+      .ballot_bit_size = 32,
+      .ballot_components = 1,
+      .lower_to_scalar = true,
+      .lower_vote = true,
+      .lower_vote_feq = true,
+      .lower_vote_ieq = true,
+      .lower_vote_bool_eq = true,
+      .lower_subgroup_masks = true,
+      .lower_first_invocation_to_ballot = true,
+      .lower_elect = true,
+      .lower_read_invocation_to_cond = true,
+      .lower_shuffle = !shader->compiler->has_shfl,
+      .lower_relative_shuffle = !shader->compiler->has_shfl,
+      .lower_rotate_to_shuffle = true,
+      .lower_inverse_ballot = true,
+      .lower_quad_vote = true,
+      .lower_reduce = true,
+      .filter = ir3_nir_lower_subgroups_filter,
+      .filter_data = shader->compiler,
+   };
+
+   nir_opt_uniform_subgroup(nir, &options);
+   nir_lower_subgroups(nir, &options);
+   nir_shader_lower_instructions(nir, virt_filter, virt_lower_instr, NULL);
+   nir_foreach_function_impl(impl, nir)
+      nir_progress(true, impl, nir_metadata_none);
+   nir->info.min_subgroup_size = nir->info.max_subgroup_size =
+      shader->compiler->info->threadsize_base;
+   nir->info.api_subgroup_size = 0;
+   nir_divergence_analysis(nir);
+   return true;
+}
diff --git a/src/freedreno/ir3/ir3_nir.c b/src/freedreno/ir3/ir3_nir.c
index 5f66575cfc8..74ef6ebfb4b 100644
--- a/src/freedreno/ir3/ir3_nir.c
+++ b/src/freedreno/ir3/ir3_nir.c
@@ -1094,6 +1094,9 @@ ir3_nir_post_finalize(struct ir3_shader *shader)
        * it here. Beyond this point nir_intrinsic_load_subgroup_size will return
        * the "real" subgroup size.
        */
+      if (shader->options.virtual_subgroup32_split)
+         OPT(s, ir3_nir_lower_virtual_subgroup32, shader);
+
       unsigned subgroup_size = 0, max_subgroup_size = 0;
       ir3_shader_get_subgroup_size(compiler, &shader->options, s->info.stage,
                                    &subgroup_size, &max_subgroup_size);
@@ -1110,7 +1113,9 @@ ir3_nir_post_finalize(struct ir3_shader *shader)
             .lower_read_invocation_to_cond = true,
             .lower_shuffle = !compiler->has_shfl,
             .lower_relative_shuffle = !compiler->has_shfl,
-            .lower_rotate_to_shuffle = !compiler->has_shfl,
+            .lower_rotate_to_shuffle = !compiler->has_shfl ||
+               (shader->options.virtual_subgroup32 &&
+                !shader->options.virtual_subgroup32_split),
             .lower_rotate_clustered_to_shuffle = true,
             .lower_inverse_ballot = true,
             .lower_quad_vote = true,
@@ -1125,7 +1130,8 @@ ir3_nir_post_finalize(struct ir3_shader *shader)
          options.lower_vote_trivial = true;
       }
 
-      OPT(s, nir_opt_uniform_subgroup, &options);
+      if (!shader->options.virtual_subgroup32_split)
+         OPT(s, nir_opt_uniform_subgroup, &options);
       OPT(s, nir_lower_subgroups, &options);
       OPT(s, ir3_nir_lower_shuffle, shader);
    }
diff --git a/src/freedreno/ir3/ir3_nir.h b/src/freedreno/ir3/ir3_nir.h
index 2bb0956a4ed..a7f73b33fd1 100644
--- a/src/freedreno/ir3/ir3_nir.h
+++ b/src/freedreno/ir3/ir3_nir.h
@@ -118,6 +118,7 @@ nir_def *ir3_nir_try_propagate_bit_shift(nir_builder *b,
 
 bool ir3_nir_lower_subgroups_filter(const nir_intrinsic_instr *intrin, const void *data);
 bool ir3_nir_lower_shuffle(nir_shader *nir, struct ir3_shader *shader);
+bool ir3_nir_lower_virtual_subgroup32(nir_shader *nir, struct ir3_shader *shader);
 bool ir3_nir_opt_subgroups(nir_shader *nir, struct ir3_shader_variant *v);
 
 nir_def *ir3_get_shared_driver_ubo(nir_builder *b,
diff --git a/src/freedreno/ir3/ir3_shader.c b/src/freedreno/ir3/ir3_shader.c
index f4be22d53e5..b6381a587b0 100644
--- a/src/freedreno/ir3/ir3_shader.c
+++ b/src/freedreno/ir3/ir3_shader.c
@@ -1011,6 +1011,15 @@ ir3_shader_from_nir(struct ir3_compiler *compiler, nir_shader *nir,
    shader->options = *options;
    shader->nir = nir;
 
+   shader->options.virtual_subgroup32 &=
+      mesa_shader_stage_is_compute(nir->info.stage);
+   if (shader->options.virtual_subgroup32) {
+      shader->options.virtual_subgroup32_split =
+         nir->info.workgroup_size_variable ||
+         nir->info.workgroup_size[0] * nir->info.workgroup_size[1] *
+            nir->info.workgroup_size[2] > 32;
+   }
+
    ir3_disk_cache_init_shader_key(compiler, shader);
 
    ir3_setup_used_key(shader);
@@ -1386,6 +1395,8 @@ ir3_shader_get_subgroup_size(const struct ir3_compiler *compiler,
    switch (options->api_wavesize) {
    case IR3_SINGLE_ONLY:
       *subgroup_size = *max_subgroup_size = compiler->info->threadsize_base;
+      if (options->virtual_subgroup32 && !options->virtual_subgroup32_split)
+         *subgroup_size = *max_subgroup_size = 32;
       break;
    case IR3_DOUBLE_ONLY:
       *subgroup_size = *max_subgroup_size = compiler->info->threadsize_base * 2;
diff --git a/src/freedreno/ir3/ir3_shader.h b/src/freedreno/ir3/ir3_shader.h
