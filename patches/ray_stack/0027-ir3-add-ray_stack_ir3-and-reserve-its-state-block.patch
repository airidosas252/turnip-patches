 src/compiler/nir/nir_intrinsics.py         |  7 +++
 src/freedreno/common/freedreno_dev_info.h  |  3 +
 src/freedreno/common/freedreno_devices.py  |  1 +
 src/freedreno/ir3/ir3.c                    |  8 +++
